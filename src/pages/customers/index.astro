---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Components
import CustomerCard from "@/components/customers/CustomerCard.astro";
// Content
import { getCollection } from "astro:content";
const allCustomers = await getCollection("customers");
---

<BaseLayout
  title="Customers · Twilda"
  description="Customer stories for Twilda are coming soon. Placeholder case studies from the site template may still appear here."
  canonicalPath="/customers/"
  noindex={true}
>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-12 lg:pt-64 bg-yellow">
      <div class="max-w-2xl text-balance mx-auto text-center">
        <Text
          tag="h1"
          variant="displayXL"
          class="font-semibold tracking-tight text-accent-900"
        >
          Writers building worlds with Twilda
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-accent-900">
          Real customer stories are coming soon. Until then, any case studies
          below may still be Lexington template placeholders — not live Twilda
          partners.
        </Text>
      </div>
    </Wrapper>
    <Wrapper variant="standard" class="border-t-8 border-accent-900 py-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-24"
      >
        {allCustomers.map((post) => <CustomerCard post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
