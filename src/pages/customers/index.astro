---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Components
import CustomerCard from "@/components/customers/CustomerCard.astro";
// Content
import { getCollection } from "astro:content";
const allCustomers = await getCollection("customers");
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-12 lg:pt-64 bg-yellow">
      <div class="max-w-2xl text-balance mx-auto text-center">
        <Text
          tag="h1"
          variant="displayXL"
          class="font-semibold tracking-tight text-accent-900"
        >
          Become a partner of th efuture of finance and banking with Munch.
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-accent-900">
          Access expert guides, financial insights, and security tips to manage
          your finances with confidence in the digital age.
        </Text>
      </div>
    </Wrapper>
    <Wrapper variant="standard" class="border-t-8 border-accent-900 py-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-24"
      >
        {allCustomers.map((post) => <CustomerCard post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
