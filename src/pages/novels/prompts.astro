---
export const prerender = false;

import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import NovelsTopbar from "@/components/novels/NovelsTopbar.astro";
import { prompts } from "@/apps/novelcrafter/prompts";
import { listNovels } from "@/lib/novels/service";

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;
const novels = await listNovels(supabase, user.id);
const defaultNovel = novels[0]?.id;

const { data: subscription } = await supabase
  .from("subscriptions")
  .select("ai_credits_remaining, ai_credits_monthly")
  .eq("user_id", user.id)
  .maybeSingle();
---

<NovelcrafterLayout title="Prompts · Twilda">
  <NovelsTopbar
    active="prompts"
    userEmail={user.email}
    credits={subscription?.ai_credits_remaining ?? 5}
    creditsMax={subscription?.ai_credits_monthly ?? 5}
  />

  <main class="nc-library">
    <div class="nc-library__head">
      <h1>Writing Prompts</h1>
      <p>Jump-start scenes, deepen characters, or stress-test your outline. Copy a prompt or open it in Chat.</p>
    </div>

    <div class="nc-prompt-grid">
      {
        prompts.map((prompt) => (
          <article class="nc-prompt-card" data-prompt={prompt.id}>
            <p class="nc-prompt-card__category">{prompt.category}</p>
            <h2 class="nc-prompt-card__title">{prompt.title}</h2>
            <p class="nc-prompt-card__text">{prompt.text}</p>
            <div class="nc-prompt-card__actions">
              <button class="nc-btn" type="button" data-copy-prompt={prompt.text}>
                Copy
              </button>
              {defaultNovel ? (
                <a
                  class="nc-btn nc-btn--primary"
                  href={`/novels/${defaultNovel}/?mode=chat&prompt=${prompt.id}`}
                >
                  Use in Chat
                </a>
              ) : (
                <a class="nc-btn nc-btn--primary" href="/novels/">Create a novel first</a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </main>

  <div class="nc-toast" data-toast hidden></div>

  <script>
    const toast = document.querySelector("[data-toast]");
    function showToast(message) {
      if (!toast) return;
      toast.textContent = message;
      toast.hidden = false;
      toast.classList.add("is-visible");
      window.setTimeout(() => {
        toast.classList.remove("is-visible");
        window.setTimeout(() => { toast.hidden = true; }, 300);
      }, 2200);
    }
    document.querySelectorAll("[data-copy-prompt]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copyPrompt ?? "");
          showToast("Prompt copied.");
        } catch {
          showToast("Could not copy.");
        }
      });
    });
  </script>
</NovelcrafterLayout>
