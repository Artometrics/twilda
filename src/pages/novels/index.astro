---
export const prerender = false;

import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import NovelsTopbar from "@/components/novels/NovelsTopbar.astro";
import Cover from "@/apps/novelcrafter/Cover.astro";
import {
  listNovels,
  ensureStarterNovels,
  formatUpdated,
} from "@/lib/novels/service";
import { requireAuth, dbErrorMessage, isDbSetupError } from "@/lib/auth/guards";
import { ensureUserProfile } from "@/lib/auth/profile";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const { user, supabase } = auth;

let novels: Awaited<ReturnType<typeof listNovels>> = [];
let dbError: string | null = null;

try {
  await ensureUserProfile(supabase, user);
  await ensureStarterNovels(supabase, user.id);
  novels = await listNovels(supabase, user.id);
} catch (error) {
  dbError = dbErrorMessage(error);
}

const { data: subscription } = await supabase
  .from("subscriptions")
  .select("ai_credits_remaining, ai_credits_monthly")
  .eq("user_id", user.id)
  .maybeSingle();

const recent = [...novels]
  .sort((a, b) => {
    const aT = new Date(a.last_opened_at ?? a.updated_at).getTime();
    const bT = new Date(b.last_opened_at ?? b.updated_at).getTime();
    return bT - aT;
  })
  .slice(0, 3);
---

<NovelcrafterLayout title="Your Novels · Twilda">
  <NovelsTopbar
    active="novels"
    userEmail={user.email}
    credits={subscription?.ai_credits_remaining ?? 5}
    creditsMax={subscription?.ai_credits_monthly ?? 5}
  />

  <main class="nc-library">
    {
      dbError && (
        <div class="nc-library__alert" role="alert">
          <p>
            {isDbSetupError(dbError)
              ? "Your library database is not set up yet. Apply supabase/migrations/001_initial_schema.sql and 003_novel_drafts.sql to your Supabase project, then refresh."
              : `Could not load your library: ${dbError}`}
          </p>
        </div>
      )
    }
    <div class="nc-library__head">
      <h1>Your Novels</h1>
      <p>This is your personal library of novels. Which one do you want to work on today?</p>
    </div>

    {
      recent.length > 0 && (
        <>
          <p class="nc-section-label">CONTINUE WHERE YOU LEFT OFF</p>
          <div class="nc-continue">
            {recent.map((n) => (
              <a class="nc-continue__card" href={`/novels/${n.id}/`}>
                <span class="nc-continue__thumb">
                  <Cover kind={n.cover_kind} title={n.title} author={n.author} />
                </span>
                <span class="nc-continue__meta">
                  <strong>{n.title}</strong>
                  <span>{n.author}</span>
                  <em>{formatUpdated(n.last_opened_at ?? n.updated_at)}</em>
                </span>
              </a>
            ))}
          </div>
        </>
      )
    }

    <div class="nc-toolbar">
      <button class="nc-btn nc-btn--primary" type="button" data-create-novel>
        + Create Novel
      </button>
      <button class="nc-btn" type="button" data-import-trigger>Import</button>
      <input type="file" accept=".txt,.md,.markdown" data-import-input hidden />
      <div class="nc-toolbar__spacer"></div>
      <div class="nc-field">
        <label for="library-search">SEARCH/FILTER:</label>
        <input
          id="library-search"
          class="nc-input"
          type="search"
          placeholder="Search name/series…"
          data-library-search
        />
      </div>
      <div class="nc-field">
        <label for="library-sort">SORT BY:</label>
        <select id="library-sort" class="nc-select" data-library-sort>
          <option value="date">Date</option>
          <option value="title">Title</option>
        </select>
      </div>
      <div class="nc-field">
        <label>VIEW AS:</label>
        <div class="nc-viewtoggle" data-library-view>
          <button class="is-active" type="button" data-view="grid">Grid</button>
          <button type="button" data-view="list">List</button>
        </div>
      </div>
    </div>

    <h2 class="nc-group-title" data-library-count>
      Your library <span>{novels.length} book{novels.length === 1 ? "" : "s"}</span>
    </h2>
    <div class="nc-grid" data-library-grid>
      {
        novels.map((n) => (
          <a
            class="nc-book"
            href={`/novels/${n.id}/`}
            data-book
            data-title={n.title.toLowerCase()}
            data-sort-key={new Date(n.last_opened_at ?? n.updated_at).getTime()}
            data-series={(n.series_name ?? "no series").toLowerCase()}
          >
            <div class="nc-book__cover">
              <Cover kind={n.cover_kind} title={n.title} author={n.author} />
            </div>
            <div class="nc-book__meta">
              <p class="nc-book__title">{n.title}</p>
              <p class="nc-book__date">{formatUpdated(n.updated_at)}</p>
              <p class="nc-book__author">{n.author}</p>
            </div>
          </a>
        ))
      }
    </div>
    <p class="nc-library__empty" data-library-empty hidden>
      No novels match your search.
    </p>
  </main>

  <div class="nc-toast" data-toast hidden></div>

  <script>
    const grid = document.querySelector("[data-library-grid]");
    const search = document.querySelector("[data-library-search]");
    const sort = document.querySelector("[data-library-sort]");
    const viewToggle = document.querySelector("[data-library-view]");
    const emptyState = document.querySelector("[data-library-empty]");
    const countLabel = document.querySelector("[data-library-count] span");
    const importTrigger = document.querySelector("[data-import-trigger]");
    const importInput = document.querySelector("[data-import-input]");
    const createBtn = document.querySelector("[data-create-novel]");
    const toast = document.querySelector("[data-toast]");

    function showToast(message) {
      if (!toast) return;
      toast.textContent = message;
      toast.hidden = false;
      toast.classList.add("is-visible");
      window.setTimeout(() => {
        toast.classList.remove("is-visible");
        window.setTimeout(() => {
          toast.hidden = true;
        }, 300);
      }, 2600);
    }

    function getBooks() {
      return Array.from(document.querySelectorAll("[data-book]"));
    }

    function applyFilters() {
      const q = (search?.value ?? "").trim().toLowerCase();
      const books = getBooks();
      let visible = 0;
      books.forEach((book) => {
        const title = book.dataset.title ?? "";
        const series = book.dataset.series ?? "";
        const match = !q || title.includes(q) || series.includes(q);
        book.style.display = match ? "" : "none";
        if (match) visible += 1;
      });
      if (emptyState) emptyState.hidden = visible > 0;
      if (countLabel) countLabel.textContent = `${visible} book${visible === 1 ? "" : "s"}`;
    }

    function applySort() {
      if (!grid || !sort) return;
      const mode = sort.value;
      const books = getBooks();
      books.sort((a, b) => {
        if (mode === "title") {
          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "");
        }
        return Number(b.dataset.sortKey ?? 0) - Number(a.dataset.sortKey ?? 0);
      });
      books.forEach((book) => grid.appendChild(book));
    }

    search?.addEventListener("input", applyFilters);
    sort?.addEventListener("change", () => {
      applySort();
      applyFilters();
    });

    viewToggle?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement) || !target.dataset.view) return;
      viewToggle.querySelectorAll("button").forEach((btn) => {
        btn.classList.toggle("is-active", btn === target);
      });
      grid?.classList.toggle("nc-grid--list", target.dataset.view === "list");
    });

    createBtn?.addEventListener("click", async () => {
      createBtn.setAttribute("disabled", "true");
      try {
        const res = await fetch("/api/novels/", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title: "Untitled Novel" }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Create failed");
        window.location.href = `/novels/${data.id}/?mode=write`;
      } catch (err) {
        const msg = err instanceof Error ? err.message : "Could not create novel";
        if (msg.includes("Free plan allows")) {
          showToast(`${msg} Upgrade at /account/billing/`);
        } else {
          showToast(msg);
        }
        createBtn.removeAttribute("disabled");
      }
    });

    importTrigger?.addEventListener("click", () => importInput?.click());

    importInput?.addEventListener("change", async () => {
      const file = importInput.files?.[0];
      if (!file) return;
      const form = new FormData();
      form.append("file", file);
      form.append("title", file.name.replace(/\.[^.]+$/, ""));
      showToast(`Importing “${file.name}”…`);
      try {
        const res = await fetch("/api/novels/import/", { method: "POST", body: form });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Import failed");
        window.location.href = `/novels/${data.id}/?mode=write`;
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Import failed");
      }
      importInput.value = "";
    });

    applySort();
  </script>
</NovelcrafterLayout>
