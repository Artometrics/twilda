---
export const prerender = false;

import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import NovelsTopbar from "@/components/novels/NovelsTopbar.astro";
import Cover from "@/apps/novelcrafter/Cover.astro";
import { listNovels, formatUpdated } from "@/lib/novels/service";
import { requireAuth } from "@/lib/auth/guards";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const { user, supabase } = auth;
const novels = await listNovels(supabase, user.id);

const { data: subscription } = await supabase
  .from("subscriptions")
  .select("ai_credits_remaining, ai_credits_monthly")
  .eq("user_id", user.id)
  .maybeSingle();

const grouped = novels.reduce<Record<string, typeof novels>>((acc, novel) => {
  const key = novel.series_name ?? "No Series";
  (acc[key] ??= []).push(novel);
  return acc;
}, {});
---

<NovelcrafterLayout title="Series · Twilda">
  <NovelsTopbar
    active="series"
    userEmail={user.email}
    credits={subscription?.ai_credits_remaining ?? 5}
    creditsMax={subscription?.ai_credits_monthly ?? 5}
  />

  <main class="nc-library">
    <div class="nc-library__head">
      <h1>Your Series</h1>
      <p>Group related novels into series to keep worlds, characters, and timelines connected.</p>
    </div>

    <div class="nc-toolbar">
      <a class="nc-btn" href="/novels/">Back to Novels</a>
    </div>

    {
      Object.entries(grouped).map(([series, items]) => (
        <section class="nc-series-group">
          <h2 class="nc-group-title">
            {series} <span>{items.length} book{items.length === 1 ? "" : "s"}</span>
          </h2>
          <div class="nc-grid">
            {items.map((n) => (
              <a class="nc-book" href={`/novels/${n.id}/`}>
                <div class="nc-book__cover">
                  <Cover kind={n.cover_kind} title={n.title} author={n.author} />
                </div>
                <p class="nc-book__title">{n.title}</p>
                <p class="nc-book__date">{formatUpdated(n.updated_at)}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</NovelcrafterLayout>
