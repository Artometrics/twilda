---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Cover from "@/apps/novelcrafter/Cover.astro";
import { listNovels, formatUpdated } from "@/lib/novels/service";
import { requireAuth } from "@/lib/auth/guards";
import "@/styles/library.css";
import "@/styles/novelcrafter.css";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const { user, supabase } = auth;
const novels = await listNovels(supabase, user.id);

const grouped = novels.reduce<Record<string, typeof novels>>((acc, novel) => {
  const key = novel.series_name ?? "No Series";
  (acc[key] ??= []).push(novel);
  return acc;
}, {});
---

<BaseLayout
  title="Series · Twilda"
  description="Your Twilda series."
  canonicalPath="/novels/series/"
  noindex={true}
  hideFooter={true}
>
  <section class="tw-lib">
    <Wrapper variant="standard" class="pt-32 pb-24 lg:pt-40">
      <div class="tw-lib__head">
        <h1>Your Series</h1>
        <p>Group related novels to keep worlds and timelines connected.</p>
      </div>

      <div class="tw-lib__toolbar">
        <Button isLink={true} size="sm" variant="default" href="/novels/">
          ← Library
        </Button>
      </div>

      {
        Object.entries(grouped).map(([series, items]) => (
          <section>
            <h2 class="tw-lib__group">
              {series} <span>{items.length} book{items.length === 1 ? "" : "s"}</span>
            </h2>
            <div class="tw-lib__grid">
              {items.map((n) => (
                <a class="tw-lib__book" href={`/novels/${n.id}/`}>
                  <div class="tw-lib__cover">
                    <Cover kind={n.cover_kind} title={n.title} author={n.author} />
                  </div>
                  <p class="tw-lib__title">{n.title}</p>
                  <p class="tw-lib__meta">{formatUpdated(n.updated_at)}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </Wrapper>
  </section>
</BaseLayout>
