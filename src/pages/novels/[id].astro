---
export const prerender = false;

import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import Cover from "@/apps/novelcrafter/Cover.astro";
import {
  codexOrder,
  paragraphs,
  wordCount,
  novelWordCount,
  type CodexEntry,
} from "@/apps/novelcrafter/data";
import {
  getNovelFull,
  dbNovelToLegacy,
  listSnippets,
  ensureTrinityDrafts,
} from "@/lib/novels/service";
import { listDraftReferences, ensureDefaultDraft } from "@/lib/novels/drafts";
import {
  isStoryboardSetupError,
  listStoryboardPanels,
  type StoryboardPanel,
} from "@/lib/novels/storyboard";
import {
  ensureMangaSeeded,
  listMangaPages,
  type MangaPage,
} from "@/lib/novels/manga";
import MangaStudio from "@/components/novels/MangaStudio.astro";
import { requireAuth, dbErrorMessage } from "@/lib/auth/guards";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const { user, supabase } = auth;
const { id } = Astro.params;
const draftParam = Astro.url.searchParams.get("draft");

await ensureTrinityDrafts(supabase, user.id, id!);
await ensureDefaultDraft(supabase, user.id, id!);

const dbNovel = await getNovelFull(supabase, user.id, id!, draftParam);
if (!dbNovel) {
  return Astro.redirect("/novels/");
}

const novel = dbNovelToLegacy(dbNovel);
const drafts = dbNovel.drafts;
const activeDraft = dbNovel.active_draft;
const draftRefs = activeDraft
  ? await listDraftReferences(supabase, user.id, id!, activeDraft.id)
  : [];
const otherDrafts = drafts.filter((d) => d.id !== activeDraft?.id);

const totalWords = novelWordCount(novel);

const snippets = await listSnippets(supabase, user.id, id!);

let storyboardPanels: StoryboardPanel[] = [];
let storyboardError: string | null = null;
try {
  storyboardPanels = await listStoryboardPanels(
    supabase,
    user.id,
    id!,
    activeDraft?.id ?? null,
  );
} catch (error) {
  storyboardError = dbErrorMessage(error);
}

let mangaPages: MangaPage[] = [];
let mangaError: string | null = null;
const mangaView = Astro.url.searchParams.get("view") === "read" ? "read" : "studio";
const mangaPageKey = Astro.url.searchParams.get("page");
if (activeDraft?.id) {
  try {
    await ensureMangaSeeded(supabase, user.id, id!, activeDraft.id);
    mangaPages = await listMangaPages(supabase, user.id, id!, activeDraft.id);
  } catch (error) {
    mangaError = dbErrorMessage(error);
  }
}

const entriesByType = (t: string): CodexEntry[] =>
  novel.codex.filter((e) => e.type === t);

function avatarStyle(seed: string): string {
  let h = 0;
  for (const c of seed) h = (h * 31 + c.charCodeAt(0)) % 360;
  const h2 = (h + 45) % 360;
  return `background-image:linear-gradient(135deg, hsl(${h} 68% 56%), hsl(${h2} 62% 40%));`;
}

function escapeHtml(value: string): string {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function sceneToHtml(content: string | null | undefined, text: string): string {
  const trimmed = content?.trim();
  if (trimmed) return trimmed;
  const parts = paragraphs(text);
  if (parts.length === 0) return "<p><br></p>";
  return parts.map((p) => `<p>${escapeHtml(p)}</p>`).join("");
}
---

<NovelcrafterLayout title={`${novel.title} · Twilda`}>
  <div class="nc-ws">
    <!-- Header -->
    <header class="nc-ws__header">
      <a class="nc-iconbtn" href="/novels/" aria-label="Back to library">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
      </a>
      <a class="nc-ws__brand" href="/novels/">Twilda</a>
      <button
        class="nc-iconbtn"
        type="button"
        data-mode-btn="settings"
        aria-label="Settings"
        aria-controls="mode-panel-settings"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1l2-1.6-2-3.4-2.4 1a7 7 0 0 0-1.7-1L14.5 3h-4l-.3 2.4a7 7 0 0 0-1.7 1l-2.4-1-2 3.4 2 1.6a7 7 0 0 0 0 2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 1.7 1l.3 2.4h4l.3-2.4a7 7 0 0 0 1.7-1l2.4 1 2-3.4-2-1.6c.1-.3.1-.7.1-1z"/></svg>
      </button>
      <div class="nc-ws__novel">
        <a href={`/novels/${novel.id}/?mode=settings`} class="nc-ws__novel-link">
          <span class="nc-ws__thumb"><Cover kind={novel.cover} title={novel.title} author={novel.author} /></span>
          <span>
            <strong>{novel.title}</strong>
            <span>{novel.author}</span>
          </span>
        </a>
        <div class="nc-drafts" data-drafts>
          <label class="nc-drafts__label" for="draft-select">Draft / timeline</label>
          <div class="nc-drafts__row">
            <select class="nc-input nc-drafts__select" id="draft-select" data-draft-select>
              {
                drafts.map((d) => (
                  <option value={d.id} selected={d.id === activeDraft?.id}>
                    {d.name}
                  </option>
                ))
              }
            </select>
            <button class="nc-btn" type="button" data-new-draft title="New draft or timeline">+ Draft</button>
          </div>
          {activeDraft?.summary && <p class="nc-drafts__sum">{activeDraft.summary}</p>}
        </div>
      </div>

      <div class="nc-modes" role="tablist" aria-label="Editor mode">
        <button
          class="is-active"
          data-mode-btn="plan"
          type="button"
          role="tab"
          id="mode-tab-plan"
          aria-selected="true"
          aria-controls="mode-panel-plan"
          tabindex="0"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="15" width="7" height="5" rx="1"/><rect x="14" y="15" width="7" height="5" rx="1"/></svg>
          Plan
        </button>
        <button
          data-mode-btn="write"
          type="button"
          role="tab"
          id="mode-tab-write"
          aria-selected="false"
          aria-controls="mode-panel-write"
          tabindex="-1"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          Write
        </button>
        <button
          data-mode-btn="board"
          type="button"
          role="tab"
          id="mode-tab-board"
          aria-selected="false"
          aria-controls="mode-panel-board"
          tabindex="-1"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="10" rx="1.5"/><path d="M7 19h10M9 15v4M15 15v4"/></svg>
          Board
        </button>
        <button
          data-mode-btn="manga"
          type="button"
          role="tab"
          id="mode-tab-manga"
          aria-selected="false"
          aria-controls="mode-panel-manga"
          tabindex="-1"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
          Manga
        </button>
        <button
          data-mode-btn="settings"
          type="button"
          role="tab"
          id="mode-tab-settings"
          aria-selected="false"
          aria-controls="mode-panel-settings"
          tabindex="-1"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1l2-1.6-2-3.4-2.4 1a7 7 0 0 0-1.7-1L14.5 3h-4l-.3 2.4a7 7 0 0 0-1.7 1l-2.4-1-2 3.4 2 1.6a7 7 0 0 0 0 2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 1.7 1l.3 2.4h4l.3-2.4a7 7 0 0 0 1.7-1l2.4 1 2-3.4-2-1.6c.1-.3.1-.7.1-1z"/></svg>
          Settings
        </button>
      </div>

      <div class="nc-ws__toolright">
        <span>{totalWords.toLocaleString()} words</span>
      </div>
    </header>

    <div class="nc-ws__body">
      <button class="nc-side-scrim" type="button" data-side-scrim aria-label="Close sidebar"></button>
      <!-- Sidebar -->
      <aside class="nc-side">
        <div class="nc-side__tabs">
          <button class="is-active" data-side-tab="codex" type="button">Codex</button>
          <button data-side-tab="snippets" type="button">Snippets</button>
          <button data-side-tab="refs" type="button">Refs</button>
          <button
            class="nc-side__hide"
            type="button"
            data-side-hide
            aria-label="Hide sidebar"
            title="Hide sidebar"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        <!-- Codex tab -->
        <div class="nc-side__pane is-active" data-side-pane="codex">
          <div class="nc-side__search">
            <input class="nc-input" type="search" placeholder="Search all entries…" data-codex-search />
            <button class="nc-btn" type="button" data-new-entry>+ New Entry</button>
          </div>
          <div class="nc-side__scroll">
            {
              novel.codex.length === 0 ? (
                <div class="nc-side__empty">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5A2.5 2.5 0 0 1 4 20.5z"/></svg>
                  <p>Your Codex is empty.<br/>Add characters, locations and lore as you write.</p>
                </div>
              ) : (
                codexOrder.map((group) => {
                  const items = entriesByType(group.type);
                  if (items.length === 0) return null;
                  return (
                    <section class="nc-cx-group" data-cx-group={group.type}>
                      <div class="nc-cx-group__head" data-cx-toggle>
                        <h4>{group.label}</h4>
                        <span class="nc-cx-group__count">{items.length} entries</span>
                        <svg class="nc-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                      </div>
                      <div class="nc-cx-list">
                        {items.map((e) => (
                          <button class="nc-cx-item" type="button" data-entry={e.id} data-name={e.name.toLowerCase()} data-entry-type={e.type}>
                            <span class="nc-cx-av" style={avatarStyle(e.id)}>{e.initials}</span>
                            <span class="nc-cx-body">
                              <p class="nc-cx-name">{e.name}</p>
                              <span class="nc-cx-tags">
                                {e.tags.slice(0, 4).map((t) => (<span class="nc-tag">{t}</span>))}
                              </span>
                              <p class="nc-cx-sum">{e.summary}</p>
                            </span>
                          </button>
                        ))}
                      </div>
                    </section>
                  );
                })
              )
            }
          </div>
        </div>

        <!-- Snippets tab -->
        <div class="nc-side__pane" data-side-pane="snippets" hidden>
          <div class="nc-side__scroll">
            {
              snippets.length === 0 ? (
                <div class="nc-side__empty" style="padding-top:40px;">
                  <p>No snippets yet.<br/>Save reusable text fragments here.</p>
                </div>
              ) : (
                snippets.map((s) => (
                  <div class="nc-snippet">
                    <p class="nc-snippet__title">{s.title}</p>
                    <p class="nc-snippet__body">{s.content}</p>
                  </div>
                ))
              )
            }
          </div>
          <form class="nc-snippet-form" data-snippet-form>
            <input class="nc-input" name="title" placeholder="Snippet title" />
            <textarea class="nc-textarea" name="content" rows="3" placeholder="Snippet text"></textarea>
            <button class="nc-btn nc-btn--primary" type="submit">Save snippet</button>
          </form>
        </div>

        <!-- Refs tab — cross-draft timelines -->
        <div class="nc-side__pane" data-side-pane="refs" hidden>
          <div class="nc-side__scroll">
            <p class="nc-refs__intro">Pin another draft or timeline so you can consult it while writing in this one.</p>
            {
              draftRefs.length === 0 ? (
                <div class="nc-side__empty" style="padding-top:24px;">
                  <p>No references yet.<br/>Browse another timeline below and pin it.</p>
                </div>
              ) : (
                draftRefs.map((r) => (
                  <div class="nc-ref-item" data-ref-id={r.id}>
                    <p class="nc-ref-item__type">{r.source_type} · {r.source_draft_name}</p>
                    <p class="nc-ref-item__name">{r.source_label}</p>
                    {r.source_summary && <p class="nc-ref-item__sum">{r.source_summary}</p>}
                    {r.note && <p class="nc-ref-item__note">{r.note}</p>}
                    <button class="nc-btn nc-btn--ghost" type="button" data-unref={r.id}>Remove</button>
                  </div>
                ))
              )
            }
            {
              otherDrafts.length > 0 && (
                <div class="nc-refs__browse">
                  <p class="nc-refs__browse-title">Reference another timeline</p>
                  {otherDrafts.map((d) => (
                    <div class="nc-refs__source">
                      <div class="nc-refs__source-head">
                        <strong>{d.name}</strong>
                        <button
                          class="nc-btn"
                          type="button"
                          data-ref-draft={d.id}
                          data-ref-name={d.name}
                        >
                          Pin timeline
                        </button>
                      </div>
                      {d.summary && <p class="nc-refs__source-sum">{d.summary}</p>}
                      <button class="nc-btn nc-btn--ghost" type="button" data-browse-draft={d.id}>
                        Browse entries…
                      </button>
                      <div class="nc-refs__library" data-browse-panel={d.id} hidden></div>
                    </div>
                  ))}
                </div>
              )
            }
          </div>
        </div>

        <div class="nc-side__foot">
          <span class="nc-avatar-sm" style="width:24px;height:24px;font-size:11px;">
            {(user.email?.[0] ?? "U").toUpperCase()}
          </span>
          <a href="/blog/">Journal</a>
          <a href="/account/">Account</a>
          <button class="nc-btn nc-btn--ghost" type="button" data-export>Export</button>
        </div>
      </aside>

      <!-- Main -->
      <div class="nc-main">
        <div class="nc-main__mobilebar">
          <button class="nc-btn" type="button" data-side-show>Codex / Refs</button>
        </div>
        <!-- PLAN -->
        <section
          class="nc-mode-panel is-active"
          data-mode="plan"
          role="tabpanel"
          id="mode-panel-plan"
          aria-labelledby="mode-tab-plan"
        >
          <div class="nc-plan">
            <div class="nc-plan__actions">
              <button class="nc-btn" type="button" data-add-chapter>+ Add chapter</button>
            </div>
            {
              novel.chapters.map((ch, ci) => {
                const cw = ch.scenes.reduce((s, sc) => s + wordCount(sc.text), 0);
                const chapterId = dbNovel.chapters[ci]?.id;
                return (
                  <article class="nc-chapter" data-chapter-id={chapterId}>
                    <div class="nc-chapter__head">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                      <h3>{ch.title}</h3>
                      <span class="nc-chapter__meta">{ch.scenes.length} scene{ch.scenes.length === 1 ? "" : "s"} · {cw.toLocaleString()} words</span>
                      {chapterId && (
                        <button class="nc-btn nc-btn--ghost" type="button" data-add-scene={chapterId}>+ Scene</button>
                      )}
                    </div>
                    {ch.scenes.map((sc) => {
                      const preview = paragraphs(sc.text)[0] ?? "";
                      return (
                        <button
                          class="nc-scene nc-scene--jump"
                          type="button"
                          data-goto-scene={sc.id}
                          disabled={!sc.id}
                        >
                          <p class="nc-scene__title">{sc.title} · {wordCount(sc.text).toLocaleString()} words</p>
                          <p class="nc-scene__preview">{preview || "Empty scene — open Write mode to start."}</p>
                        </button>
                      );
                    })}
                  </article>
                );
              })
            }
          </div>
        </section>

        <!-- WRITE -->
        <section
          class="nc-mode-panel"
          data-mode="write"
          role="tabpanel"
          id="mode-panel-write"
          aria-labelledby="mode-tab-write"
          hidden
        >
          <div class="nc-manuscript" data-novel={novel.id}>
            {
              totalWords === 0 ? (
                <div class="nc-ms-empty">
                  <h3>{novel.title}</h3>
                  <p>
                    Your manuscript is blank. Add a chapter in Plan, then write your first scene here.
                  </p>
                  <button class="nc-btn nc-btn--primary" type="button" data-mode-btn="plan">
                    Go to Plan
                  </button>
                </div>
              ) : null
            }
            {
              novel.chapters.map((ch, ci) => (
                <>
                  <p class="nc-ms-chapter-title">{ch.title}</p>
                  {ch.scenes.map((sc, si) => (
                    <div
                      class="nc-ms-scene"
                      contenteditable="true"
                      spellcheck="true"
                      role="textbox"
                      aria-multiline="true"
                      aria-label={sc.title ? `Write scene: ${sc.title}` : `Write scene ${si + 1} in ${ch.title}`}
                      data-scene-id={sc.id}
                      data-scene-index={`${ci}-${si}`}
                      set:html={sceneToHtml(sc.content, sc.text)}
                    />
                  ))}
                </>
              ))
            }
          </div>
        </section>

        <!-- BOARD / storyboard -->
        <section
          class="nc-mode-panel"
          data-mode="board"
          role="tabpanel"
          id="mode-panel-board"
          aria-labelledby="mode-tab-board"
          hidden
        >
          <div class="nc-board" data-storyboard data-draft-id={activeDraft?.id ?? ""}>
            <div class="nc-board__intro">
              <div>
                <h2>Storyboard</h2>
                <p>
                  16:9 panels for AI image sessions — drop a frame, write the shot line, keep the prompt ready to copy.
                </p>
              </div>
              <div class="nc-board__intro-actions" data-board-toolbar>
                <button
                  class="nc-btn"
                  type="button"
                  data-copy-all-prompts
                  hidden={Boolean(storyboardError) || storyboardPanels.length === 0}
                >
                  Copy all prompts
                </button>
                <button
                  class="nc-btn"
                  type="button"
                  data-export-prompts
                  hidden={Boolean(storyboardError) || storyboardPanels.length === 0}
                >
                  Export .txt
                </button>
                <button
                  class="nc-btn nc-btn--primary"
                  type="button"
                  data-add-panel
                  disabled={Boolean(storyboardError)}
                  title={storyboardError ? "Set up the storyboard database first" : "Add a panel"}
                >
                  + Add panel
                </button>
              </div>
            </div>

            {
              storyboardError && (
                <div class="nc-board__alert" role="alert">
                  {isStoryboardSetupError(storyboardError)
                    ? "Storyboard needs one Supabase setup step: run supabase/migrations/009_storyboard_panels.sql in the SQL Editor, then refresh this page."
                    : `Could not load storyboard: ${storyboardError}`}
                </div>
              )
            }

            <div class="nc-board__list" data-board-list>
              {
                !storyboardError &&
                  storyboardPanels.map((panel, index) => (
                    <article class="nc-panel-card" data-panel-id={panel.id}>
                      <div class="nc-panel-card__top">
                        <span class="nc-panel-card__num">Panel {index + 1}</span>
                        <div class="nc-panel-card__top-actions">
                          <button
                            class="nc-btn nc-btn--ghost"
                            type="button"
                            data-move-panel="up"
                            aria-label="Move panel up"
                            disabled={index === 0}
                          >
                            ↑
                          </button>
                          <button
                            class="nc-btn nc-btn--ghost"
                            type="button"
                            data-move-panel="down"
                            aria-label="Move panel down"
                            disabled={index === storyboardPanels.length - 1}
                          >
                            ↓
                          </button>
                          <button
                            class="nc-btn nc-btn--ghost"
                            type="button"
                            data-delete-panel
                            aria-label={`Delete panel ${index + 1}`}
                          >
                            Delete
                          </button>
                        </div>
                      </div>
                      <label class="nc-panel-card__frame" data-panel-dropzone>
                        <input
                          type="file"
                          accept="image/jpeg,image/png,image/webp,image/gif"
                          data-panel-image
                          hidden
                        />
                        {panel.image_url ? (
                          <img src={panel.image_url} alt="" data-panel-preview />
                        ) : (
                          <span class="nc-panel-card__empty" data-panel-empty>
                            <strong>Upload 16:9</strong>
                            <em>Tap, drop, or paste a frame</em>
                          </span>
                        )}
                        {!panel.image_url ? null : (
                          <span class="nc-panel-card__replace">Replace image</span>
                        )}
                      </label>
                      <label class="nc-panel-card__field">
                        <span>Shot line</span>
                        <input
                          class="nc-input"
                          type="text"
                          data-panel-caption
                          value={panel.caption}
                          placeholder="What happens in this frame…"
                        />
                      </label>
                      <div class="nc-panel-card__field">
                        <div class="nc-panel-card__field-head">
                          <span>Image prompt</span>
                          <button class="nc-btn nc-btn--primary" type="button" data-copy-prompt>
                            Copy prompt
                          </button>
                        </div>
                        <textarea
                          class="nc-textarea"
                          rows="4"
                          data-panel-prompt
                          placeholder="Paste or write the prompt for your image model…"
                        >{panel.prompt}</textarea>
                      </div>
                      <p class="nc-panel-card__status" data-panel-status hidden></p>
                    </article>
                  ))
              }
            </div>

            {
              !storyboardError && (
                <div
                  class="nc-board__empty"
                  data-board-empty
                  hidden={storyboardPanels.length > 0}
                >
                  <p>No panels yet.</p>
                  <p>Add a panel, drop a 16:9 still, then keep the prompt next to it for your image model.</p>
                  <button class="nc-btn nc-btn--primary" type="button" data-add-panel>
                    + Add panel
                  </button>
                </div>
              )
            }

            {
              !storyboardError && (
                <div
                  class="nc-board__footer"
                  data-board-footer
                  hidden={storyboardPanels.length === 0}
                >
                  <button class="nc-btn nc-btn--primary" type="button" data-add-panel>
                    + Add panel
                  </button>
                </div>
              )
            }
          </div>
        </section>

        <!-- MANGA STUDIO -->
        <section
          class="nc-mode-panel"
          data-mode="manga"
          role="tabpanel"
          id="mode-panel-manga"
          aria-labelledby="mode-tab-manga"
          hidden
        >
          <MangaStudio
            novelId={novel.id}
            draftId={activeDraft?.id ?? null}
            pages={mangaPages}
            error={mangaError}
            view={mangaView}
            selectedSceneKey={mangaPageKey}
          />
        </section>

        <!-- SETTINGS -->
        <section
          class="nc-mode-panel"
          data-mode="settings"
          role="tabpanel"
          id="mode-panel-settings"
          aria-labelledby="mode-tab-settings"
          hidden
        >
          <div class="nc-plan">
            <article class="nc-chapter">
              <div class="nc-chapter__head"><h3>Metadata</h3></div>
              <form class="nc-settings-form" data-settings-form>
                <div class="nc-scene">
                  <label class="nc-field">
                    <span class="nc-scene__title">Novel Title</span>
                    <input class="nc-input" name="title" value={novel.title} />
                  </label>
                  <label class="nc-field">
                    <span class="nc-scene__title">Author / Pen name</span>
                    <input class="nc-input" name="author" value={novel.author} />
                  </label>
                  <label class="nc-field">
                    <span class="nc-scene__title">Series</span>
                    <input class="nc-input" name="series_name" value={novel.series ?? ""} placeholder="Optional series name" />
                  </label>
                  <label class="nc-field">
                    <span class="nc-scene__title">Synopsis</span>
                    <textarea class="nc-textarea" name="synopsis" rows="5">{novel.synopsis}</textarea>
                  </label>
                  <button class="nc-btn nc-btn--primary" type="submit">Save metadata</button>
                  <button class="nc-btn nc-btn--ghost" type="button" data-delete-novel>
                    Delete novel
                  </button>
                </div>
              </form>
            </article>
          </div>
        </section>
      </div>
    </div>

    <!-- Codex detail overlays -->
    <div class="nc-detail-backdrop" data-detail-backdrop></div>
    {
      novel.codex.map((e) => (
        <div class="nc-detail" data-detail={e.id}>
          <div class="nc-detail__top">
            <span class="nc-detail__av" style={avatarStyle(e.id)}>{e.initials}</span>
            <div>
              <p class="nc-detail__title">{e.name}</p>
              <span class="nc-detail__type">{e.type}</span>
            </div>
            <button class="nc-iconbtn nc-detail__close" type="button" data-detail-close aria-label="Close">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
          <div class="nc-detail__tags">
            {e.tags.map((t) => (<span class="nc-tag">{t}</span>))}
          </div>
          <div class="nc-detail__tabs" role="tablist" aria-label={`${e.name} details`}>
            <button type="button" class="is-active" role="tab" aria-selected="true" data-detail-tab="details">
              Details
            </button>
            {
              typeof e.mentions === "number" && (
                <button type="button" role="tab" aria-selected="false" data-detail-tab="mentions">
                  Mentions
                </button>
              )
            }
          </div>
          <div class="nc-detail__pane is-active" data-detail-pane="details" role="tabpanel">
            {e.aliases && e.aliases.length > 0 && (
              <>
                <p class="nc-detail__label">ALIASES / NICKNAMES</p>
                <div class="nc-detail__field">{e.aliases.join(", ")}</div>
              </>
            )}
            <p class="nc-detail__label">DESCRIPTION</p>
            <div class="nc-detail__field">{e.description}</div>
            {
              e.appearance_lock && (
                <>
                  <p class="nc-detail__label">APPEARANCE LOCK</p>
                  <div class="nc-detail__field">{e.appearance_lock}</div>
                </>
              )
            }
            {
              e.element_id && (
                <>
                  <p class="nc-detail__label">HIGGSFIELD ELEMENT</p>
                  <div class="nc-detail__field">
                    <code>{e.element_id}</code>
                  </div>
                </>
              )
            }
          </div>
          {
            typeof e.mentions === "number" && (
              <div class="nc-detail__pane" data-detail-pane="mentions" role="tabpanel" hidden>
                <p class="nc-detail__label">MENTIONS</p>
                <div class="nc-detail__field">{e.mentions} mentions in the manuscript</div>
              </div>
            )
          }
        </div>
      ))
    }
  </div>

  <div class="nc-modal-backdrop" data-entry-modal-backdrop hidden></div>
  <div class="nc-modal" data-entry-modal hidden>
    <div class="nc-modal__head">
      <h3>New Codex Entry</h3>
      <button class="nc-iconbtn" type="button" data-entry-modal-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <form class="nc-modal__body" data-entry-form>
      <label class="nc-field">
        <span>Name</span>
        <input class="nc-input" name="name" required placeholder="Character or location name" />
      </label>
      <label class="nc-field">
        <span>Type</span>
        <select class="nc-select" name="type">
          <option value="character">Character</option>
          <option value="location">Location</option>
          <option value="lore">Lore</option>
          <option value="other">Other</option>
        </select>
      </label>
      <label class="nc-field">
        <span>Summary</span>
        <input class="nc-input" name="summary" placeholder="One-line summary" />
      </label>
      <label class="nc-field">
        <span>Description</span>
        <textarea class="nc-textarea" name="description" rows="4" placeholder="Full description"></textarea>
      </label>
      <div class="nc-modal__actions">
        <button class="nc-btn" type="button" data-entry-modal-close>Cancel</button>
        <button class="nc-btn nc-btn--primary" type="submit">Save Entry</button>
      </div>
    </form>
  </div>

  <div class="nc-detail nc-detail--dynamic" data-user-detail hidden>
    <div class="nc-detail__top">
      <span class="nc-detail__av" data-user-detail-av>??</span>
      <div>
        <p class="nc-detail__title" data-user-detail-title></p>
        <span class="nc-detail__type" data-user-detail-type></span>
      </div>
      <button class="nc-iconbtn nc-detail__close" type="button" data-user-detail-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <p class="nc-detail__label">DESCRIPTION</p>
    <div class="nc-detail__field" data-user-detail-description></div>
  </div>

  <div class="nc-toast" data-toast hidden></div>

  <script define:vars={{ novelId: novel.id, novelTitle: novel.title, activeDraftId: activeDraft?.id ?? null }}>
    const toast = document.querySelector("[data-toast]");
    function showToast(message) {
      if (!toast) return;
      toast.textContent = message;
      toast.hidden = false;
      toast.classList.add("is-visible");
      window.setTimeout(() => {
        toast.classList.remove("is-visible");
        window.setTimeout(() => {
          toast.hidden = true;
        }, 300);
      }, 2400);
    }

    // Draft / timeline switcher
    document.querySelector("[data-draft-select]")?.addEventListener("change", async (event) => {
      const draftId = event.target.value;
      try {
        await flushPendingSaves();
        const res = await fetch(`/api/novels/${novelId}/drafts/`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "activate", draft_id: draftId }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Could not switch draft");
        const url = new URL(window.location.href);
        url.searchParams.set("draft", draftId);
        window.location.href = url.toString();
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Draft switch failed");
      }
    });

    document.querySelector("[data-new-draft]")?.addEventListener("click", async () => {
      const name = window.prompt("Name this draft or timeline", "New timeline");
      if (!name) return;
      try {
        await flushPendingSaves();
        const res = await fetch(`/api/novels/${novelId}/drafts/`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, setActive: true }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Could not create draft");
        const url = new URL(window.location.href);
        url.searchParams.set("draft", data.id);
        window.location.href = url.toString();
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Create draft failed");
      }
    });

    async function pinReference(payload) {
      if (!activeDraftId) {
        showToast("No active draft");
        return;
      }
      try {
        const res = await fetch(`/api/novels/${novelId}/references/`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ draft_id: activeDraftId, ...payload }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Could not pin reference");
        showToast("Referenced in this draft");
        window.setTimeout(() => window.location.reload(), 400);
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Reference failed");
      }
    }

    document.querySelectorAll("[data-ref-draft]").forEach((btn) => {
      btn.addEventListener("click", () => {
        pinReference({
          source_draft_id: btn.getAttribute("data-ref-draft"),
          source_type: "draft",
          note: `Consulting ${btn.getAttribute("data-ref-name") || "timeline"}`,
        });
      });
    });

    document.querySelectorAll("[data-unref]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-unref");
        try {
          const res = await fetch(`/api/novels/${novelId}/references/?id=${encodeURIComponent(id)}`, {
            method: "DELETE",
          });
          if (!res.ok) throw new Error("Could not remove reference");
          window.location.reload();
        } catch (err) {
          showToast(err instanceof Error ? err.message : "Remove failed");
        }
      });
    });

    document.querySelectorAll("[data-browse-draft]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const sourceId = btn.getAttribute("data-browse-draft");
        const panel = document.querySelector(`[data-browse-panel="${sourceId}"]`);
        if (!panel) return;
        if (!panel.hasAttribute("hidden") && panel.innerHTML.trim()) {
          panel.setAttribute("hidden", "");
          return;
        }
        panel.textContent = "Loading…";
        panel.removeAttribute("hidden");
        try {
          const res = await fetch(
            `/api/novels/${novelId}/references/?browse=${encodeURIComponent(sourceId)}`,
          );
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Browse failed");
          panel.innerHTML = "";
          const addBtn = (label, payload) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "nc-btn nc-btn--ghost nc-refs__pin";
            b.textContent = label;
            b.addEventListener("click", () => pinReference(payload));
            panel.appendChild(b);
          };
          (data.codex || []).forEach((e) => {
            addBtn(`Pin codex: ${e.name}`, {
              source_draft_id: sourceId,
              source_type: "codex",
              source_id: e.id,
            });
          });
          (data.snippets || []).forEach((s) => {
            addBtn(`Pin snippet: ${s.title || "Untitled"}`, {
              source_draft_id: sourceId,
              source_type: "snippet",
              source_id: s.id,
            });
          });
          if (!panel.childNodes.length) {
            panel.textContent = "No entries in this timeline yet.";
          }
        } catch (err) {
          panel.textContent = err instanceof Error ? err.message : "Browse failed";
        }
      });
    });

    // Mode tabs (Plan / Write / Settings)
    const modeBtns = document.querySelectorAll("[data-mode-btn]");
    const panels = document.querySelectorAll(".nc-mode-panel");
    const topModeBtns = document.querySelectorAll(".nc-modes [data-mode-btn]");
    function setMode(mode) {
      panels.forEach((p) => {
        const on = p.dataset.mode === mode;
        p.classList.toggle("is-active", on);
        if (on) p.removeAttribute("hidden");
        else p.setAttribute("hidden", "");
      });
      topModeBtns.forEach((b) => {
        const on = b.dataset.modeBtn === mode;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
        b.setAttribute("tabindex", on ? "0" : "-1");
      });
    }
    modeBtns.forEach((b) =>
      b.addEventListener("click", () => setMode(b.dataset.modeBtn)),
    );
    // Arrow-key navigation within the mode tablist
    document.querySelector(".nc-modes")?.addEventListener("keydown", (event) => {
      const tabs = Array.from(topModeBtns);
      const current = tabs.indexOf(document.activeElement);
      if (current < 0) return;
      let next = -1;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (current + 1) % tabs.length;
      if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (current - 1 + tabs.length) % tabs.length;
      if (event.key === "Home") next = 0;
      if (event.key === "End") next = tabs.length - 1;
      if (next < 0) return;
      event.preventDefault();
      const tab = tabs[next];
      setMode(tab.dataset.modeBtn);
      tab.focus();
    });

    const params = new URLSearchParams(window.location.search);
    const initialMode = params.get("mode");
    if (initialMode && ["plan", "write", "board", "manga", "settings"].includes(initialMode)) {
      setMode(initialMode);
    }

    // Sidebar tabs — keep panes as flex so nested .nc-side__scroll can overflow
    const side = document.querySelector(".nc-side");
    const sideTabs = document.querySelectorAll("[data-side-tab]");
    const sidePanes = document.querySelectorAll("[data-side-pane]");
    function isMobileSide() {
      return window.matchMedia("(max-width: 900px)").matches;
    }
    function showSidePane(name) {
      sideTabs.forEach((x) => x.classList.toggle("is-active", x.dataset.sideTab === name));
      sidePanes.forEach((p) => {
        const on = p.dataset.sidePane === name;
        p.classList.toggle("is-active", on);
        if (on) p.removeAttribute("hidden");
        else p.setAttribute("hidden", "");
      });
      if (isMobileSide()) {
        side?.classList.add("is-open");
        document.body.classList.add("nc-side-open");
      }
    }
    sideTabs.forEach((t) =>
      t.addEventListener("click", () => showSidePane(t.dataset.sideTab)),
    );
    function closeSideDrawer() {
      side?.classList.remove("is-open");
      document.body.classList.remove("nc-side-open");
    }
    document.querySelector("[data-side-show]")?.addEventListener("click", () => {
      const active = document.querySelector("[data-side-tab].is-active");
      showSidePane(active?.dataset.sideTab || "codex");
    });
    document.querySelector("[data-side-scrim]")?.addEventListener("click", () => {
      closeSideDrawer();
    });

    // Codex group collapse
    document.querySelectorAll("[data-cx-toggle]").forEach((h) =>
      h.addEventListener("click", () =>
        h.closest(".nc-cx-group")?.classList.toggle("is-collapsed"),
      ),
    );

    // Codex search filter
    const search = document.querySelector("[data-codex-search]");
    search?.addEventListener("input", () => {
      const q = search.value.trim().toLowerCase();
      document.querySelectorAll(".nc-cx-item").forEach((el) => {
        const match = !q || (el.dataset.name ?? "").includes(q);
        el.style.display = match ? "flex" : "none";
      });
    });

    // Codex detail overlay
    const backdrop = document.querySelector("[data-detail-backdrop]");
    const details = document.querySelectorAll("[data-detail]");
    const userDetail = document.querySelector("[data-user-detail]");
    let activeItems = [];

    function closeDetail() {
      backdrop?.classList.remove("is-open");
      details.forEach((d) => d.classList.remove("is-open"));
      userDetail?.classList.remove("is-open");
      userDetail?.setAttribute("hidden", "");
      activeItems.forEach((i) => i.classList.remove("is-active"));
      activeItems = [];
    }

    document.querySelector("[data-side-hide]")?.addEventListener("click", () => {
      closeSideDrawer();
      closeDetail();
    });

    function openStaticDetail(id, item) {
      closeDetail();
      item.classList.add("is-active");
      activeItems = [item];
      backdrop?.classList.add("is-open");
      document.querySelector(`[data-detail="${id}"]`)?.classList.add("is-open");
    }

    function openUserDetail(entry, item) {
      closeDetail();
      item.classList.add("is-active");
      activeItems = [item];
      backdrop?.classList.add("is-open");
      if (!userDetail) return;
      userDetail.querySelector("[data-user-detail-title]").textContent = entry.name;
      userDetail.querySelector("[data-user-detail-type]").textContent = entry.type;
      userDetail.querySelector("[data-user-detail-description]").textContent =
        entry.description || entry.summary || "No description yet.";
      userDetail.querySelector("[data-user-detail-av]").textContent = entry.initials;
      userDetail.removeAttribute("hidden");
      userDetail.classList.add("is-open");
    }

    document.querySelectorAll(".nc-cx-item[data-entry]").forEach((it) => {
      if (it.dataset.userEntry) return;
      it.addEventListener("click", () => openStaticDetail(it.dataset.entry, it));
    });

    backdrop?.addEventListener("click", closeDetail);
    document.querySelectorAll("[data-detail-close], [data-user-detail-close]").forEach((b) =>
      b.addEventListener("click", closeDetail),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      closeDetail();
      closeEntryModal();
      if (window.matchMedia("(max-width: 900px)").matches) closeSideDrawer();
    });

    // Detail sub-tabs
    document.querySelectorAll("[data-detail]").forEach((detail) => {
      const tabs = detail.querySelectorAll("[data-detail-tab]");
      const panes = detail.querySelectorAll("[data-detail-pane]");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const name = tab.dataset.detailTab;
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle("is-active", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
          });
          panes.forEach((p) => {
            const on = p.dataset.detailPane === name;
            p.classList.toggle("is-active", on);
            if (on) p.removeAttribute("hidden");
            else p.setAttribute("hidden", "");
          });
        });
      });
    });

    const entryModal = document.querySelector("[data-entry-modal]");
    const entryBackdrop = document.querySelector("[data-entry-modal-backdrop]");
    const entryForm = document.querySelector("[data-entry-form]");

    function openEntryModal() {
      entryModal?.removeAttribute("hidden");
      entryBackdrop?.removeAttribute("hidden");
      entryModal?.classList.add("is-open");
      entryBackdrop?.classList.add("is-open");
    }

    function closeEntryModal() {
      entryModal?.classList.remove("is-open");
      entryBackdrop?.classList.remove("is-open");
      entryModal?.setAttribute("hidden", "");
      entryBackdrop?.setAttribute("hidden", "");
      entryForm?.reset();
    }

    document.querySelector("[data-new-entry]")?.addEventListener("click", openEntryModal);
    document.querySelectorAll("[data-entry-modal-close]").forEach((btn) =>
      btn.addEventListener("click", closeEntryModal),
    );
    entryBackdrop?.addEventListener("click", closeEntryModal);

    entryForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(entryForm);
      const name = String(data.get("name") || "").trim();
      if (!name) return;
      try {
        const res = await fetch(`/api/novels/${novelId}/codex/`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            type: String(data.get("type") || "other"),
            name,
            summary: String(data.get("summary") || "").trim(),
            description: String(data.get("description") || "").trim(),
          }),
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error || "Save failed");
        closeEntryModal();
        showToast(`Saved “${name}” to your Codex.`);
        window.setTimeout(() => window.location.reload(), 600);
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Could not save entry");
      }
    });

    document.querySelector("[data-export]")?.addEventListener("click", async () => {
      try {
        await flushPendingSaves();
      } catch {
        /* still allow export of last saved state */
      }
      window.location.href = `/api/novels/${novelId}/export/`;
      showToast("Downloading manuscript…");
    });

    const ms = document.querySelector(".nc-manuscript");
    const wordsLabel = document.querySelector(".nc-ws__toolright span");
    const saveTimers = new Map();
    const saveGeneration = new Map();
    const dirtyScenes = new Set();

    function updateCount() {
      if (!ms || !wordsLabel) return;
      let n = 0;
      ms.querySelectorAll(".nc-ms-scene").forEach((sc) => {
        const t = (sc.innerText || "").trim();
        if (t) n += t.split(/\s+/).filter(Boolean).length;
      });
      wordsLabel.textContent = `${n.toLocaleString()} words`;
    }

    async function persistScene(sc, { keepalive = false } = {}) {
      const sceneId = sc.dataset.sceneId;
      if (!sceneId) return;
      const gen = (saveGeneration.get(sceneId) || 0) + 1;
      saveGeneration.set(sceneId, gen);
      const content = sc.innerHTML;
      try {
        const res = await fetch(`/api/novels/${novelId}/scenes/${sceneId}/`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ content }),
          keepalive,
        });
        if (saveGeneration.get(sceneId) !== gen) return;
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || "Autosave failed");
        }
        if (sc.innerHTML === content) dirtyScenes.delete(sceneId);
      } catch (err) {
        if (saveGeneration.get(sceneId) !== gen) return;
        showToast(err instanceof Error ? err.message : "Autosave failed — check your connection.");
        throw err;
      }
    }

    async function flushPendingSaves() {
      if (!ms) return;
      for (const timer of saveTimers.values()) window.clearTimeout(timer);
      saveTimers.clear();
      const scenes = [...ms.querySelectorAll(".nc-ms-scene")].filter((sc) =>
        dirtyScenes.has(sc.dataset.sceneId),
      );
      await Promise.all(scenes.map((sc) => persistScene(sc)));
    }

    function flushWithKeepalive() {
      if (!ms) return;
      for (const timer of saveTimers.values()) window.clearTimeout(timer);
      saveTimers.clear();
      ms.querySelectorAll(".nc-ms-scene").forEach((sc) => {
        if (dirtyScenes.has(sc.dataset.sceneId)) {
          void persistScene(sc, { keepalive: true });
        }
      });
    }

    if (ms) {
      const scenes = ms.querySelectorAll(".nc-ms-scene");

      scenes.forEach((sc) => {
        sc.addEventListener("input", () => {
          updateCount();
          const sceneId = sc.dataset.sceneId;
          if (!sceneId) return;
          dirtyScenes.add(sceneId);
          if (saveTimers.has(sceneId)) window.clearTimeout(saveTimers.get(sceneId));
          saveTimers.set(
            sceneId,
            window.setTimeout(() => {
              saveTimers.delete(sceneId);
              void persistScene(sc);
            }, 800),
          );
        });
      });

      window.addEventListener("beforeunload", (event) => {
        if (dirtyScenes.size > 0 || saveTimers.size > 0) {
          event.preventDefault();
          event.returnValue = "";
        }
      });
      window.addEventListener("pagehide", () => flushWithKeepalive());
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") flushWithKeepalive();
      });

      updateCount();
      if (initialMode === "write") scenes[0]?.focus();
    }

    document.querySelectorAll("[data-goto-scene]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const sceneId = btn.getAttribute("data-goto-scene");
        if (!sceneId) return;
        setMode("write");
        const target = document.querySelector(`[data-scene-id="${sceneId}"]`);
        if (target instanceof HTMLElement) {
          target.scrollIntoView({ behavior: "smooth", block: "center" });
          target.focus();
        }
      });
    });

    document.querySelector("[data-add-chapter]")?.addEventListener("click", async () => {
      try {
        const res = await fetch(`/api/novels/${novelId}/chapters/`, { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
        if (!res.ok) throw new Error("Could not add chapter");
        window.location.reload();
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Add chapter failed");
      }
    });

    document.querySelectorAll("[data-add-scene]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const chapterId = btn.getAttribute("data-add-scene");
        try {
          const res = await fetch(`/api/novels/${novelId}/chapters/${chapterId}/scenes/`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: "{}",
          });
          if (!res.ok) throw new Error("Could not add scene");
          window.location.reload();
        } catch (err) {
          showToast(err instanceof Error ? err.message : "Add scene failed");
        }
      });
    });

    // Storyboard panels
    const boardRoot = document.querySelector("[data-storyboard]");
    if (boardRoot) {
      const boardList = boardRoot.querySelector("[data-board-list]");
      const boardEmpty = boardRoot.querySelector("[data-board-empty]");
      const panelTimers = new Map();
      const dirtyPanels = new Set();

      function panelCount() {
        return boardList?.querySelectorAll("[data-panel-id]").length ?? 0;
      }

      function syncBoardChrome() {
        const count = panelCount();
        const hasPanels = count > 0;
        if (boardEmpty instanceof HTMLElement) boardEmpty.hidden = hasPanels;
        const footer = boardRoot.querySelector("[data-board-footer]");
        if (footer instanceof HTMLElement) footer.hidden = !hasPanels;
        boardRoot.querySelectorAll("[data-copy-all-prompts], [data-export-prompts]").forEach((btn) => {
          if (btn instanceof HTMLElement) btn.hidden = !hasPanels;
        });
        boardList?.querySelectorAll("[data-panel-id]").forEach((card, i) => {
          const num = card.querySelector(".nc-panel-card__num");
          if (num) num.textContent = `Panel ${i + 1}`;
          const up = card.querySelector('[data-move-panel="up"]');
          const down = card.querySelector('[data-move-panel="down"]');
          if (up instanceof HTMLButtonElement) up.disabled = i === 0;
          if (down instanceof HTMLButtonElement) down.disabled = i === count - 1;
        });
      }

      function renumberPanels() {
        syncBoardChrome();
      }

      function collectPrompts() {
        const chunks = [];
        boardList?.querySelectorAll("[data-panel-id]").forEach((card, i) => {
          const caption = card.querySelector("[data-panel-caption]");
          const prompt = card.querySelector("[data-panel-prompt]");
          const line = caption instanceof HTMLInputElement ? caption.value.trim() : "";
          const text = prompt instanceof HTMLTextAreaElement ? prompt.value.trim() : "";
          if (!line && !text) return;
          chunks.push(
            `## Panel ${i + 1}${line ? ` — ${line}` : ""}\n${text || "(no prompt)"}`,
          );
        });
        return chunks.join("\n\n");
      }

      function applyPreview(card, url) {
        const frame = card.querySelector(".nc-panel-card__frame");
        const fileEl = card.querySelector("[data-panel-image]");
        if (!frame || !url) return;
        let img = frame.querySelector("[data-panel-preview]");
        if (!(img instanceof HTMLImageElement)) {
          frame.querySelector("[data-panel-empty]")?.remove();
          img = document.createElement("img");
          img.setAttribute("data-panel-preview", "");
          img.alt = "";
          frame.insertBefore(img, fileEl?.nextSibling ?? null);
          if (!frame.querySelector(".nc-panel-card__replace")) {
            const tip = document.createElement("span");
            tip.className = "nc-panel-card__replace";
            tip.textContent = "Replace image";
            frame.appendChild(tip);
          }
        }
        img.src = url;
      }

      async function uploadPanelFile(card, panelId, file, setPanelStatus) {
        setPanelStatus("Uploading…");
        const form = new FormData();
        form.append("image", file);
        try {
          const res = await fetch(`/api/novels/${novelId}/storyboard/${panelId}/`, {
            method: "PATCH",
            body: form,
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || "Upload failed");
          applyPreview(card, data.panel?.image_url);
          setPanelStatus("Uploaded");
          window.setTimeout(() => setPanelStatus("", false), 1600);
          showToast("Frame uploaded.");
        } catch (err) {
          setPanelStatus(err instanceof Error ? err.message : "Upload failed");
          showToast(err instanceof Error ? err.message : "Upload failed");
        }
      }

      function bindPanelCard(card) {
        if (card.dataset.bound === "1") return;
        card.dataset.bound = "1";
        const panelId = card.getAttribute("data-panel-id");
        if (!panelId) return;
        const statusEl = card.querySelector("[data-panel-status]");
        const captionEl = card.querySelector("[data-panel-caption]");
        const promptEl = card.querySelector("[data-panel-prompt]");
        const fileEl = card.querySelector("[data-panel-image]");
        const dropzone = card.querySelector("[data-panel-dropzone]");

        function setPanelStatus(message, show = true) {
          if (!(statusEl instanceof HTMLElement)) return;
          statusEl.textContent = message;
          statusEl.hidden = !show;
        }

        async function savePanelFields({ keepalive = false } = {}) {
          try {
            const res = await fetch(`/api/novels/${novelId}/storyboard/${panelId}/`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                caption: captionEl instanceof HTMLInputElement ? captionEl.value : "",
                prompt: promptEl instanceof HTMLTextAreaElement ? promptEl.value : "",
              }),
              keepalive,
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.error || "Save failed");
            }
            dirtyPanels.delete(panelId);
            setPanelStatus("Saved");
            window.setTimeout(() => setPanelStatus("", false), 1600);
          } catch (err) {
            setPanelStatus(err instanceof Error ? err.message : "Save failed");
          }
        }

        function schedulePanelSave() {
          dirtyPanels.add(panelId);
          setPanelStatus("Unsaved…");
          if (panelTimers.has(panelId)) window.clearTimeout(panelTimers.get(panelId));
          panelTimers.set(
            panelId,
            window.setTimeout(() => {
              panelTimers.delete(panelId);
              void savePanelFields();
            }, 900),
          );
        }

        captionEl?.addEventListener("input", schedulePanelSave);
        promptEl?.addEventListener("input", schedulePanelSave);

        card.querySelector("[data-copy-prompt]")?.addEventListener("click", async () => {
          const text = promptEl instanceof HTMLTextAreaElement ? promptEl.value : "";
          if (!text.trim()) {
            showToast("Prompt is empty.");
            return;
          }
          try {
            await navigator.clipboard.writeText(text);
            showToast("Prompt copied.");
          } catch {
            promptEl?.select?.();
            showToast("Select the prompt and copy manually.");
          }
        });

        card.querySelectorAll("[data-move-panel]").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const move = btn.getAttribute("data-move-panel");
            if (move !== "up" && move !== "down") return;
            try {
              const res = await fetch(`/api/novels/${novelId}/storyboard/${panelId}/`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ move }),
              });
              if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                throw new Error(data.error || "Reorder failed");
              }
              if (!boardList) return;
              const sibling =
                move === "up" ? card.previousElementSibling : card.nextElementSibling;
              if (!sibling) return;
              if (move === "up") boardList.insertBefore(card, sibling);
              else boardList.insertBefore(sibling, card);
              renumberPanels();
              showToast("Panel moved.");
            } catch (err) {
              showToast(err instanceof Error ? err.message : "Reorder failed");
            }
          });
        });

        card.querySelector("[data-delete-panel]")?.addEventListener("click", async () => {
          if (!confirm("Delete this storyboard panel?")) return;
          try {
            const res = await fetch(`/api/novels/${novelId}/storyboard/${panelId}/`, {
              method: "DELETE",
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.error || "Delete failed");
            }
            card.remove();
            syncBoardChrome();
            showToast("Panel deleted.");
          } catch (err) {
            showToast(err instanceof Error ? err.message : "Delete failed");
          }
        });

        fileEl?.addEventListener("change", async () => {
          const file = fileEl instanceof HTMLInputElement ? fileEl.files?.[0] : null;
          if (!file) return;
          await uploadPanelFile(card, panelId, file, setPanelStatus);
          if (fileEl instanceof HTMLInputElement) fileEl.value = "";
        });

        if (dropzone) {
          ["dragenter", "dragover"].forEach((evt) => {
            dropzone.addEventListener(evt, (e) => {
              e.preventDefault();
              dropzone.classList.add("is-drop");
            });
          });
          ["dragleave", "drop"].forEach((evt) => {
            dropzone.addEventListener(evt, (e) => {
              e.preventDefault();
              dropzone.classList.remove("is-drop");
            });
          });
          dropzone.addEventListener("drop", async (e) => {
            const file = e.dataTransfer?.files?.[0];
            if (file) await uploadPanelFile(card, panelId, file, setPanelStatus);
          });
          dropzone.addEventListener("paste", async (e) => {
            const items = e.clipboardData?.items;
            if (!items) return;
            for (const item of items) {
              if (item.type.startsWith("image/")) {
                e.preventDefault();
                const file = item.getAsFile();
                if (file) await uploadPanelFile(card, panelId, file, setPanelStatus);
                break;
              }
            }
          });
          // Make paste work when the frame is focused via click
          dropzone.setAttribute("tabindex", "0");
        }
      }

      boardList?.querySelectorAll("[data-panel-id]").forEach((card) => bindPanelCard(card));

      boardRoot.querySelectorAll("[data-add-panel]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (btn instanceof HTMLButtonElement && btn.disabled) return;
          try {
            const res = await fetch(`/api/novels/${novelId}/storyboard/`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ draft_id: activeDraftId }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || "Could not add panel");
            const url = new URL(window.location.href);
            url.searchParams.set("mode", "board");
            window.location.href = url.toString();
          } catch (err) {
            showToast(err instanceof Error ? err.message : "Could not add panel");
          }
        });
      });

      boardRoot.querySelector("[data-copy-all-prompts]")?.addEventListener("click", async () => {
        const text = collectPrompts();
        if (!text) {
          showToast("No prompts to copy.");
          return;
        }
        try {
          await navigator.clipboard.writeText(text);
          showToast("All prompts copied.");
        } catch {
          showToast("Could not copy — try Export .txt");
        }
      });

      boardRoot.querySelector("[data-export-prompts]")?.addEventListener("click", () => {
        const text = collectPrompts();
        if (!text) {
          showToast("No prompts to export.");
          return;
        }
        const blob = new Blob([`${novelTitle} — Storyboard\n\n${text}\n`], {
          type: "text/plain;charset=utf-8",
        });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `${(novelTitle || "storyboard").replace(/\s+/g, "-").toLowerCase()}-storyboard.txt`;
        a.click();
        URL.revokeObjectURL(a.href);
        showToast("Exported prompts.");
      });

      window.addEventListener("pagehide", () => {
        for (const id of dirtyPanels) {
          const card = boardList?.querySelector(`[data-panel-id="${id}"]`);
          const captionEl = card?.querySelector("[data-panel-caption]");
          const promptEl = card?.querySelector("[data-panel-prompt]");
          void fetch(`/api/novels/${novelId}/storyboard/${id}/`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              caption: captionEl instanceof HTMLInputElement ? captionEl.value : "",
              prompt: promptEl instanceof HTMLTextAreaElement ? promptEl.value : "",
            }),
            keepalive: true,
          });
        }
      });
    }

    // Manga Studio
    const mangaRoot = document.querySelector("[data-manga]");
    if (mangaRoot) {
      const draftId = mangaRoot.getAttribute("data-draft-id") || activeDraftId;
      const dirtyManga = new Set();
      const saveTimers = new Map();

      function mangaStatus(cell, msg, isError) {
        const el = cell.querySelector("[data-manga-status]");
        if (!el) return;
        el.hidden = !msg;
        el.textContent = msg || "";
        el.classList.toggle("is-error", Boolean(isError));
      }

      async function patchMangaPanel(panelId, body) {
        const res = await fetch(`/api/novels/${novelId}/manga/panels/${panelId}/`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "Save failed");
        return data.panel;
      }

      function scheduleMangaSave(cell) {
        const panelId = cell.getAttribute("data-manga-panel-id");
        if (!panelId) return;
        dirtyManga.add(panelId);
        const prev = saveTimers.get(panelId);
        if (prev) clearTimeout(prev);
        saveTimers.set(
          panelId,
          setTimeout(async () => {
            try {
              await patchMangaPanel(panelId, {
                caption: cell.querySelector("[data-manga-caption]")?.value || "",
                dialogue: cell.querySelector("[data-manga-dialogue]")?.value || "",
                sfx: cell.querySelector("[data-manga-sfx]")?.value || "",
                notes: cell.querySelector("[data-manga-notes]")?.value || "",
                prompt: cell.querySelector("[data-manga-prompt]")?.value || "",
                source_url: cell.querySelector("[data-manga-source]")?.value || null,
              });
              dirtyManga.delete(panelId);
              mangaStatus(cell, "Saved");
              setTimeout(() => mangaStatus(cell, ""), 1200);
            } catch (err) {
              mangaStatus(cell, err instanceof Error ? err.message : "Save failed", true);
            }
          }, 500),
        );
      }

      mangaRoot.querySelectorAll("[data-manga-panel-id]").forEach((cell) => {
        ["data-manga-caption", "data-manga-dialogue", "data-manga-sfx", "data-manga-notes", "data-manga-prompt", "data-manga-source"].forEach(
          (attr) => {
            cell.querySelector(`[${attr}]`)?.addEventListener("input", () => scheduleMangaSave(cell));
          },
        );
        cell.querySelector("[data-manga-copy-one]")?.addEventListener("click", async () => {
          const prompt = cell.querySelector("[data-manga-prompt]")?.value || "";
          try {
            await navigator.clipboard.writeText(prompt);
            showToast("Prompt copied.");
          } catch {
            showToast("Could not copy prompt");
          }
        });
        const fileInput = cell.querySelector("[data-manga-image]");
        cell.querySelector(".nc-manga-cell__frame")?.addEventListener("click", () => fileInput?.click());
        fileInput?.addEventListener("change", async () => {
          const file = fileInput.files?.[0];
          const panelId = cell.getAttribute("data-manga-panel-id");
          if (!file || !panelId) return;
          const form = new FormData();
          form.append("image", file);
          mangaStatus(cell, "Uploading…");
          try {
            const res = await fetch(`/api/novels/${novelId}/manga/panels/${panelId}/`, {
              method: "PATCH",
              body: form,
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || "Upload failed");
            const url = data.panel?.image_url;
            let img = cell.querySelector("[data-manga-preview]");
            const empty = cell.querySelector("[data-manga-empty]");
            if (url) {
              if (!img) {
                img = document.createElement("img");
                img.setAttribute("data-manga-preview", "");
                img.alt = "";
                cell.querySelector(".nc-manga-cell__frame")?.prepend(img);
              }
              img.src = url;
              if (empty) empty.hidden = true;
            }
            mangaStatus(cell, "Uploaded");
          } catch (err) {
            mangaStatus(cell, err instanceof Error ? err.message : "Upload failed", true);
          }
        });
      });

      mangaRoot.querySelector("[data-manga-copy-prompts]")?.addEventListener("click", async () => {
        const prompts = [...mangaRoot.querySelectorAll("[data-manga-prompt]")]
          .map((el, i) => `Panel ${i + 1}\n${el.value}`)
          .join("\n\n");
        try {
          await navigator.clipboard.writeText(prompts);
          showToast("Page prompts copied.");
        } catch {
          showToast("Could not copy prompts");
        }
      });

      mangaRoot.querySelector("[data-manga-composite]")?.addEventListener("click", async () => {
        const pageId = mangaRoot.querySelector(".nc-manga-editor")?.getAttribute("data-manga-page-id");
        if (!pageId) return;
        try {
          showToast("Compositing…");
          const res = await fetch(`/api/novels/${novelId}/manga/pages/${pageId}/`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ composite: true }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || "Composite failed");
          showToast("Page composited.");
          window.location.reload();
        } catch (err) {
          showToast(err instanceof Error ? err.message : "Composite failed");
        }
      });

      mangaRoot.querySelector("[data-manga-reseed]")?.addEventListener("click", async () => {
        if (!draftId) return;
        if (!confirm("Reseed all manga pages from the PILOT template? Panel images in DB will be cleared.")) return;
        try {
          const res = await fetch(`/api/novels/${novelId}/manga/`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ draft_id: draftId, reseed: true }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || "Reseed failed");
          showToast("Manga pages reseeded.");
          window.location.reload();
        } catch (err) {
          showToast(err instanceof Error ? err.message : "Reseed failed");
        }
      });

      const pageNotes = mangaRoot.querySelector("[data-manga-page-notes]");
      let pageNotesTimer;
      pageNotes?.addEventListener("input", () => {
        const pageId = mangaRoot.querySelector(".nc-manga-editor")?.getAttribute("data-manga-page-id");
        if (!pageId) return;
        clearTimeout(pageNotesTimer);
        pageNotesTimer = setTimeout(async () => {
          try {
            await fetch(`/api/novels/${novelId}/manga/pages/${pageId}/`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ script_notes: pageNotes.value }),
            });
          } catch {
            /* ignore */
          }
        }, 600);
      });

      // Reader keyboard
      if (mangaRoot.getAttribute("data-view") === "read") {
        const readerPages = [...mangaRoot.querySelectorAll("[data-reader-page]")];
        let idx = 0;
        function showReader(i) {
          idx = Math.max(0, Math.min(readerPages.length - 1, i));
          readerPages.forEach((el, n) => {
            el.hidden = n !== idx;
          });
        }
        if (readerPages.length) showReader(0);
        window.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight" || e.key === "PageDown") showReader(idx + 1);
          if (e.key === "ArrowLeft" || e.key === "PageUp") showReader(idx - 1);
        });
      }
    }

    document.querySelector("[data-settings-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.target;
      const data = new FormData(form);
      const title = String(data.get("title") || "").trim();
      const author = String(data.get("author") || "").trim();
      try {
        const res = await fetch(`/api/novels/${novelId}/`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            title,
            author,
            synopsis: String(data.get("synopsis") || "").trim(),
            series_name: String(data.get("series_name") || "").trim() || null,
          }),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error || "Save failed");
        }
        const titleEl = document.querySelector(".nc-ws__novel-link strong");
        const authorEl = document.querySelector(".nc-ws__novel-link strong + span");
        if (titleEl) titleEl.textContent = title || "Untitled";
        if (authorEl) authorEl.textContent = author;
        document.title = `${title || "Untitled"} · Twilda`;
        showToast("Metadata saved.");
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Save failed");
      }
    });

    document.querySelector("[data-delete-novel]")?.addEventListener("click", async () => {
      if (!confirm("Delete this novel and all its drafts? This cannot be undone.")) return;
      try {
        const res = await fetch(`/api/novels/${novelId}/`, { method: "DELETE" });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error || "Could not delete novel");
        }
        window.location.href = "/novels/";
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Could not delete novel");
      }
    });

    document.querySelector("[data-snippet-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.target;
      const data = new FormData(form);
      const title = String(data.get("title") || "").trim();
      const content = String(data.get("content") || "").trim();
      if (!content) return;
      try {
        const res = await fetch(`/api/novels/${novelId}/snippets/`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title: title || "Untitled snippet", content }),
        });
        if (!res.ok) throw new Error("Save failed");
        showToast("Snippet saved.");
        window.setTimeout(() => window.location.reload(), 500);
      } catch (err) {
        showToast(err instanceof Error ? err.message : "Snippet failed");
      }
    });
  </script>
</NovelcrafterLayout>
