---
import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import Cover from "@/apps/novelcrafter/Cover.astro";
import {
  novels,
  getNovel,
  codexOrder,
  paragraphs,
  wordCount,
  novelWordCount,
  type CodexEntry,
} from "@/apps/novelcrafter/data";

export function getStaticPaths() {
  return novels.map((n) => ({ params: { id: n.id } }));
}

const { id } = Astro.params;
const novel = getNovel(id!)!;
const totalWords = novelWordCount(novel);
const pages = Math.max(1, Math.round(totalWords / 250));
const readMin = Math.max(1, Math.round(totalWords / 250));

const entriesByType = (t: string): CodexEntry[] =>
  novel.codex.filter((e) => e.type === t);

function avatarStyle(seed: string): string {
  let h = 0;
  for (const c of seed) h = (h * 31 + c.charCodeAt(0)) % 360;
  const h2 = (h + 45) % 360;
  return `background-image:linear-gradient(135deg, hsl(${h} 68% 56%), hsl(${h2} 62% 40%));`;
}
---

<NovelcrafterLayout title={`${novel.title} · Twilda`}>
  <div class="nc-ws">
    <!-- Header -->
    <header class="nc-ws__header">
      <a class="nc-iconbtn" href="/novels" aria-label="Back to library">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
      </a>
      <button class="nc-iconbtn" type="button" data-mode-btn="settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1l2-1.6-2-3.4-2.4 1a7 7 0 0 0-1.7-1L14.5 3h-4l-.3 2.4a7 7 0 0 0-1.7 1l-2.4-1-2 3.4 2 1.6a7 7 0 0 0 0 2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 1.7 1l.3 2.4h4l.3-2.4a7 7 0 0 0 1.7-1l2.4 1 2-3.4-2-1.6c.1-.3.1-.7.1-1z"/></svg>
      </button>
      <div class="nc-ws__novel">
        <span class="nc-ws__thumb"><Cover kind={novel.cover} title={novel.title} author={novel.author} /></span>
        <span>
          <strong>{novel.title}</strong>
          <span>{novel.author}</span>
        </span>
      </div>

      <div class="nc-modes" role="tablist">
        <button class="is-active" data-mode-btn="plan" type="button">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="15" width="7" height="5" rx="1"/><rect x="14" y="15" width="7" height="5" rx="1"/></svg>
          Plan
        </button>
        <button data-mode-btn="write" type="button">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          Write
        </button>
        <button data-mode-btn="chat" type="button">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Chat
        </button>
        <button data-mode-btn="review" type="button">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>
          Review
        </button>
      </div>

      <div class="nc-ws__toolright">
        <span>{totalWords.toLocaleString()} words</span>
      </div>
    </header>

    <div class="nc-ws__body">
      <!-- Sidebar -->
      <aside class="nc-side">
        <div class="nc-side__tabs">
          <button class="is-active" data-side-tab="codex" type="button">Codex</button>
          <button data-side-tab="snippets" type="button">Snippets</button>
          <button data-side-tab="chats" type="button">Chats</button>
        </div>

        <!-- Codex tab -->
        <div class="nc-side__pane" data-side-pane="codex" style="display:flex;flex-direction:column;flex:1;min-height:0;">
          <div class="nc-side__search">
            <input class="nc-input" type="search" placeholder="Search all entries…" data-codex-search />
            <button class="nc-btn" type="button">+ New Entry</button>
          </div>
          <div class="nc-side__scroll">
            {
              novel.codex.length === 0 ? (
                <div class="nc-side__empty">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5A2.5 2.5 0 0 1 4 20.5z"/></svg>
                  <p>Your Codex is empty.<br/>Add characters, locations and lore as you write.</p>
                </div>
              ) : (
                codexOrder.map((group) => {
                  const items = entriesByType(group.type);
                  if (items.length === 0) return null;
                  return (
                    <section class="nc-cx-group">
                      <div class="nc-cx-group__head" data-cx-toggle>
                        <h4>{group.label}</h4>
                        <span class="nc-cx-group__count">{items.length} entries</span>
                        <svg class="nc-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                      </div>
                      <div class="nc-cx-list">
                        {items.map((e) => (
                          <button class="nc-cx-item" type="button" data-entry={e.id} data-name={e.name.toLowerCase()}>
                            <span class="nc-cx-av" style={avatarStyle(e.id)}>{e.initials}</span>
                            <span class="nc-cx-body">
                              <p class="nc-cx-name">{e.name}</p>
                              <span class="nc-cx-tags">
                                {e.tags.slice(0, 4).map((t) => (<span class="nc-tag">{t}</span>))}
                              </span>
                              <p class="nc-cx-sum">{e.summary}</p>
                            </span>
                          </button>
                        ))}
                      </div>
                    </section>
                  );
                })
              )
            }
          </div>
        </div>

        <!-- Snippets tab -->
        <div class="nc-side__pane" data-side-pane="snippets" style="display:none;flex:1;">
          <div class="nc-side__empty" style="padding-top:60px;">
            <p>No snippets yet.<br/>Save reusable text fragments here.</p>
          </div>
        </div>

        <!-- Chats tab -->
        <div class="nc-side__pane" data-side-pane="chats" style="display:none;flex:1;">
          <div class="nc-side__empty" style="padding-top:60px;">
            <p>No saved chats yet.</p>
          </div>
        </div>

        <div class="nc-side__foot">
          <span class="nc-avatar-sm" style="width:24px;height:24px;font-size:11px;">K</span>
          <span class="nc-credits" style="padding:2px 8px;">3/5</span>
          <a href="/novels">Help</a>
          <a href="/novels">Export</a>
        </div>
      </aside>

      <!-- Main -->
      <div class="nc-main">
        <!-- PLAN -->
        <section class="nc-mode-panel is-active" data-mode="plan">
          <div class="nc-plan">
            {
              novel.chapters.map((ch) => {
                const cw = ch.scenes.reduce((s, sc) => s + wordCount(sc.text), 0);
                return (
                  <article class="nc-chapter">
                    <div class="nc-chapter__head">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                      <h3>{ch.title}</h3>
                      <span class="nc-chapter__meta">{ch.scenes.length} scene{ch.scenes.length === 1 ? "" : "s"} · {cw.toLocaleString()} words</span>
                    </div>
                    {ch.scenes.map((sc) => {
                      const preview = paragraphs(sc.text)[0] ?? "";
                      return (
                        <div class="nc-scene">
                          <p class="nc-scene__title">{sc.title} · {wordCount(sc.text).toLocaleString()} words</p>
                          <p class="nc-scene__preview">{preview || "Empty scene — start writing in Write mode."}</p>
                        </div>
                      );
                    })}
                  </article>
                );
              })
            }
          </div>
        </section>

        <!-- WRITE -->
        <section class="nc-mode-panel" data-mode="write">
          <div class="nc-manuscript" data-novel={novel.id}>
            {
              totalWords === 0 ? (
                <div class="nc-ms-empty">
                  <h3>{novel.title}</h3>
                  <p>Your manuscript is blank. Click below and start writing your first scene.</p>
                </div>
              ) : null
            }
            {
              novel.chapters.map((ch, ci) => (
                <>
                  <p class="nc-ms-chapter-title">{ch.title}</p>
                  {ch.scenes.map((sc, si) => (
                    <div
                      class="nc-ms-scene"
                      contenteditable="true"
                      spellcheck="false"
                      data-scene={`${ci}-${si}`}
                    >
                      {paragraphs(sc.text).length > 0
                        ? paragraphs(sc.text).map((p) => (<p>{p}</p>))
                        : (<p><br /></p>)}
                    </div>
                  ))}
                </>
              ))
            }
          </div>
        </section>

        <!-- CHAT -->
        <section class="nc-mode-panel" data-mode="chat">
          <div class="nc-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <h2>Chat with your story</h2>
            <p>Brainstorm, ask questions about your Codex, or co-write scenes with an AI assistant that knows your novel. Connect a model to begin.</p>
          </div>
        </section>

        <!-- REVIEW -->
        <section class="nc-mode-panel" data-mode="review">
          <div class="nc-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>
            <h2>Review your manuscript</h2>
            <p>Run consistency checks, get feedback, and track edits across {novel.chapters.length} chapter{novel.chapters.length === 1 ? "" : "s"} — {totalWords.toLocaleString()} words, ~{pages} pages, {readMin} min read.</p>
          </div>
        </section>

        <!-- SETTINGS -->
        <section class="nc-mode-panel" data-mode="settings">
          <div class="nc-plan">
            <article class="nc-chapter">
              <div class="nc-chapter__head"><h3>Metadata</h3></div>
              <div class="nc-scene">
                <p class="nc-scene__title">Novel Title</p>
                <div class="nc-detail__field">{novel.title}</div>
                <p class="nc-scene__title" style="margin-top:14px;">Author / Pen name</p>
                <div class="nc-detail__field">{novel.author}</div>
                <p class="nc-scene__title" style="margin-top:14px;">Synopsis</p>
                <div class="nc-detail__field">{novel.synopsis}</div>
              </div>
            </article>
          </div>
        </section>
      </div>
    </div>

    <!-- Codex detail overlays -->
    <div class="nc-detail-backdrop" data-detail-backdrop></div>
    {
      novel.codex.map((e) => (
        <div class="nc-detail" data-detail={e.id}>
          <div class="nc-detail__top">
            <span class="nc-detail__av" style={avatarStyle(e.id)}>{e.initials}</span>
            <div>
              <p class="nc-detail__title">{e.name}</p>
              <span class="nc-detail__type">{e.type}</span>
            </div>
            <button class="nc-iconbtn nc-detail__close" type="button" data-detail-close aria-label="Close">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
          <div class="nc-detail__tags">
            {e.tags.map((t) => (<span class="nc-tag">{t}</span>))}
          </div>
          <div class="nc-detail__tabs">
            <span class="is-active">Details</span>
            <span>Research</span>
            <span>Relations</span>
            <span>Mentions</span>
            <span>Tracking</span>
          </div>
          {e.aliases && e.aliases.length > 0 && (
            <>
              <p class="nc-detail__label">ALIASES / NICKNAMES</p>
              <div class="nc-detail__field">{e.aliases.join(", ")}</div>
            </>
          )}
          <p class="nc-detail__label">DESCRIPTION</p>
          <div class="nc-detail__field">{e.description}</div>
          {typeof e.mentions === "number" && (
            <p class="nc-detail__mentions">{e.mentions} mentions in the manuscript</p>
          )}
        </div>
      ))
    }
  </div>

  <script>
    // Mode tabs (Plan / Write / Chat / Review / Settings)
    const modeBtns = document.querySelectorAll<HTMLButtonElement>("[data-mode-btn]");
    const panels = document.querySelectorAll<HTMLElement>(".nc-mode-panel");
    const topModeBtns = document.querySelectorAll<HTMLButtonElement>(".nc-modes [data-mode-btn]");
    function setMode(mode: string) {
      panels.forEach((p) => p.classList.toggle("is-active", p.dataset.mode === mode));
      topModeBtns.forEach((b) => b.classList.toggle("is-active", b.dataset.modeBtn === mode));
    }
    modeBtns.forEach((b) =>
      b.addEventListener("click", () => setMode(b.dataset.modeBtn!)),
    );

    // Sidebar tabs
    const sideTabs = document.querySelectorAll<HTMLButtonElement>("[data-side-tab]");
    const sidePanes = document.querySelectorAll<HTMLElement>("[data-side-pane]");
    sideTabs.forEach((t) =>
      t.addEventListener("click", () => {
        sideTabs.forEach((x) => x.classList.toggle("is-active", x === t));
        sidePanes.forEach((p) => {
          const on = p.dataset.sidePane === t.dataset.sideTab;
          p.style.display = on ? (p.dataset.sidePane === "codex" ? "flex" : "block") : "none";
        });
      }),
    );

    // Codex group collapse
    document.querySelectorAll<HTMLElement>("[data-cx-toggle]").forEach((h) =>
      h.addEventListener("click", () =>
        h.closest(".nc-cx-group")?.classList.toggle("is-collapsed"),
      ),
    );

    // Codex search filter
    const search = document.querySelector<HTMLInputElement>("[data-codex-search]");
    search?.addEventListener("input", () => {
      const q = search.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>(".nc-cx-item").forEach((el) => {
        const match = !q || (el.dataset.name ?? "").includes(q);
        el.style.display = match ? "flex" : "none";
      });
    });

    // Codex detail overlay
    const backdrop = document.querySelector<HTMLElement>("[data-detail-backdrop]");
    const details = document.querySelectorAll<HTMLElement>("[data-detail]");
    const items = document.querySelectorAll<HTMLElement>(".nc-cx-item");
    function closeDetail() {
      backdrop?.classList.remove("is-open");
      details.forEach((d) => d.classList.remove("is-open"));
      items.forEach((i) => i.classList.remove("is-active"));
    }
    items.forEach((it) =>
      it.addEventListener("click", () => {
        const id = it.dataset.entry;
        closeDetail();
        it.classList.add("is-active");
        backdrop?.classList.add("is-open");
        document.querySelector<HTMLElement>(`[data-detail="${id}"]`)?.classList.add("is-open");
      }),
    );
    backdrop?.addEventListener("click", closeDetail);
    document.querySelectorAll<HTMLElement>("[data-detail-close]").forEach((b) =>
      b.addEventListener("click", closeDetail),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeDetail();
    });

    // Manuscript editor persistence + live word count
    const ms = document.querySelector<HTMLElement>(".nc-manuscript");
    const wordsLabel = document.querySelector<HTMLElement>(".nc-ws__toolright span");
    if (ms) {
      const novelId = ms.dataset.novel!;
      const scenes = ms.querySelectorAll<HTMLElement>(".nc-ms-scene");
      const key = (sceneId: string) => `nc:${novelId}:${sceneId}`;
      scenes.forEach((sc) => {
        const saved = localStorage.getItem(key(sc.dataset.scene!));
        if (saved !== null) sc.innerHTML = saved;
        sc.addEventListener("input", () => {
          localStorage.setItem(key(sc.dataset.scene!), sc.innerHTML);
          updateCount();
        });
      });
      function updateCount() {
        let n = 0;
        scenes.forEach((sc) => {
          const t = (sc.innerText || "").trim();
          if (t) n += t.split(/\s+/).filter(Boolean).length;
        });
        if (wordsLabel) wordsLabel.textContent = `${n.toLocaleString()} words`;
      }
      updateCount();
    }
  </script>
</NovelcrafterLayout>
