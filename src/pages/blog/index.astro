---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Component
import BlogCard from "@/components/blog/BlogCard.astro";
import BlogSearch from "@/components/blog/BlogSearch.astro";
// Sections
import Subscribe from "@/components/blog/Subscribe.astro";
// Content
import { getCollection } from "astro:content";
const allPostsUnsorted = await getCollection("posts");
// Sort the posts in descending order by publication date (newest to oldest)
const allPosts = allPostsUnsorted.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);
// Tags
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-12 lg:pt-64">
      <div class="max-w-2xl mx-auto text-center">
        <Text
          tag="h1"
          variant="displayXL"
          class="font-semibold tracking-tight text-accent-900"
        >
          Thoughts, Typed Loudly
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-accent-900 text-balance"
        >
          Unfiltered musings, unsolicited advice, and semi-coherent ramblings.
          Proceed with curiosity (or caffeine).
        </Text>
      </div>
      <div class="flex items-center justify-center mt-8 gap-2">
        <BlogSearch />
        <div
          class="relative flex overflow-x-scroll gap-2 py-2 scrollable-content snap-x snap-proximity scrollbar-hide"
        >
          {
            tags.map((tag) => (
              <Button
                isLink={true}
                size="sm"
                variant="accent"
                title={tag}
                aria-label={tag}
                href={`/blog/tags/${tag}`}
                class="capitalize "
              >
                {tag}
              </Button>
            ))
          }
        </div>
      </div>
    </Wrapper>
    <Wrapper variant="standard" class="border-t-8 border-accent-900 py-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-24"
      >
        {allPosts.map((post) => <BlogCard post={post} />)}
      </div>
    </Wrapper>
  </section>
  <Subscribe />
</BaseLayout>
