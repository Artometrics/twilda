---
export const prerender = false;

import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import NovelsTopbar from "@/components/novels/NovelsTopbar.astro";
import "@/styles/atlas.css";
import {
  atlasEntities,
  atlasLinks,
  countByKind,
  focusPins,
  getEntity,
  peerRanking,
  relatedEntities,
  timelineBounds,
  RELATION_LABELS,
} from "@/lib/atlas/data";
import type { AtlasEntity, AtlasKind } from "@/lib/atlas/types";
import { requireAuth } from "@/lib/auth/guards";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const { user, supabase } = auth;

const focusId = Astro.url.searchParams.get("e") ?? "frida-kahlo";
const focus = getEntity(focusId) ?? atlasEntities[0];
const related = relatedEntities(focus.id);
const pins = focusPins(focus.id);
const peers = peerRanking(focus.id);
const bounds = timelineBounds();
const counts = countByKind();

const { data: subscription } = await supabase
  .from("subscriptions")
  .select("ai_credits_remaining, ai_credits_monthly")
  .eq("user_id", user.id)
  .maybeSingle();

const kinds: { id: AtlasKind | "all"; label: string }[] = [
  { id: "all", label: "All" },
  { id: "person", label: "People" },
  { id: "place", label: "Places" },
  { id: "work", label: "Works" },
  { id: "idea", label: "Ideas" },
  { id: "event", label: "Events" },
];

function yearsLabel(e: AtlasEntity): string {
  if (e.startYear != null && e.endYear != null) return `${e.startYear}–${e.endYear}`;
  if (e.startYear != null) return String(e.startYear);
  return "";
}

const mapEntities = atlasEntities.filter((e) => e.coords);
const clientPayload = {
  entities: atlasEntities,
  links: atlasLinks,
  focusId: focus.id,
  bounds,
  relationLabels: RELATION_LABELS,
};
---

<NovelcrafterLayout title="Atlas · Twilda">
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    crossorigin=""
  />

  <NovelsTopbar
    active="atlas"
    userEmail={user.email}
    credits={subscription?.ai_credits_remaining ?? 5}
    creditsMax={subscription?.ai_credits_monthly ?? 5}
  />

  <div class="atlas">
    <div class="atlas-shell">
      <aside class="atlas-list">
        <div class="atlas-list__head">
          <h1>Atlas</h1>
          <p>
            A research map of people, places, works, and ideas — Pantheon depth with Google Maps
            geography. Start with Frida Kahlo.
          </p>
          <input
            class="atlas-search"
            type="search"
            placeholder="Search Frida, Casa Azul, Paris…"
            data-atlas-search
          />
          <div class="atlas-filters" data-atlas-filters>
            {
              kinds.map((k) => (
                <button type="button" data-kind={k.id} class={k.id === "all" ? "is-active" : ""}>
                  {k.label}
                  {k.id !== "all" ? ` ${counts[k.id]}` : ""}
                </button>
              ))
            }
          </div>
        </div>
        <div class="atlas-list__scroll" data-atlas-list>
          {
            atlasEntities.map((e) => (
              <button
                class:list={["atlas-item", { "is-active": e.id === focus.id }]}
                type="button"
                data-entity={e.id}
                data-kind={e.kind}
                data-name={e.name.toLowerCase()}
                data-search={`${e.name} ${e.summary} ${e.tags.join(" ")} ${(e.aliases ?? []).join(" ")}`.toLowerCase()}
              >
                <span class="atlas-item__kind">{e.kind}</span>
                <p class="atlas-item__name">{e.name}</p>
                <p class="atlas-item__sum">{e.summary}</p>
              </button>
            ))
          }
        </div>
      </aside>

      <div class="atlas-map-wrap">
        <div class="atlas-map" id="atlas-map" data-atlas-map></div>
        <div class="atlas-map-legend">
          <span><i class="atlas-dot atlas-dot--person"></i> Person focus</span>
          <span><i class="atlas-dot atlas-dot--place"></i> Place</span>
          <span><i class="atlas-dot atlas-dot--work"></i> Work / museum</span>
          <span><i class="atlas-dot atlas-dot--event"></i> Event</span>
        </div>
      </div>

      <aside class="atlas-detail" data-atlas-detail>
        <p class="atlas-detail__kind">{focus.kind}</p>
        <h2 class="atlas-detail__title">{focus.name}</h2>
        {
          yearsLabel(focus) && <p class="atlas-detail__years">{yearsLabel(focus)}</p>
        }
        <p class="atlas-detail__summary">{focus.summary}</p>
        <div class="atlas-detail__body">{focus.description}</div>
        <div>
          {focus.tags.map((t) => <span class="atlas-chip">{t}</span>)}
        </div>

        {
          peers.length > 0 && (
            <div class="atlas-detail__section">
              <h3>Ranked among {focus.peerSet}</h3>
              <div class="atlas-rank">
                {peers.map((p) => (
                  <button
                    type="button"
                    class:list={[{ "is-active": p.id === focus.id }]}
                    data-entity={p.id}
                  >
                    <span class="atlas-rank__n">{p.rank}</span>
                    <span>
                      <strong>{p.name}</strong>
                      {p.valueNote && <div class="atlas-rel__note">{p.valueNote}</div>}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )
        }

        {
          focus.provenance && focus.provenance.length > 0 && (
            <div class="atlas-detail__section">
              <h3>Provenance / path</h3>
              {focus.provenance.map((p) => {
                const place = getEntity(p.placeId);
                return (
                  <button class="atlas-rel" type="button" data-entity={p.placeId}>
                    <div class="atlas-rel__meta">{p.year}</div>
                    <div class="atlas-rel__name">{place?.name ?? p.placeId}</div>
                    <div class="atlas-rel__note">{p.note}</div>
                  </button>
                );
              })}
            </div>
          )
        }

        <div class="atlas-detail__section">
          <h3>Connected</h3>
          {
            related.length === 0 ? (
              <p class="atlas-empty">No links yet in this atlas slice.</p>
            ) : (
              related.map(({ link, entity, direction }) => (
                <button class="atlas-rel" type="button" data-entity={entity.id}>
                  <div class="atlas-rel__meta">
                    {direction === "out" ? RELATION_LABELS[link.rel] : `← ${RELATION_LABELS[link.rel]}`}
                    {link.year != null && ` · ${link.year}${link.yearEnd ? `–${link.yearEnd}` : ""}`}
                  </div>
                  <div class="atlas-rel__name">
                    {entity.name} <span class="atlas-item__kind">· {entity.kind}</span>
                  </div>
                  {link.note && <div class="atlas-rel__note">{link.note}</div>}
                </button>
              ))
            )
          }
        </div>

        <p class="atlas-hint">
          Try: open Frida → follow a painting → jump to the museum that holds it → compare rank among
          peer works. Timeline filters presence by year.
        </p>
      </aside>

      <div class="atlas-timeline">
        <div class="atlas-timeline__top">
          <strong>Timeline</strong>
          <span data-timeline-label>
            {bounds.min} – {bounds.max}
          </span>
          <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--at-dim);">
            Scrub
            <input
              type="range"
              min={bounds.min}
              max={bounds.max}
              value={focus.startYear ?? 1939}
              data-timeline-year
            />
          </label>
        </div>
        <div class="atlas-timeline__track" data-timeline-track>
          <div class="atlas-timeline__range" data-timeline-range></div>
          <div class="atlas-timeline__marks">
            {
              atlasEntities
                .filter((e) => e.startYear != null)
                .map((e) => {
                  const pct = ((e.startYear! - bounds.min) / (bounds.max - bounds.min)) * 100;
                  const color =
                    e.kind === "person"
                      ? "var(--at-pin-person)"
                      : e.kind === "work"
                        ? "var(--at-pin-work)"
                        : e.kind === "event"
                          ? "var(--at-pin-event)"
                          : "var(--at-pin-place)";
                  return (
                    <button
                      class="atlas-timeline__mark"
                      type="button"
                      title={`${e.name} (${e.startYear})`}
                      data-entity={e.id}
                      style={`left:${pct}%; background:${color};`}
                    />
                  );
                })
            }
          </div>
        </div>
        <div class="atlas-timeline__axis">
          <span>{bounds.min}</span>
          <span>{Math.round((bounds.min + bounds.max) / 2)}</span>
          <span>{bounds.max}</span>
        </div>
      </div>
    </div>
  </div>

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    crossorigin=""
  ></script>
  <script define:vars={{ clientPayload, initialPins: pins, mapEntities }}>
    const PIN_COLORS = {
      person: "#c4a574",
      place: "#7d9b8a",
      work: "#d4a090",
      event: "#8a9bb8",
      idea: "#a090b8",
    };

    function go(id) {
      const url = new URL(window.location.href);
      url.searchParams.set("e", id);
      window.location.href = url.toString();
    }

    document.querySelectorAll("[data-entity]").forEach((el) => {
      el.addEventListener("click", () => {
        const id = el.getAttribute("data-entity");
        if (id) go(id);
      });
    });

    const search = document.querySelector("[data-atlas-search]");
    const items = [...document.querySelectorAll(".atlas-item")];
    let kindFilter = "all";

    function applyFilters() {
      const q = (search?.value || "").trim().toLowerCase();
      items.forEach((item) => {
        const kindOk = kindFilter === "all" || item.getAttribute("data-kind") === kindFilter;
        const text = item.getAttribute("data-search") || "";
        const qOk = !q || text.includes(q);
        item.style.display = kindOk && qOk ? "block" : "none";
      });
    }

    search?.addEventListener("input", applyFilters);
    document.querySelectorAll("[data-atlas-filters] [data-kind]").forEach((btn) => {
      btn.addEventListener("click", () => {
        kindFilter = btn.getAttribute("data-kind") || "all";
        document.querySelectorAll("[data-atlas-filters] [data-kind]").forEach((b) => {
          b.classList.toggle("is-active", b === btn);
        });
        applyFilters();
      });
    });

    // Timeline scrub — dim list items outside ±15y of scrub year
    const yearInput = document.querySelector("[data-timeline-year]");
    const yearLabel = document.querySelector("[data-timeline-label]");
    const rangeEl = document.querySelector("[data-timeline-range]");
    const { min, max } = clientPayload.bounds;

    function updateTimelineUI(year) {
      const y = Number(year);
      if (yearLabel) yearLabel.textContent = `Focus year ${y} (±15)`;
      if (rangeEl) {
        const left = ((y - 15 - min) / (max - min)) * 100;
        const width = (30 / (max - min)) * 100;
        rangeEl.style.left = `${Math.max(0, left)}%`;
        rangeEl.style.width = `${Math.min(100 - Math.max(0, left), width)}%`;
      }
      items.forEach((item) => {
        const id = item.getAttribute("data-entity");
        const ent = clientPayload.entities.find((e) => e.id === id);
        if (!ent) return;
        if (ent.kind === "place" || ent.kind === "idea") {
          item.style.opacity = "1";
          return;
        }
        const start = ent.startYear ?? ent.endYear;
        const end = ent.endYear ?? ent.startYear;
        if (start == null) {
          item.style.opacity = "1";
          return;
        }
        const inRange = start <= y + 15 && (end ?? start) >= y - 15;
        item.style.opacity = inRange ? "1" : "0.35";
      });
    }

    yearInput?.addEventListener("input", () => updateTimelineUI(yearInput.value));
    if (yearInput) updateTimelineUI(yearInput.value);

    // Leaflet map
    function bootMap() {
      if (!window.L) {
        window.setTimeout(bootMap, 50);
        return;
      }
      const el = document.getElementById("atlas-map");
      if (!el || el._atlasBooted) return;
      el._atlasBooted = true;

      const map = window.L.map(el, {
        zoomControl: true,
        attributionControl: true,
      }).setView([20, -40], 2);

      window.L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        subdomains: "abcd",
        maxZoom: 18,
      }).addTo(map);

      const focusIds = new Set(initialPins.map((p) => p.entity.id));

      const markers = [];
      mapEntities.forEach((ent) => {
        if (!ent.coords) return;
        const isFocus = focusIds.has(ent.id) || ent.id === clientPayload.focusId;
        const color = PIN_COLORS[ent.kind] || "#7d9b8a";
        const icon = window.L.divIcon({
          className: "atlas-leaflet-pin",
          html: `<div class="atlas-marker${isFocus ? " is-focus" : ""}" style="background:${color}"></div>`,
          iconSize: [18, 18],
          iconAnchor: [9, 9],
        });
        const m = window.L.marker([ent.coords.lat, ent.coords.lng], { icon })
          .addTo(map)
          .bindTooltip(ent.name);
        m.on("click", () => go(ent.id));
        markers.push({ m, ent, isFocus });
      });

      const focusLatLngs = markers.filter((x) => x.isFocus).map((x) => x.m.getLatLng());
      if (focusLatLngs.length > 1) {
        map.fitBounds(window.L.latLngBounds(focusLatLngs).pad(0.35));
      } else if (focusLatLngs.length === 1) {
        map.setView(focusLatLngs[0], 5);
      }
    }

    bootMap();
  </script>
</NovelcrafterLayout>
