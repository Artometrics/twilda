---
export const prerender = false;

import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import NovelsTopbar from "@/components/novels/NovelsTopbar.astro";
import "@/styles/atlas.css";
import { atlasScenes, getEntity, getScene } from "@/lib/atlas/data";
import {
  focusCardPayload,
  serializeCallouts,
  serializeFocusPins,
} from "@/lib/atlas/focus-payload";
import { timelineBounds } from "@/lib/atlas/data";
import { requireAuth } from "@/lib/auth/guards";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const { user, supabase } = auth;

const sceneParam = Astro.url.searchParams.get("scene") ?? "vienna-1913";
const scene = getScene(sceneParam) ?? atlasScenes[0];
const focusId = Astro.url.searchParams.get("e") ?? scene.focusId;
const focus = getEntity(focusId) ?? getEntity(scene.focusId)!;
const bounds = timelineBounds();
const card = focusCardPayload(focus.id);
const callouts = serializeCallouts(scene.id);
const pins = serializeFocusPins(focus.id);
/** Deep-link / museum Open in Atlas: prefer focus pins over scene callouts. */
const useFocusPins =
  Boolean(Astro.url.searchParams.get("e")) &&
  !scene.calloutIds.includes(focus.id);
const initialYear =
  useFocusPins && (focus.startYear ?? focus.endYear) != null
    ? Number(focus.startYear ?? focus.endYear)
    : scene.year;

// Credits are non-critical for Atlas — don't block first paint on a slow DB hop.
const creditsPromise = supabase
  .from("subscriptions")
  .select("ai_credits_remaining, ai_credits_monthly")
  .eq("user_id", user.id)
  .maybeSingle()
  .then((r) => r.data)
  .catch(() => null);

const subscription = await Promise.race([
  creditsPromise,
  new Promise<null>((resolve) => setTimeout(() => resolve(null), 120)),
]);

// search + timeline load lazily via /api/atlas/search-index after map shell paints
const clientPayload = {
  sceneId: scene.id,
  focusId: focus.id,
  bounds,
  callouts,
  pins,
  pinMode: useFocusPins ? "focus" : "scene",
  center: scene.center,
  zoom: scene.zoom,
  badge: scene.badge,
  year: scene.year,
  scrubYear: initialYear,
  search: [],
  timeline: [],
  indexReady: false,
  card,
};
---

<NovelcrafterLayout title="Atlas · Twilda">
  <!-- MapLibre CSS is imported from the client script below -->

  <!-- SVG liquid-glass displacement filter (Chromium bonus) -->
  <svg width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden;">
    <filter id="liquid-glass" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="4" result="noise"/>
      <feGaussianBlur in="noise" stdDeviation="2" result="blurred"/>
      <feDisplacementMap in="SourceGraphic" in2="blurred" scale="50" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>

  <NovelsTopbar
    active="atlas"
    userEmail={user.email}
    credits={subscription?.ai_credits_remaining ?? 5}
    creditsMax={subscription?.ai_credits_monthly ?? 5}
  />

  <div class="atlas">
    <div class="atlas-stage">
      <div class="atlas-map" id="atlas-map"></div>
      <div class="atlas-map-veil" aria-hidden="true"></div>

      <!-- Left HUD: scenes + filters stacked so wraps don't collide -->
      <div class="atlas-hud atlas-hud-left">
        <div class="atlas-scenes">
          {
            atlasScenes.map((s) => (
              <button
                type="button"
                class:list={["atlas-scene-btn", { "is-active": s.id === scene.id }]}
                data-scene={s.id}
              >
                {s.badge}
              </button>
            ))
          }
        </div>

        <div class="atlas-kind-filters" role="group" aria-label="Filter by kind">
          {
            [
              ["all", "All"],
              ["person", "People"],
              ["place", "Places"],
              ["work", "Artifacts"],
              ["idea", "Ideas"],
              ["event", "Events"],
              ["deity", "Gods"],
              ["dynasty", "Dynasties"],
              ["concept", "Concepts"],
            ].map(([id, label]) => (
              <button type="button" class:list={["atlas-kind-btn", { "is-active": id === "all" }]} data-kind-filter={id}>
                {label}
              </button>
            ))
          }
        </div>

        <div class="atlas-empty-pins" data-atlas-empty hidden>
          No pins match the current kind / timeline filters.
        </div>
      </div>

      <!-- Search — results rendered client-side from compact index -->
      <div class="atlas-hud atlas-search-float">
        <label class="sr-only" for="atlas-search-input">Search Atlas</label>
        <input
          id="atlas-search-input"
          type="search"
          placeholder="Search people, places, artifacts…"
          data-atlas-search
          aria-label="Search people, places, artifacts"
        />
        <div class="atlas-results" data-atlas-results></div>
      </div>

      <!-- Live Discover — Met OA / Wikidata enrich (collapsible) -->
      <div class="atlas-hud atlas-discover glass" data-atlas-discover>
        <div class="atlas-discover__head">
          <strong>Discover</strong>
          <button
            type="button"
            class="atlas-discover__toggle"
            data-discover-toggle
            aria-expanded="true"
            aria-controls="atlas-discover-body"
            title="Collapse Discover"
          >
            −
          </button>
        </div>
        <div class="atlas-discover__body" id="atlas-discover-body">
          <div class="atlas-discover__tabs" role="tablist" aria-label="Discover source">
            <button type="button" class="atlas-discover__tab is-active" data-discover-tab="met" role="tab" aria-selected="true">Met</button>
            <button type="button" class="atlas-discover__tab" data-discover-tab="wikidata" role="tab" aria-selected="false">Wikidata</button>
          </div>
          <label class="sr-only" for="atlas-discover-input">Discover open data</label>
          <input
            id="atlas-discover-input"
            type="search"
            placeholder="Search Met / Wikidata…"
            data-discover-q
            aria-label="Discover open data"
          />
          <p class="atlas-discover__status" data-discover-status hidden></p>
          <div class="atlas-discover__results" data-discover-results></div>
        </div>
      </div>

      <!-- Period badge -->
      <div class="atlas-badge" data-atlas-badge>{scene.badge}</div>

      <!-- Detail card (updated via soft-nav without remounting the map) -->
      <aside class="atlas-card glass" data-atlas-card>
        <div class="atlas-card__chrome">
          <div class="atlas-card__chrome-main">
            <p class="atlas-card__kind">{card.focus.kind}</p>
            <h1 class="atlas-card__title">{card.focus.name}</h1>
          </div>
          <button
            type="button"
            class="atlas-card__toggle"
            data-card-toggle
            aria-expanded="true"
            aria-controls="atlas-card-body"
            title="Collapse card"
          >
            −
          </button>
        </div>
        <div class="atlas-card__body" id="atlas-card-body" data-atlas-card-panel>
        {card.focus.years && <p class="atlas-card__years">{card.focus.years}</p>}
        <p class="atlas-card__summary">{card.focus.summary}</p>
        <div data-atlas-extra>
          {
            card.focus.description && (
              <details class="atlas-card__details">
                <summary>Description</summary>
                <p>{card.focus.description}</p>
              </details>
            )
          }
          {
            card.focus.imageCredit && (
              <details class="atlas-card__details">
                <summary>Image credit</summary>
                <p>{card.focus.imageCredit}</p>
              </details>
            )
          }
          {
            card.focus.wikidataId && (
              <details class="atlas-card__details">
                <summary>Wikidata</summary>
                <p>
                  <a
                    href={`https://www.wikidata.org/wiki/${card.focus.wikidataId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {card.focus.wikidataId}
                  </a>
                </p>
              </details>
            )
          }
        </div>
        <div data-atlas-tags>{card.focus.tags.map((t) => <span class="atlas-chip">{t}</span>)}</div>
        <div class="atlas-card__actions" data-atlas-actions>
          <button class="atlas-btn" type="button" data-save-museum data-save-label>Save to My Museum</button>
          {card.focus.sourceUrl && (
            <a class="atlas-btn" href={card.focus.sourceUrl} target="_blank" rel="noopener noreferrer">Open source</a>
          )}
          <a class="atlas-btn" href="/account/#museum-heading">My Museum</a>
        </div>
        <p class="atlas-card__status" data-atlas-status hidden></p>
        <p class="atlas-card__sources" data-atlas-sources>
          {[
            card.focus.license && `License: ${card.focus.license}`,
            card.focus.attribution && `Credit: ${card.focus.attribution}`,
            card.focus.wikidataId && `Wikidata ${card.focus.wikidataId}`,
            card.focus.metObjectId && `Met ${card.focus.metObjectId}`,
          ]
            .filter(Boolean)
            .join(" · ") || "Curated Twilda seed"}
        </p>
        <div data-atlas-card-body>
          {
            card.peers.length > 0 && (
              <div class="atlas-card__section">
                <h3>Ranked among peers</h3>
                {card.peers.map((p) => (
                  <button class="atlas-rel" type="button" data-entity={p.id}>
                    <div class="atlas-rel__meta">#{p.rank}</div>
                    <div class="atlas-rel__name">{p.name}</div>
                  </button>
                ))}
              </div>
            )
          }
          {
            card.focus.provenance.length > 0 && (
              <div class="atlas-card__section">
                <h3>Provenance</h3>
                {card.focus.provenance.map((p) => (
                  <button class="atlas-rel" type="button" data-entity={p.placeId}>
                    <div class="atlas-rel__meta">{p.year}</div>
                    <div class="atlas-rel__name">{p.placeName}</div>
                    <div class="atlas-rel__meta">{p.note}</div>
                  </button>
                ))}
              </div>
            )
          }
          <div class="atlas-card__section">
            <h3>Connected · who / what was near</h3>
            {
              card.related.map((r) => (
                <button class="atlas-rel" type="button" data-entity={r.id}>
                  <div class="atlas-rel__meta">{r.meta}</div>
                  <div class="atlas-rel__name">{r.name} <span style="opacity:0.5;font-weight:400">· {r.kind}</span></div>
                  {r.note && <div class="atlas-rel__meta">{r.note}</div>}
                </button>
              ))
            }
          </div>
        </div>
        <p class="atlas-hint" data-atlas-hint>{card.hint}</p>
        </div>
      </aside>

      <!-- Timeline dock — marks filled client-side from compact index -->
      <div class="atlas-dock">
        <div class="atlas-dock__inner glass">
          <div class="atlas-dock__top">
            <strong>Timeline</strong>
            <span data-timeline-label>Focus {scene.year < 0 ? Math.abs(scene.year) + " BCE" : scene.year + " CE"}</span>
            <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--at-dim);">
              Scrub
              <input type="range" min={bounds.min} max={bounds.max} value={initialYear} data-timeline-year />
            </label>
          </div>
          <div class="atlas-dock__track" data-timeline-track>
            <div class="atlas-dock__range" data-timeline-range></div>
          </div>
          <div class="atlas-dock__axis">
            <span>{bounds.min < 0 ? Math.abs(bounds.min) + " BCE" : bounds.min}</span>
            <span>0</span>
            <span>{bounds.max} CE</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="nc-toast" data-atlas-toast hidden></div>

  <script type="application/json" id="atlas-boot-data" is:inline set:html={JSON.stringify(clientPayload)} />
  <script>
    import maplibregl from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";
    import { darkBasemapStyle } from "@/lib/atlas/basemap";

    const raw = document.getElementById("atlas-boot-data")?.textContent ?? "{}";
    /** @type {any} */
    let state = JSON.parse(raw);

    /** @type {maplibregl.Map | null} */
    let map = null;
    /** @type {maplibregl.Marker[]} */
    let markers = [];
    let navBusy = false;
    /** @type {Set<string>} */
    const savedMuseumIds = new Set();

    function esc(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function showToast(message) {
      const toast = document.querySelector("[data-atlas-toast]");
      if (!toast) return;
      toast.textContent = message;
      toast.hidden = false;
      toast.classList.add("is-visible");
      window.clearTimeout(showToast._t);
      showToast._t = window.setTimeout(() => {
        toast.classList.remove("is-visible");
        window.setTimeout(() => {
          toast.hidden = true;
        }, 200);
      }, 2400);
    }

    function setCardStatus(message) {
      const el = document.querySelector("[data-atlas-status]");
      if (!el) return;
      if (!message) {
        el.hidden = true;
        el.textContent = "";
        return;
      }
      el.hidden = false;
      el.textContent = message;
    }

    function saveButtonLabel(focus) {
      const id = focus?.id;
      if (id && savedMuseumIds.has(id)) return "Saved ✓";
      const kind = String(focus?.kind || "").toLowerCase();
      if (kind === "work" || kind === "artifact") return "Save artifact";
      return "Save to My Museum";
    }

    function syncSaveButton() {
      const btn = document.querySelector("[data-save-museum]");
      if (!btn) return;
      const f = state.card?.focus;
      btn.textContent = saveButtonLabel(f);
      btn.disabled = Boolean(f?.id && savedMuseumIds.has(f.id));
    }

    async function loadMuseumIds() {
      try {
        const res = await fetch("/api/account/museum");
        if (!res.ok) return;
        const rows = await res.json();
        if (!Array.isArray(rows)) return;
        savedMuseumIds.clear();
        for (const row of rows) {
          if (row?.seed_entity_id) savedMuseumIds.add(String(row.seed_entity_id));
        }
        syncSaveButton();
      } catch {
        /* museum table may be missing */
      }
    }

    function yearStr(y) {
      return y < 0 ? `${Math.abs(y)} BCE` : `${y} CE`;
    }

    function setUrl({ scene, e }) {
      const url = new URL(window.location.href);
      if (scene) url.searchParams.set("scene", scene);
      if (e) url.searchParams.set("e", e);
      history.pushState({ scene: url.searchParams.get("scene"), e: url.searchParams.get("e") }, "", url);
    }

    function renderCard(card) {
      const root = document.querySelector("[data-atlas-card]");
      if (!root || !card) return;
      const kind = root.querySelector(".atlas-card__kind");
      const title = root.querySelector(".atlas-card__title");
      const years = root.querySelector(".atlas-card__years");
      const summary = root.querySelector(".atlas-card__summary");
      const extra = root.querySelector("[data-atlas-extra]");
      const tags = root.querySelector("[data-atlas-tags]");
      const body = root.querySelector("[data-atlas-card-body]");
      const hint = root.querySelector("[data-atlas-hint]");
      const sources = root.querySelector("[data-atlas-sources]");
      const actions = root.querySelector("[data-atlas-actions]");

      if (kind) kind.textContent = card.focus.kind;
      if (title) title.textContent = card.focus.name;
      if (summary) summary.textContent = card.focus.summary;
      if (hint) hint.textContent = card.hint;

      if (years) {
        if (card.focus.years) {
          years.hidden = false;
          years.textContent = card.focus.years;
        } else {
          years.hidden = true;
          years.textContent = "";
        }
      }

      if (extra) {
        let extraHtml = "";
        if (card.focus.description) {
          extraHtml += `<details class="atlas-card__details"><summary>Description</summary><p>${esc(card.focus.description)}</p></details>`;
        }
        if (card.focus.imageCredit) {
          extraHtml += `<details class="atlas-card__details"><summary>Image credit</summary><p>${esc(card.focus.imageCredit)}</p></details>`;
        }
        if (card.focus.wikidataId) {
          const q = esc(card.focus.wikidataId);
          extraHtml += `<details class="atlas-card__details"><summary>Wikidata</summary><p><a href="https://www.wikidata.org/wiki/${q}" target="_blank" rel="noopener noreferrer">${q}</a></p></details>`;
        }
        extra.innerHTML = extraHtml;
      }

      if (tags) {
        tags.innerHTML = card.focus.tags.map((t) => `<span class="atlas-chip">${esc(t)}</span>`).join("");
      }

      if (sources) {
        const bits = [
          card.focus.license && `License: ${card.focus.license}`,
          card.focus.attribution && `Credit: ${card.focus.attribution}`,
          card.focus.wikidataId && `Wikidata ${card.focus.wikidataId}`,
          card.focus.metObjectId && `Met ${card.focus.metObjectId}`,
        ].filter(Boolean);
        sources.textContent = bits.join(" · ") || "Curated Twilda seed";
      }

      if (actions) {
        const open = card.focus.sourceUrl
          ? `<a class="atlas-btn" href="${esc(card.focus.sourceUrl)}" target="_blank" rel="noopener noreferrer">Open source</a>`
          : "";
        actions.innerHTML = `<button class="atlas-btn" type="button" data-save-museum data-save-label>${esc(saveButtonLabel(card.focus))}</button>${open}<a class="atlas-btn" href="/account/#museum-heading">My Museum</a>`;
        syncSaveButton();
      }

      if (body) {
        let html = "";
        if (card.peers?.length) {
          html += `<div class="atlas-card__section"><h3>Ranked among peers</h3>`;
          for (const p of card.peers) {
            html += `<button class="atlas-rel" type="button" data-entity="${esc(p.id)}"><div class="atlas-rel__meta">#${esc(p.rank)}</div><div class="atlas-rel__name">${esc(p.name)}</div></button>`;
          }
          html += `</div>`;
        }
        if (card.focus.provenance?.length) {
          html += `<div class="atlas-card__section"><h3>Provenance</h3>`;
          for (const p of card.focus.provenance) {
            html += `<button class="atlas-rel" type="button" data-entity="${esc(p.placeId)}"><div class="atlas-rel__meta">${esc(p.year)}</div><div class="atlas-rel__name">${esc(p.placeName)}</div><div class="atlas-rel__meta">${esc(p.note)}</div></button>`;
          }
          html += `</div>`;
        }
        html += `<div class="atlas-card__section"><h3>Connected · who / what was near</h3>`;
        for (const r of card.related || []) {
          html += `<button class="atlas-rel" type="button" data-entity="${esc(r.id)}"><div class="atlas-rel__meta">${esc(r.meta)}</div><div class="atlas-rel__name">${esc(r.name)} <span style="opacity:0.5;font-weight:400">· ${esc(r.kind)}</span></div>${r.note ? `<div class="atlas-rel__meta">${esc(r.note)}</div>` : ""}</button>`;
        }
        html += `</div>`;
        body.innerHTML = html;
      }
    }

    let kindFilter = "all";
    /** @type {number} */
    let scrubYear = Number(state.scrubYear ?? state.year);
    const YEAR_WINDOW = 15;

    function inYearWindow(e, year) {
      const lo = year - YEAR_WINDOW;
      const hi = year + YEAR_WINDOW;
      const start = e.startYear ?? e.endYear;
      const end = e.endYear ?? e.startYear;
      if (start == null && end == null) return true;
      const s = Number(start);
      const en = Number(end ?? start);
      return s <= hi && en >= lo;
    }

    function activePinList() {
      return state.pinMode === "focus" && Array.isArray(state.pins) && state.pins.length
        ? state.pins
        : state.callouts || [];
    }

    function applyKindFilter() {
      document.querySelectorAll("[data-kind-filter]").forEach((btn) => {
        btn.classList.toggle("is-active", btn.getAttribute("data-kind-filter") === kindFilter);
      });
      paintCallouts(activePinList(), state.focusId, { fit: false });
      paintTimelineMarks();
    }

    async function saveToMuseum(payload) {
      const f = payload || state.card?.focus;
      if (!f?.id) return;
      try {
        setCardStatus("Saving…");
        const res = await fetch("/api/account/museum", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            seedEntityId: f.id,
            title: f.name,
            kind: f.kind,
            summary: f.summary,
            portraitUrl: f.portraitUrl,
            sourceUrl: f.sourceUrl,
            license: f.license,
            attribution: f.attribution,
          }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || "Save failed");
        savedMuseumIds.add(String(f.id));
        syncSaveButton();
        setCardStatus("Saved to My Museum");
        showToast("Saved to My Museum");
      } catch (err) {
        const msg = err instanceof Error ? err.message : "Save failed";
        setCardStatus(msg);
        showToast(msg);
      }
    }

    /** Preview enrich / Met hit on the detail card without a curated seed id. */
    function previewDiscoverCard(focusPartial) {
      const card = {
        focus: {
          id: focusPartial.id || null,
          kind: focusPartial.kind || "work",
          name: focusPartial.name || "Untitled",
          summary: focusPartial.summary || "",
          description: focusPartial.description || null,
          years: focusPartial.years || "",
          tags: focusPartial.tags || [],
          portraitUrl: focusPartial.portraitUrl || null,
          sourceUrl: focusPartial.sourceUrl || null,
          license: focusPartial.license || null,
          attribution: focusPartial.attribution || null,
          imageCredit: focusPartial.imageCredit || null,
          wikidataId: focusPartial.wikidataId || null,
          metObjectId: focusPartial.metObjectId || null,
          provenance: [],
        },
        peers: [],
        related: [],
        hint: focusPartial.hint || "Live Discover preview — not a curated Atlas seed.",
      };
      state.focusId = card.focus.id;
      state.card = card;
      renderCard(card);
      setCardStatus("Preview from Discover");
    }

    function calloutHtml(c, isFocus) {
      const label = c.calloutLabel || c.name;
      const focusClass = isFocus ? " is-focus" : "";
      const noPhoto = ["place", "concept", "dynasty", "idea"].includes(c.kind);
      if (noPhoto || !c.portraitUrl) {
        const cls = `atlas-callout atlas-callout--${c.kind}${focusClass}`;
        if (noPhoto) {
          return `<div class="${cls}" data-id="${c.id}">
            <div class="atlas-callout__label">${esc(label)}</div>
            <div class="atlas-callout__tail"></div>
          </div>`;
        }
        return `<div class="atlas-callout${focusClass}" data-id="${c.id}">
          <div class="atlas-callout__photo"><div class="atlas-callout__fallback">${esc(label.charAt(0))}</div></div>
          <div class="atlas-callout__label">${esc(label)}</div>
          <div class="atlas-callout__tail"></div>
        </div>`;
      }
      return `<div class="atlas-callout${focusClass}" data-id="${c.id}">
        <div class="atlas-callout__photo">
          <img src="${esc(c.portraitUrl)}" alt="" loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling?.removeAttribute('hidden');" />
          <div class="atlas-callout__fallback" hidden>${esc(label.charAt(0))}</div>
        </div>
        <div class="atlas-callout__label">${esc(label)}</div>
        <div class="atlas-callout__tail"></div>
      </div>`;
    }

    function clearMarkers() {
      markers.forEach((m) => m.remove());
      markers = [];
    }

    function paintCallouts(callouts, focusId, { fit = true, flyToFocus = false } = {}) {
      if (!map) return;
      clearMarkers();
      const boundsArr = [];
      /** @type {{ lng: number, lat: number } | null} */
      let focusCoords = null;
      for (const c of callouts) {
        if (!c.coords) continue;
        if (kindFilter !== "all" && c.kind !== kindFilter) continue;
        if (!inYearWindow(c, scrubYear)) continue;
        const isFocus = c.id === focusId;
        if (isFocus) focusCoords = c.coords;
        const wrap = document.createElement("div");
        wrap.innerHTML = calloutHtml(c, isFocus);
        const inner = wrap.firstElementChild;
        inner?.addEventListener("click", () => selectEntity(c.id));
        const marker = new maplibregl.Marker({ element: inner, anchor: "bottom" })
          .setLngLat([c.coords.lng, c.coords.lat])
          .addTo(map);
        markers.push(marker);
        boundsArr.push([c.coords.lng, c.coords.lat]);
      }
      const emptyEl = document.querySelector("[data-atlas-empty]");
      if (emptyEl) emptyEl.hidden = markers.length > 0;

      if (flyToFocus && focusCoords) {
        map.flyTo({ center: [focusCoords.lng, focusCoords.lat], zoom: Math.max(map.getZoom(), 6), essential: true });
      } else if (fit && boundsArr.length > 1) {
        const b = boundsArr.reduce(
          (acc, p) => [[Math.min(acc[0][0], p[0]), Math.min(acc[0][1], p[1])], [Math.max(acc[1][0], p[0]), Math.max(acc[1][1], p[1])]],
          [[180, 90], [-180, -90]],
        );
        map.fitBounds(b, { padding: 90, maxZoom: 14 });
      } else if (fit && boundsArr.length === 1) {
        map.flyTo({ center: boundsArr[0], zoom: Math.max(map.getZoom(), 6), essential: true });
      }
    }

    function setActiveSceneButton(sceneId) {
      document.querySelectorAll("[data-scene]").forEach((btn) => {
        btn.classList.toggle("is-active", btn.getAttribute("data-scene") === sceneId);
      });
    }

    async function selectEntity(id) {
      if (!id || navBusy) return;
      navBusy = true;
      try {
        setUrl({ scene: state.sceneId, e: id });
        const res = await fetch(`/api/atlas/state?mode=focus&e=${encodeURIComponent(id)}`);
        if (!res.ok) throw new Error("focus failed");
        const data = await res.json();
        state.focusId = id;
        state.card = data.card;
        state.pins = data.pins || [];
        state.pinMode = "focus";
        const focusPin = (state.pins || []).find((p) => p.id === id) || (state.search || []).find((p) => p.id === id);
        const focusYear = focusPin?.startYear ?? focusPin?.endYear;
        if (focusYear != null) {
          scrubYear = Number(focusYear);
          const yearInputEl = document.querySelector("[data-timeline-year]");
          if (yearInputEl) yearInputEl.value = String(scrubYear);
          updateTimeline(scrubYear, { repaint: false });
        }
        renderCard(data.card);
        paintCallouts(state.pins, id, { fit: false, flyToFocus: true });
        paintTimelineMarks();
      } catch (err) {
        console.warn("[atlas]", err);
        window.location.search = `?scene=${encodeURIComponent(state.sceneId)}&e=${encodeURIComponent(id)}`;
      } finally {
        navBusy = false;
      }
    }

    async function selectScene(sceneId) {
      if (!sceneId || navBusy) return;
      navBusy = true;
      try {
        const keepE = new URL(window.location.href).searchParams.get("e");
        const qs = new URLSearchParams({ mode: "scene", scene: sceneId });
        if (keepE) qs.set("e", keepE);
        const res = await fetch(`/api/atlas/state?${qs}`);
        if (!res.ok) throw new Error("scene failed");
        const data = await res.json();
        state.sceneId = data.scene.id;
        state.focusId = data.card.focus.id;
        state.callouts = data.callouts;
        state.pins = data.pins || [];
        state.pinMode = "scene";
        state.center = data.scene.center;
        state.zoom = data.scene.zoom;
        state.badge = data.scene.badge;
        state.year = data.scene.year;
        state.card = data.card;
        scrubYear = Number(data.scene.year);
        setUrl({ scene: data.scene.id, e: data.card.focus.id });
        setActiveSceneButton(data.scene.id);
        const badge = document.querySelector("[data-atlas-badge]");
        if (badge) badge.textContent = data.scene.badge;
        const yearInput = document.querySelector("[data-timeline-year]");
        if (yearInput) {
          yearInput.value = String(data.scene.year);
          updateTimeline(data.scene.year);
        }
        renderCard(data.card);
        if (map) {
          map.jumpTo({ center: [data.scene.center.lng, data.scene.center.lat], zoom: data.scene.zoom });
          paintCallouts(data.callouts, data.card.focus.id, { fit: true });
        }
      } catch (err) {
        console.warn("[atlas]", err);
        window.location.search = `?scene=${encodeURIComponent(sceneId)}`;
      } finally {
        navBusy = false;
      }
    }

    // Delegated clicks (card / timeline / search results / discover)
    document.querySelector(".atlas")?.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      if (t.closest("[data-save-museum]")) {
        e.preventDefault();
        saveToMuseum();
        return;
      }
      const discoverTabBtn = t.closest("[data-discover-tab]");
      if (discoverTabBtn) {
        e.preventDefault();
        setDiscoverTab(discoverTabBtn.getAttribute("data-discover-tab") || "met");
        return;
      }
      const previewBtn = t.closest("[data-discover-preview]");
      if (previewBtn) {
        e.preventDefault();
        previewFromDiscoverButton(previewBtn);
        return;
      }
      const saveMetBtn = t.closest("[data-discover-save-met]");
      if (saveMetBtn) {
        e.preventDefault();
        saveMetFromDiscover(saveMetBtn);
        return;
      }
      const kindBtn = t.closest("[data-kind-filter]");
      if (kindBtn) {
        e.preventDefault();
        kindFilter = kindBtn.getAttribute("data-kind-filter") || "all";
        applyKindFilter();
        return;
      }
      const sceneBtn = t.closest("[data-scene]");
      if (sceneBtn) {
        e.preventDefault();
        selectScene(sceneBtn.getAttribute("data-scene"));
        return;
      }
      const ent = t.closest("[data-entity]");
      if (ent) {
        e.preventDefault();
        selectEntity(ent.getAttribute("data-entity"));
      }
    });

    // Search from compact index
    const search = document.querySelector("[data-atlas-search]");
    const results = document.querySelector("[data-atlas-results]");

    function filterResults() {
      const q = (search?.value || "").trim().toLowerCase();
      if (!results) return;
      if (!q) {
        results.classList.remove("is-open");
        results.innerHTML = "";
        return;
      }
      if (!state.indexReady) {
        results.innerHTML = `<div class="atlas-results__item" style="opacity:.7">Loading catalog…</div>`;
        results.classList.add("is-open");
        return;
      }
      const hits = (state.search || []).filter((e) => e.haystack.includes(q)).slice(0, 40);
      results.innerHTML = hits
        .map(
          (e) =>
            `<button type="button" data-entity="${esc(e.id)}"><span class="atlas-results__kind">${esc(e.kind)}</span>${esc(e.name)}</button>`,
        )
        .join("");
      results.classList.add("is-open");
    }

    search?.addEventListener("input", filterResults);
    search?.addEventListener("focus", filterResults);
    document.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      if (!t.closest("[data-atlas-search]") && !t.closest("[data-atlas-results]")) {
        results?.classList.remove("is-open");
      }
    });

    // Discover panel (Met / Wikidata live APIs)
    const discoverRoot = document.querySelector("[data-atlas-discover]");
    const discoverToggle = document.querySelector("[data-discover-toggle]");
    discoverToggle?.addEventListener("click", () => {
      if (!discoverRoot || !discoverToggle) return;
      const collapsed = discoverRoot.classList.toggle("is-collapsed");
      discoverToggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
      discoverToggle.textContent = collapsed ? "+" : "−";
      discoverToggle.title = collapsed ? "Expand Discover" : "Collapse Discover";
    });

    const cardRootEl = document.querySelector("[data-atlas-card]");
    const cardToggle = document.querySelector("[data-card-toggle]");
    cardToggle?.addEventListener("click", () => {
      if (!cardRootEl || !cardToggle) return;
      const collapsed = cardRootEl.classList.toggle("is-collapsed");
      cardToggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
      cardToggle.textContent = collapsed ? "+" : "−";
      cardToggle.title = collapsed ? "Expand card" : "Collapse card";
    });

    let discoverTab = "met";
    let discoverTimer = 0;
    const discoverInput = document.querySelector("[data-discover-q]");
    const discoverResults = document.querySelector("[data-discover-results]");
    const discoverStatus = document.querySelector("[data-discover-status]");

    function setDiscoverStatus(msg) {
      if (!discoverStatus) return;
      if (!msg) {
        discoverStatus.hidden = true;
        discoverStatus.textContent = "";
        return;
      }
      discoverStatus.hidden = false;
      discoverStatus.textContent = msg;
    }

    function setDiscoverTab(tab) {
      discoverTab = tab === "wikidata" ? "wikidata" : "met";
      document.querySelectorAll("[data-discover-tab]").forEach((btn) => {
        const active = btn.getAttribute("data-discover-tab") === discoverTab;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (discoverInput instanceof HTMLInputElement && discoverInput.value.trim()) {
        runDiscover(discoverInput.value.trim());
      }
    }

    function yearsFromEnrich(ent) {
      if (ent.startYear != null && ent.endYear != null) return `${ent.startYear}–${ent.endYear}`;
      if (ent.startYear != null) return String(ent.startYear);
      return "";
    }

    function renderDiscoverResults(items) {
      if (!discoverResults) return;
      if (!items.length) {
        discoverResults.innerHTML = `<p class="atlas-discover__empty">No results</p>`;
        return;
      }
      discoverResults.innerHTML = items
        .map((item) => {
          const thumb = item.portraitUrl
            ? `<img class="atlas-discover__thumb" src="${esc(item.portraitUrl)}" alt="" loading="lazy" />`
            : `<div class="atlas-discover__thumb atlas-discover__thumb--empty">${esc((item.title || "?").charAt(0))}</div>`;
          const meta = item.meta ? `<span class="atlas-discover__meta">${esc(item.meta)}</span>` : "";
          const save =
            item.source === "met"
              ? `<button type="button" class="atlas-btn" data-discover-save-met="${esc(String(item.metObjectId))}" data-title="${esc(item.title)}" data-artist="${esc(item.artist || "")}" data-date="${esc(item.date || "")}" data-portrait="${esc(item.portraitUrl || "")}" data-source-url="${esc(item.sourceUrl || "")}">Save to Museum</button>`
              : "";
          return `<div class="atlas-discover__row" data-discover-item>
            ${thumb}
            <div class="atlas-discover__body">
              <div class="atlas-discover__title">${esc(item.title)}</div>
              ${meta}
              <div class="atlas-discover__actions">
                <button type="button" class="atlas-btn" data-discover-preview
                  data-source="${esc(item.source)}"
                  data-id="${esc(item.id || "")}"
                  data-title="${esc(item.title)}"
                  data-summary="${esc(item.summary || "")}"
                  data-description="${esc(item.description || "")}"
                  data-years="${esc(item.years || "")}"
                  data-portrait="${esc(item.portraitUrl || "")}"
                  data-source-url="${esc(item.sourceUrl || "")}"
                  data-license="${esc(item.license || "")}"
                  data-attribution="${esc(item.attribution || "")}"
                  data-wikidata="${esc(item.wikidataId || "")}"
                  data-met="${esc(item.metObjectId != null ? String(item.metObjectId) : "")}"
                  data-kind="${esc(item.kind || "work")}"
                >Preview</button>
                ${save}
              </div>
            </div>
          </div>`;
        })
        .join("");
    }

    function previewFromDiscoverButton(btn) {
      const source = btn.getAttribute("data-source");
      const metId = btn.getAttribute("data-met");
      const qid = btn.getAttribute("data-wikidata") || btn.getAttribute("data-id");
      const focus = {
        id:
          source === "met" && metId
            ? `met-live-${metId}`
            : qid
              ? `wd-live-${qid}`
              : `discover-${Date.now()}`,
        kind: btn.getAttribute("data-kind") || (source === "met" ? "work" : "person"),
        name: btn.getAttribute("data-title") || "Untitled",
        summary: btn.getAttribute("data-summary") || "",
        description: btn.getAttribute("data-description") || null,
        years: btn.getAttribute("data-years") || "",
        portraitUrl: btn.getAttribute("data-portrait") || null,
        sourceUrl: btn.getAttribute("data-source-url") || null,
        license: btn.getAttribute("data-license") || null,
        attribution: btn.getAttribute("data-attribution") || null,
        wikidataId: source === "wikidata" ? qid : null,
        metObjectId: metId ? Number(metId) : null,
        tags: source === "met" ? ["met", "open-access"] : ["wikidata"],
        hint: source === "met" ? "Met Open Access · CC0" : "Wikidata enrich preview",
      };
      previewDiscoverCard(focus);
    }

    async function saveMetFromDiscover(btn) {
      const objectId = btn.getAttribute("data-discover-save-met");
      if (!objectId) return;
      const focus = {
        id: `met-live-${objectId}`,
        kind: "work",
        name: btn.getAttribute("data-title") || "Untitled",
        summary: [btn.getAttribute("data-artist"), btn.getAttribute("data-date")].filter(Boolean).join(" · "),
        portraitUrl: btn.getAttribute("data-portrait") || null,
        sourceUrl: btn.getAttribute("data-source-url") || null,
        license: "CC0",
        attribution: "The Metropolitan Museum of Art",
      };
      previewDiscoverCard({ ...focus, tags: ["met", "open-access"], metObjectId: Number(objectId), hint: "Met Open Access · CC0" });
      await saveToMuseum(focus);
    }

    async function runDiscover(q) {
      if (!q) {
        setDiscoverStatus("");
        if (discoverResults) discoverResults.innerHTML = "";
        return;
      }
      setDiscoverStatus("Searching…");
      try {
        if (discoverTab === "met") {
          const res = await fetch(`/api/atlas/met/search?q=${encodeURIComponent(q)}`);
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || "Met search failed");
          const items = (Array.isArray(json) ? json : []).map((o) => ({
            source: "met",
            id: `met-live-${o.metObjectId}`,
            metObjectId: o.metObjectId,
            title: o.title || "Untitled",
            artist: o.artist || "",
            date: o.date || "",
            summary: [o.artist, o.date].filter(Boolean).join(" · "),
            meta: [o.artist, o.date].filter(Boolean).join(" · ") || "Met · CC0",
            portraitUrl: o.primaryImageSmall,
            sourceUrl: o.objectURL,
            license: "CC0",
            attribution: "The Metropolitan Museum of Art",
            kind: "work",
          }));
          renderDiscoverResults(items);
          setDiscoverStatus(items.length ? `${items.length} Met results` : "No Met results");
        } else {
          const res = await fetch(`/api/atlas/enrich?q=${encodeURIComponent(q)}`);
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || "Enrich failed");
          const list = Array.isArray(json) ? json : json ? [json] : [];
          const items = list.map((ent) => ({
            source: "wikidata",
            id: ent.wikidataId || ent.id,
            wikidataId: ent.wikidataId || ent.id,
            title: ent.name,
            summary: ent.description || "",
            description: ent.description || "",
            years: yearsFromEnrich(ent),
            meta: ent.description || ent.wikidataId || "",
            portraitUrl: ent.portraitUrl || null,
            sourceUrl: ent.sourceUrl || null,
            license: "CC0",
            attribution: "Wikidata",
            kind: "person",
          }));
          renderDiscoverResults(items);
          setDiscoverStatus(items.length ? `${items.length} Wikidata results` : "No Wikidata results");
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : "Discover failed";
        setDiscoverStatus(msg);
        if (discoverResults) discoverResults.innerHTML = "";
      }
    }

    discoverInput?.addEventListener("input", () => {
      window.clearTimeout(discoverTimer);
      const q = (discoverInput instanceof HTMLInputElement ? discoverInput.value : "").trim();
      discoverTimer = window.setTimeout(() => runDiscover(q), 400);
    });
    discoverInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        window.clearTimeout(discoverTimer);
        const q = (discoverInput instanceof HTMLInputElement ? discoverInput.value : "").trim();
        runDiscover(q);
      }
    });

    // Timeline
    const yearInput = document.querySelector("[data-timeline-year]");
    const yearLabel = document.querySelector("[data-timeline-label]");
    const rangeEl = document.querySelector("[data-timeline-range]");
    const track = document.querySelector("[data-timeline-track]");
    const badge = document.querySelector("[data-atlas-badge]");
    const { min, max } = state.bounds;

    function updateTimeline(year, { repaint = true } = {}) {
      const y = Number(year);
      scrubYear = y;
      if (yearLabel) yearLabel.textContent = `Focus ${yearStr(y)} · ±${YEAR_WINDOW}y`;
      if (rangeEl) {
        const left = ((y - YEAR_WINDOW - min) / (max - min)) * 100;
        const width = ((YEAR_WINDOW * 2) / (max - min)) * 100;
        rangeEl.style.left = `${Math.max(0, left)}%`;
        rangeEl.style.width = `${Math.min(100 - Math.max(0, left), width)}%`;
      }
      if (badge && Math.abs(y - state.year) > 5) badge.textContent = yearStr(y);
      else if (badge) badge.textContent = state.badge;
      if (repaint) {
        paintCallouts(activePinList(), state.focusId, { fit: false });
        paintTimelineMarks();
      }
    }

    function paintTimelineMarks() {
      if (!track) return;
      track.querySelectorAll(".atlas-dock__mark").forEach((n) => n.remove());
      for (const e of state.timeline || []) {
        if (kindFilter !== "all" && e.kind !== kindFilter) continue;
        if (!inYearWindow(e, scrubYear)) continue;
        const pct = ((e.startYear - min) / (max - min)) * 100;
        const color =
          e.kind === "deity"
            ? "#c9a227"
            : e.kind === "event"
              ? "#8a9bb8"
              : e.kind === "dynasty" || e.kind === "idea"
                ? "#a78bfa"
                : "var(--at-gold)";
        const btn = document.createElement("button");
        btn.className = "atlas-dock__mark";
        btn.type = "button";
        btn.title = `${e.name} (${e.startYear})`;
        btn.setAttribute("data-entity", e.id);
        btn.style.left = `${pct}%`;
        btn.style.background = color;
        track.appendChild(btn);
      }
    }

    yearInput?.addEventListener("input", () => updateTimeline(yearInput.value));
    updateTimeline(yearInput?.value ?? state.year, { repaint: false });
    paintTimelineMarks();
    renderCard(state.card);
    loadMuseumIds();
    syncSaveButton();

    window.addEventListener("popstate", () => {
      const url = new URL(window.location.href);
      const scene = url.searchParams.get("scene") || state.sceneId;
      const e = url.searchParams.get("e");
      if (scene !== state.sceneId) selectScene(scene);
      else if (e && e !== state.focusId) selectEntity(e);
    });

    async function loadSearchIndex() {
      try {
        const res = await fetch("/api/atlas/search-index");
        if (!res.ok) throw new Error(`search-index ${res.status}`);
        const data = await res.json();
        state.search = data.search || [];
        state.timeline = data.timeline || [];
        state.indexReady = true;
        paintTimelineMarks();
        if (search instanceof HTMLInputElement && search.value.trim()) filterResults();
      } catch (err) {
        console.warn("[atlas search-index]", err);
        state.indexReady = false;
      }
    }

    async function bootMap() {
      const host = document.getElementById("atlas-map");
      if (!host || host.dataset.booted === "1") return;
      host.dataset.booted = "1";

      // Defer MapLibre parse slightly so the shell paints first
      await new Promise((r) => requestAnimationFrame(() => r(null)));

      map = new maplibregl.Map({
        container: host,
        style: darkBasemapStyle,
        center: [state.center.lng, state.center.lat],
        zoom: state.zoom,
        scrollZoom: true,
      });

      map.on("error", (e) => console.warn("[atlas map]", e?.error ?? e));
      map.on("load", () => {
        map?.resize();
        const fly = state.pinMode === "focus";
        paintCallouts(activePinList(), state.focusId, { fit: !fly, flyToFocus: fly });
        // Catalog after map init — search/timeline can wait; pins already in boot payload
        void loadSearchIndex();
      });
      requestAnimationFrame(() => map?.resize());
    }

    bootMap();
  </script>
</NovelcrafterLayout>
