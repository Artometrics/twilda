---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout hideNav={true} hideFooter={true} title="Page not found · Twilda" description="This Twilda page could not be found." canonicalPath="/404" noindex={true}>
  <section>
    <Wrapper
      variant="standard"
      class="flex flex-col items-center justify-center py-24  bg-accent-900 lg:h-svh"
    >
      <div class="max-w-3xl mx-auto text-center lg:py-32">
        <Text
          tag="h1"
          variant="displayXL"
          class="font-semibold tracking-tight text-white"
        >
          404 - Page Not Found
        </Text>
        <Text tag="p" variant="textLG" class="mt-4 text-base-400 text-balance">
          This page doesn’t exist. Head back to your library or sign in.
        </Text>
        <Button
          isLink={true}
          href="/novels/"
          size="xl"
          variant="accent"
          class="mx-auto mt-8 w-fit">Go to library</Button
        >
      </div>
    </Wrapper>
  </section>
</BaseLayout>
