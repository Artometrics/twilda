---
import Base from "../layouts/Base.astro";
---

<Base title="Not found · Field Desk" description="That page is not in the published demo issue.">
  <div class="magazine">
    <header class="mast">
      <div class="mast-row">
        <a class="mark" href="/">Field Desk</a>
        <p class="issue-label">Demo issue 01</p>
      </div>
    </header>
    <header class="issue-intro">
      <p class="kicker">404</p>
      <h1>Not in this issue</h1>
      <p class="lede">The static build only contains published demo pages.</p>
      <p><a class="more" href="/">Back to the issue</a></p>
    </header>
  </div>
</Base>
