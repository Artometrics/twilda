---
import Base from "../layouts/Base.astro";
import { readPublished } from "../content/store";
import { renderDocument } from "../render/document";

const doc = readPublished("home");
if (!doc || doc.kind !== "page") {
  throw new Error("content/home/published.json is missing. The static site reads published files only.");
}
const html = renderDocument(doc);
---

<Base title={`${doc.title} · Field Desk`} description={doc.dek}>
  <Fragment set:html={html} />
</Base>
