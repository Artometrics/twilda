---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/features/Hero.astro";
import LogoCloud from "@/components/testimonials/LogoCloud.astro";
import Feature1 from "@/components/features/Feature1.astro";
import Feature2 from "@/components/features/Feature2.astro";
import Feature3 from "@/components/features/Feature3.astro";
import Feature4 from "@/components/features/Feature4.astro";
import Feature5 from "@/components/features/Feature5.astro";
import Feature6 from "@/components/features/Feature6.astro";
import Pricing from "@/components/pricing/Pricing.astro";
import Cta from "@/components/ctas/Cta.astro";
import Faq from "@/components/helpcenter/Faq.astro";
import Testimonial from "@/components/testimonials/Testimonial.astro";
import { getSiteUrl } from "@/lib/site";
import { homepageFaqJsonLd } from "@/lib/marketing/faqs";

const siteUrl = getSiteUrl();
const faqLd = homepageFaqJsonLd();

const orgLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Twilda",
  applicationCategory: "BrowserApplication",
  operatingSystem: "Web",
  url: siteUrl,
  publisher: {
    "@type": "Organization",
    name: "Artometrics",
    url: siteUrl,
  },
  description:
    "Twilda helps writers draft novels, explore history on Atlas, build GOTHA genealogies, and curate a personal museum of open-access artifacts.",
};
---

<BaseLayout
  title="Twilda — Novels, Atlas & GOTHA"
  description="Write novels with Plan, Write, and Codex. Explore history on Atlas—including Met Open Access artifacts—and build your GOTHA family tree. From Artometrics."
  canonicalPath="/"
  jsonLd={[orgLd, faqLd]}
>
  <Hero />
  <LogoCloud />
  <Feature1 />
  <Feature2 />
  <Feature3 />
  <Feature4 />
  <Feature5 />
  <Feature6 />
  <Testimonial />
  <Pricing />
  <Cta />
  <Faq />
</BaseLayout>
