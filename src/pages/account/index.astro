---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getEntity } from "@/lib/atlas/data";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/forms/login/?redirect=/account/");
}

const supabase = Astro.locals.supabase!;
const [{ data: profile }, { data: subscription }, museumResult] = await Promise.all([
  supabase.from("profiles").select("display_name, pen_name").eq("id", user.id).maybeSingle(),
  supabase
    .from("subscriptions")
    .select("plan, ai_credits_remaining, ai_credits_monthly, status")
    .eq("user_id", user.id)
    .maybeSingle(),
  supabase
    .from("atlas_collections")
    .select("id, seed_entity_id, title, kind, summary, portrait_url, source_url, license, attribution, notes, created_at")
    .eq("user_id", user.id)
    .order("created_at", { ascending: false }),
]);

const museumReady = !(museumResult.error && museumResult.error.code === "42P01");
const museumItems = museumReady ? museumResult.data ?? [] : [];

const MET_STARTER = [
  "met-washington-crossing",
  "met-aristotle-homer",
  "met-straw-hat",
  "met-temple-dendur",
  "met-unicorn-garden",
];
const VIENNA_STARTER = ["franz-joseph", "vienna", "cafe-central"].filter((id) => getEntity(id));
---

<BaseLayout
  title="Account · Twilda"
  description="Manage your Twilda profile, billing, and My Museum collection."
  canonicalPath="/account/"
  noindex={true}
>
  <Wrapper variant="standard" class="py-24">
    <Text tag="h1" variant="displayMD" class="font-semibold text-accent-900">
      Account
    </Text>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_1.2fr]">
      <div class="space-y-6 max-w-lg">
        <div class="p-6 border-2 border-accent-900 rounded-2xl bg-white">
          <p class="text-sm font-semibold uppercase tracking-wide text-base-600">Email</p>
          <p class="mt-1 text-lg text-accent-900">{user.email}</p>

          <form class="mt-6 space-y-4" data-profile-form>
            <label class="block">
              <span class="text-sm font-semibold uppercase tracking-wide text-base-600">Display name</span>
              <input
                name="display_name"
                value={profile?.display_name ?? ""}
                class="mt-1 w-full rounded-xl border-2 border-accent-900 px-3 py-2"
                placeholder="Your name"
              />
            </label>
            <label class="block">
              <span class="text-sm font-semibold uppercase tracking-wide text-base-600">Pen name</span>
              <input
                name="pen_name"
                value={profile?.pen_name ?? ""}
                class="mt-1 w-full rounded-xl border-2 border-accent-900 px-3 py-2"
                placeholder="Optional"
              />
            </label>
            <Button size="sm" variant="accent" type="submit">Save profile</Button>
            <p class="text-sm text-base-600" data-profile-status hidden></p>
          </form>
        </div>

        <div class="p-6 border-2 border-accent-900 rounded-2xl bg-accent-100">
          <p class="text-sm font-semibold uppercase tracking-wide text-base-600">Plan</p>
          <p class="mt-1 text-lg font-semibold text-accent-900 capitalize">
            {subscription?.plan ?? "free"}
          </p>
          <p class="mt-2 text-base text-accent-800">
            AI credits: {subscription?.ai_credits_remaining ?? 5} / {subscription?.ai_credits_monthly ?? 5}
          </p>
          <Button isLink={true} href="/account/billing/" size="sm" variant="accent" class="mt-4">
            Manage billing
          </Button>
        </div>

        <div class="flex flex-wrap gap-3">
          <Button isLink={true} href="/novels/" size="md" variant="default">Open library</Button>
          <Button isLink={true} href="/atlas/?scene=met-open-access" size="md" variant="default">Open Atlas</Button>
          <Button isLink={true} href="/gotha/" size="md" variant="default">Open GOTHA</Button>
          <Button size="md" variant="muted" data-export-data>Export my data</Button>
          <Button size="md" variant="muted" data-delete-account>Delete account</Button>
          <Button size="md" variant="muted" data-sign-out>Sign out</Button>
        </div>
      </div>

      <section class="space-y-4" aria-labelledby="museum-heading">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <Text tag="h2" id="museum-heading" variant="displaySM" class="font-semibold text-accent-900">
              My Museum
            </Text>
            <p class="mt-1 text-accent-800">
              Private collection of Atlas artifacts (Met Open Access and curated works).
            </p>
          </div>
        </div>

        {!museumReady && (
          <p class="rounded-xl border-2 border-amber-700 bg-amber-50 p-4 text-sm text-amber-950">
            Run <code>005_atlas_museum.sql</code> in Supabase to enable My Museum saves.
          </p>
        )}

        {museumReady && (
          <div class="flex flex-wrap gap-2">
            <Button size="sm" variant="accent" type="button" data-kit="met" data-ids={JSON.stringify(MET_STARTER)}>
              Load Met classical kit
            </Button>
            <Button size="sm" variant="default" type="button" data-kit="vienna" data-ids={JSON.stringify(VIENNA_STARTER)}>
              Load Vienna circuit
            </Button>
            <Button isLink={true} href="/gotha/" size="sm" variant="muted">Family history → GOTHA</Button>
          </div>
        )}

        <div class="grid gap-4 sm:grid-cols-2" data-museum-grid>
          {
            museumItems.length === 0 ? (
              <div class="sm:col-span-2 rounded-2xl border-2 border-dashed border-accent-900/40 p-8 text-accent-800">
                <p>No artifacts yet. Save works from Atlas, or load a classic starter kit.</p>
                <Button isLink={true} href="/atlas/?scene=met-open-access" size="sm" variant="accent" class="mt-4">
                  Browse Met Open Access
                </Button>
              </div>
            ) : (
              museumItems.map((item) => (
                <article class="rounded-2xl border-2 border-accent-900 bg-white overflow-hidden">
                  {item.portrait_url ? (
                    <img src={item.portrait_url} alt="" class="h-40 w-full object-cover" loading="lazy" />
                  ) : (
                    <div class="h-28 bg-accent-200 flex items-center justify-center text-accent-800 text-sm">No image</div>
                  )}
                  <div class="p-4 space-y-2">
                    <p class="text-xs uppercase tracking-wide text-base-600">{item.kind ?? "work"}</p>
                    <h3 class="font-semibold text-accent-900">{item.title}</h3>
                    {item.license && <p class="text-xs text-base-600">License: {item.license}</p>}
                    <div class="flex flex-wrap gap-2 pt-2">
                      <Button isLink={true} href={`/atlas/?e=${item.seed_entity_id}`} size="sm" variant="default">
                        Open in Atlas
                      </Button>
                      <Button size="sm" variant="muted" type="button" data-remove-museum={item.seed_entity_id}>
                        Remove
                      </Button>
                    </div>
                  </div>
                </article>
              ))
            )
          }
        </div>
      </section>
    </div>
  </Wrapper>
</BaseLayout>

<script>
  import { createSupabaseBrowserClient } from "@/lib/supabase/ssr";

  document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
    const supabase = createSupabaseBrowserClient();
    await supabase.auth.signOut();
    window.location.href = "/";
  });

  document.querySelector("[data-export-data]")?.addEventListener("click", async () => {
    window.location.href = "/api/account/export/";
  });

  document.querySelector("[data-delete-account]")?.addEventListener("click", async () => {
    if (!confirm("Delete your account and all novels? This cannot be undone.")) return;
    const res = await fetch("/api/account/", { method: "DELETE" });
    if (res.ok) {
      window.location.href = "/";
      return;
    }
    const data = await res.json();
    alert(data.error || "Could not delete account");
  });

  document.querySelector("[data-profile-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = new FormData(form);
    const status = document.querySelector("[data-profile-status]");
    try {
      const res = await fetch("/api/account/profile", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          display_name: data.get("display_name") || null,
          pen_name: data.get("pen_name") || null,
        }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || "Save failed");
      if (status) {
        status.hidden = false;
        status.textContent = "Saved.";
      }
    } catch (err) {
      if (status) {
        status.hidden = false;
        status.textContent = err instanceof Error ? err.message : "Save failed";
      }
    }
  });

  document.querySelectorAll("[data-remove-museum]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-remove-museum");
      if (!id) return;
      const res = await fetch(`/api/account/museum?seedEntityId=${encodeURIComponent(id)}`, { method: "DELETE" });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        alert(j.error || "Remove failed");
        return;
      }
      window.location.reload();
    });
  });

  async function saveSeed(seedEntityId) {
    const res = await fetch(`/api/atlas/state?mode=focus&e=${encodeURIComponent(seedEntityId)}`);
    const data = await res.json();
    const f = data.card?.focus;
    if (!f) throw new Error(`Unknown entity ${seedEntityId}`);
    const save = await fetch("/api/account/museum", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        seedEntityId: f.id,
        title: f.name,
        kind: f.kind,
        summary: f.summary,
        portraitUrl: f.portraitUrl,
        sourceUrl: f.sourceUrl,
        license: f.license,
        attribution: f.attribution,
      }),
    });
    const j = await save.json();
    if (!save.ok) throw new Error(j.error || "Save failed");
  }

  document.querySelectorAll("[data-kit]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const ids = JSON.parse(btn.getAttribute("data-ids") || "[]");
      btn.disabled = true;
      try {
        for (const id of ids) await saveSeed(id);
        window.location.reload();
      } catch (err) {
        alert(err instanceof Error ? err.message : "Kit failed");
        btn.disabled = false;
      }
    });
  });
</script>
