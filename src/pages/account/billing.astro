---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect("/forms/login/?redirect=/account/billing/");

const supabase = Astro.locals.supabase!;
const { data: subscription } = await supabase
  .from("subscriptions")
  .select("*")
  .eq("user_id", user.id)
  .maybeSingle();

const success = Astro.url.searchParams.get("success");
const checkoutPlan = Astro.url.searchParams.get("plan");
const currentPlan = subscription?.plan ?? "free";
const hasStripeCustomer = Boolean(subscription?.stripe_customer_id);
const autoCheckout =
  checkoutPlan === "pro" &&
  currentPlan === "free" &&
  Boolean(import.meta.env.STRIPE_SECRET_KEY);
---

<BaseLayout
  title="Billing · Twilda"
  description="Manage your Twilda subscription and AI credits."
  canonicalPath="/account/billing/"
  noindex={true}
>
  <Wrapper variant="standard" class="py-24">
    <Text tag="h1" variant="displayMD" class="font-semibold text-accent-900">
      Billing
    </Text>
    {success && (
      <p class="mt-4 p-4 border-2 border-accent-500 rounded-xl bg-accent-100 text-accent-900">
        Subscription updated. Thank you!
      </p>
    )}
    <div class="mt-8 max-w-lg p-6 border-2 border-accent-900 rounded-2xl bg-white space-y-4">
      <p class="text-lg font-semibold text-accent-900 capitalize">
        Current plan: {currentPlan}
      </p>
      <p class="text-accent-800">
        AI credits: {subscription?.ai_credits_remaining ?? 5} remaining of {subscription?.ai_credits_monthly ?? 5} / month
      </p>
      {subscription?.current_period_end && (
        <p class="text-sm text-accent-700">
          Renews {new Date(subscription.current_period_end).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
        </p>
      )}
      <div class="flex flex-wrap gap-3">
        {currentPlan === "free" && (
          <Button size="md" variant="accent" data-upgrade="pro">Upgrade to Pro</Button>
        )}
        {currentPlan !== "studio" && (
          <Button size="md" variant="default" data-contact-studio>Contact for Studio</Button>
        )}
        {hasStripeCustomer && (
          <Button size="md" variant="muted" data-manage-billing>Manage subscription</Button>
        )}
        <Button isLink={true} href="/account/" size="md" variant="muted">Back to account</Button>
      </div>
      <p class="text-sm text-accent-700">
        Studio is custom onboarding — use the contact button or email support. Pro is self-serve checkout.
      </p>
    </div>
  </Wrapper>
</BaseLayout>

<script define:vars={{ autoCheckout }}>
  async function startCheckout(plan) {
    const res = await fetch(`/api/billing/checkout/?plan=${plan}`, { method: "POST" });
    const data = await res.json();
    if (data.url) window.location.href = data.url;
    else alert(data.error || "Checkout unavailable");
  }

  document.querySelectorAll("[data-upgrade]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const plan = btn.getAttribute("data-upgrade");
      if (plan) await startCheckout(plan);
    });
  });

  document.querySelector("[data-contact-studio]")?.addEventListener("click", () => {
    window.location.href = "/forms/contact/?subject=studio";
  });

  document.querySelector("[data-manage-billing]")?.addEventListener("click", async () => {
    const res = await fetch("/api/billing/portal/", { method: "POST" });
    const data = await res.json();
    if (data.url) window.location.href = data.url;
    else alert(data.error || "Billing portal unavailable");
  });

  if (autoCheckout) startCheckout("pro");
</script>
