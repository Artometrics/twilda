---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import HelpCenterEntry from "@/components/helpcenter/HelpCenterEntry.astro";
import Faq1 from "@/components/helpcenter/Faq.astro";
import { getCollection } from "astro:content";

const allEntries = (await getCollection("helpcenter")).sort((a, b) =>
  String(a.data.page ?? a.id).localeCompare(String(b.data.page ?? b.id)),
);
---

<BaseLayout
  title="Help Center · Twilda"
  description="Guides for Twilda novels, Atlas, GOTHA, My Museum, billing, and open-data sources."
  canonicalPath="/helpcenter/"
>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-12 lg:pt-64">
      <div class="max-w-xl text-balance mx-auto text-center">
        <Text
          tag="h1"
          variant="displayXL"
          class="font-semibold tracking-tight text-accent-900"
        >
          Help Center
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-accent-900">
          Guides for writing novels, exploring Atlas artifacts, building GOTHA trees, and managing your museum and billing.
        </Text>
      </div>
    </Wrapper>
    <Wrapper variant="standard" class="border-t-8 border-accent-900 py-8">
      <div class="flex flex-col gap-y-8">
        {allEntries.map((post) => <HelpCenterEntry post={post} />)}
      </div>
    </Wrapper>
  </section>
  <Faq1 />
</BaseLayout>
