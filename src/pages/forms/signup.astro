---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import GoogleSignInButton from "@/components/auth/GoogleSignInButton.astro";
import { getRedirectParam } from "@/lib/auth/session";

export const prerender = false;

const email = Astro.url.searchParams.get("email") ?? "";
const redirect = getRedirectParam(Astro.url, "/novels/?welcome=1");
---

<BaseLayout hideNav={true} hideFooter={true} title="Sign up · Twilda" description="Create a Twilda account." canonicalPath="/forms/signup/" noindex={true}>
  <section>
    <Wrapper
      variant="standard"
      class="flex flex-col items-center justify-center py-24 border-y-8 bg-accent-300 min-h-[100dvh] overflow-y-auto"
    >
      <div class="w-full max-w-md mx-auto">
        <Text
          tag="h2"
          variant="displayXL"
          class="font-semibold text-accent-900 text-center"
        >
          Create your Twilda account
        </Text>
        <p class="mt-4 text-center text-accent-900 hidden" data-auth-message></p>
        <div class="mt-6 space-y-4">
          <GoogleSignInButton redirect={redirect} label="Sign up with Google" />
          <div class="flex items-center gap-3 text-sm text-accent-800">
            <span class="h-px flex-1 bg-accent-900/20" aria-hidden="true"></span>
            <span>or sign up with email</span>
            <span class="h-px flex-1 bg-accent-900/20" aria-hidden="true"></span>
          </div>
        </div>
        <form class="mt-4" data-signup-form>
          <input type="hidden" name="redirect" value={redirect} />
          <div class="space-y-6">
            <div
              class="overflow-hidden border-2 border-accent-900 shadow divide-y-2 divide-accent-900 rounded-xl"
            >
              <div>
                <label for="display_name" class="sr-only">Display name</label>
                <input
                  id="display_name"
                  name="display_name"
                  type="text"
                  placeholder="Display name (optional)"
                  autocomplete="name"
                  class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
                />
              </div>
              <div>
                <label for="email" class="sr-only">Email address</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="Email address"
                  value={email}
                  required
                  autocomplete="email"
                  class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
                />
              </div>
              <div>
                <label for="password" class="sr-only">Password</label>
                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="Password (6+ characters)"
                  required
                  minlength="6"
                  autocomplete="new-password"
                  class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
                />
              </div>
            </div>
            <Button type="submit" size="xl" variant="default" class="w-full" data-submit-btn>
              Sign up
            </Button>
            <p class="text-sm text-accent-900 lg:text-lg font-medium text-center">
              Already have an account?
              <a
                href={`/forms/login/?redirect=${encodeURIComponent(redirect)}`}
                class="ml-2 underline hover:text-accent-700"
              >
                Log in
              </a>
            </p>
          </div>
        </form>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script>
  import { createSupabaseBrowserClient } from "@/lib/supabase/ssr";
  import { isSafeInternalPath } from "@/lib/auth/safe-path";

  const form = document.querySelector("[data-signup-form]");
  const message = document.querySelector("[data-auth-message]");
  const submitBtn = document.querySelector("[data-submit-btn]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const email = data.get("email")?.toString().trim();
    const password = data.get("password")?.toString() ?? "";
    const displayName = data.get("display_name")?.toString().trim();
    const rawRedirect = data.get("redirect")?.toString();
    const afterAuth = isSafeInternalPath(rawRedirect) ? rawRedirect : "/novels/?welcome=1";

    if (!email || !password) return;

    submitBtn?.setAttribute("disabled", "true");
    if (message) {
      message.textContent = "Creating account…";
      message.classList.remove("hidden");
    }

    try {
      const supabase = createSupabaseBrowserClient();
      const redirectTo = `${window.location.origin}/auth/callback/?next=${encodeURIComponent(afterAuth)}`;
      const { data: signUpData, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          emailRedirectTo: redirectTo,
          data: { display_name: displayName || undefined },
        },
      });
      if (error) throw error;

      if (signUpData.session) {
        window.location.href = afterAuth;
        return;
      }

      if (message) {
        message.textContent = "Check your email to confirm your account, then sign in.";
        message.classList.remove("hidden");
      }
    } catch (err) {
      if (message) {
        message.textContent = err instanceof Error ? err.message : "Sign up failed.";
        message.classList.remove("hidden");
      }
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
