---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getSafeRedirect } from "@/lib/auth";

export const prerender = false;

const next = getSafeRedirect(Astro.url.searchParams.get("next"));

if (Astro.locals.user) {
  return Astro.redirect(next);
}

const inputClass =
  "block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent border-accent-900 appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none focus:ring-black sm:text-sm";
---

<BaseLayout hideNav={true} hideFooter={true}>
  <section>
    <Wrapper
      variant="standard"
      class="flex flex-col items-center justify-center py-24 border-y-8 bg-accent-300 h-[100dvh]"
    >
      <div class="w-full max-w-md mx-auto">
        <Text
          tag="h2"
          variant="displayXL"
          class="font-semibold text-accent-900 text-center"
        >
          Sign up
        </Text>

        <div
          id="auth-message"
          class="hidden mt-4 rounded-xl border-2 border-accent-900 bg-white px-4 py-3 text-accent-900 lg:text-xl"
          role="alert"
          aria-live="polite"
        />

        <form id="signup-form" class="mt-6" novalidate>
          <div class="space-y-6">
            <div
              class="overflow-hidden border-2 border-accent-900 shadow divide-y-2 divide-accent-900 rounded-xl"
            >
              <div>
                <label for="display_name" class="sr-only">Display name</label>
                <input
                  id="display_name"
                  name="display_name"
                  type="text"
                  placeholder="Display name"
                  autocomplete="nickname"
                  required
                  class={inputClass}
                />
              </div>
              <div>
                <label for="email" class="sr-only">Email address</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="Email address"
                  required
                  autocomplete="email"
                  class={inputClass}
                />
              </div>
              <div>
                <label for="password" class="sr-only">Password</label>
                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="Password (6+ characters)"
                  autocomplete="new-password"
                  required
                  minlength="6"
                  class={inputClass}
                />
              </div>
            </div>

            <Button
              type="submit"
              id="signup-submit"
              size="xl"
              variant="default"
              class="w-full mt-8"
            >
              Sign up
            </Button>

            <div>
              <p class="text-sm text-accent-900 lg:text-2xl font-medium">
                Already have an account?
                <a
                  href="/forms/login"
                  class="ml-3 text-accent-900 underline lg:text-2xl hover:text-accent-300"
                >
                  Log in now
                </a>
              </p>
            </div>
          </div>
        </form>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script>
  import { actions } from "astro:actions";

  const form = document.getElementById("signup-form") as HTMLFormElement;
  const submit = document.getElementById("signup-submit") as HTMLButtonElement;
  const message = document.getElementById("auth-message") as HTMLDivElement;

  function showMessage(text: string, isError: boolean) {
    message.textContent = text;
    message.classList.remove("hidden");
    message.classList.toggle("bg-accent-200", isError);
    message.classList.toggle("bg-white", !isError);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    submit.disabled = true;
    message.classList.add("hidden");

    try {
      const formData = new FormData(form);
      const result = await actions.signUp(formData);

      if (result.error || !result.data?.success) {
        showMessage(
          result.data?.message || result.error?.message || "Sign up failed.",
          true,
        );
        submit.disabled = false;
        return;
      }

      showMessage(result.data.message, false);
      form.reset();
      submit.disabled = false;
    } catch {
      showMessage("Something went wrong. Please try again.", true);
      submit.disabled = false;
    }
  });
</script>
