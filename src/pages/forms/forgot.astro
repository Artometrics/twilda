---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout hideNav={true} hideFooter={true} title="Forgot password · Twilda" description="Reset your Twilda password." canonicalPath="/forms/forgot/" noindex={true}>
  <section>
    <Wrapper
      variant="standard"
      class="flex flex-col items-center justify-center py-24 border-y-8 bg-accent-300 h-[100dvh]"
    >
      <div class="w-full max-w-md mx-auto">
        <Text
          tag="h2"
          variant="displayXL"
          class="font-semibold text-accent-900 text-center"
        >
          Reset password
        </Text>
        <p class="mt-4 text-center text-accent-900" data-auth-message></p>
        <form class="mt-6" data-forgot-form>
          <div class="space-y-6">
            <div class="overflow-hidden border-2 border-accent-900 shadow rounded-xl">
              <label for="email" class="sr-only">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="Email address"
                required
                autocomplete="email"
                class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
              />
            </div>
            <Button type="submit" size="xl" variant="default" class="w-full" data-submit-btn>
              Send reset link
            </Button>
            <p class="text-sm text-accent-900 lg:text-2xl font-medium text-center">
              <a href="/forms/login/" class="underline hover:text-accent-700">Back to sign in</a>
            </p>
          </div>
        </form>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script>
  import { createSupabaseBrowserClient } from "@/lib/supabase/ssr";

  const form = document.querySelector("[data-forgot-form]");
  const message = document.querySelector("[data-auth-message]");
  const submitBtn = document.querySelector("[data-submit-btn]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = new FormData(form).get("email")?.toString().trim();
    if (!email) return;

    submitBtn?.setAttribute("disabled", "true");
    if (message) message.textContent = "Sending reset link…";

    try {
      const supabase = createSupabaseBrowserClient();
      const redirectTo = `${window.location.origin}/forms/reset-password/`;
      const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo });
      if (error) throw error;
      if (message) {
        message.textContent = "Check your email for a password reset link.";
        message.classList.add("text-accent-800");
      }
    } catch (err) {
      if (message) {
        message.textContent = err instanceof Error ? err.message : "Could not send reset email.";
        message.classList.add("text-red-700");
      }
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
