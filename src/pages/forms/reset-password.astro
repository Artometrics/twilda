---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout hideNav={true} hideFooter={true}>
  <section>
    <Wrapper
      variant="standard"
      class="flex flex-col items-center justify-center py-24 border-y-8 bg-accent-300 min-h-[100dvh]"
    >
      <div class="w-full max-w-md mx-auto">
        <Text
          tag="h2"
          variant="displayXL"
          class="font-semibold text-accent-900 text-center"
        >
          Set a new password
        </Text>
        <p class="mt-4 text-center text-accent-900" data-auth-message>
          Verifying reset link…
        </p>
        <form class="mt-6 hidden" data-reset-form>
          <div class="space-y-6">
            <div
              class="overflow-hidden border-2 border-accent-900 shadow divide-y-2 divide-accent-900 rounded-xl"
            >
              <div>
                <label for="password" class="sr-only">New password</label>
                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="New password (6+ characters)"
                  required
                  minlength="6"
                  autocomplete="new-password"
                  class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
                />
              </div>
              <div>
                <label for="password_confirm" class="sr-only">Confirm password</label>
                <input
                  id="password_confirm"
                  name="password_confirm"
                  type="password"
                  placeholder="Confirm new password"
                  required
                  minlength="6"
                  autocomplete="new-password"
                  class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
                />
              </div>
            </div>
            <Button type="submit" size="xl" variant="default" class="w-full" data-submit-btn>
              Update password
            </Button>
            <p class="text-sm text-accent-900 font-medium text-center">
              <a href="/forms/login/" class="underline hover:text-accent-700">Back to sign in</a>
            </p>
          </div>
        </form>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script>
  import { createSupabaseBrowserClient } from "@/lib/supabase/ssr";

  const form = document.querySelector("[data-reset-form]");
  const message = document.querySelector("[data-auth-message]");
  const submitBtn = document.querySelector("[data-submit-btn]");

  function showForm() {
    form?.classList.remove("hidden");
    if (message) message.textContent = "Choose a new password for your account.";
  }

  function showError(text) {
    if (message) {
      message.textContent = text;
      message.classList.add("text-red-700");
    }
  }

  const supabase = createSupabaseBrowserClient();

  supabase.auth.onAuthStateChange((event) => {
    if (event === "PASSWORD_RECOVERY") showForm();
  });

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) {
      showForm();
      return;
    }

    const hash = window.location.hash.replace(/^#/, "");
    if (hash.includes("type=recovery") || hash.includes("access_token")) {
      showForm();
      return;
    }

    showError("This reset link is invalid or expired. Request a new one.");
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const password = data.get("password")?.toString() ?? "";
    const confirm = data.get("password_confirm")?.toString() ?? "";

    if (password.length < 6) {
      showError("Password must be at least 6 characters.");
      return;
    }
    if (password !== confirm) {
      showError("Passwords do not match.");
      return;
    }

    submitBtn?.setAttribute("disabled", "true");
    if (message) message.textContent = "Updating password…";

    try {
      const { error } = await supabase.auth.updateUser({ password });
      if (error) throw error;
      window.location.href = "/forms/login/?reset=1";
    } catch (err) {
      showError(err instanceof Error ? err.message : "Could not update password.");
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
