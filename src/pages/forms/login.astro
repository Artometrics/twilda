---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import GoogleSignInButton from "@/components/auth/GoogleSignInButton.astro";
import { getRedirectParam } from "@/lib/auth/session";

export const prerender = false;

const redirect = getRedirectParam(Astro.url);
const error = Astro.url.searchParams.get("error");
const reset = Astro.url.searchParams.get("reset");
---

<BaseLayout hideNav={true} hideFooter={true}>
  <section>
    <Wrapper
      variant="standard"
      class="flex flex-col items-center justify-center py-24 border-y-8 bg-accent-300 h-[100dvh]"
    >
      <div class="w-full max-w-md mx-auto">
        <Text
          tag="h2"
          variant="displayXL"
          class="font-semibold text-accent-900 text-center"
        >
          Sign in to Twilda
        </Text>
        {error && <p class="mt-4 text-center text-red-700">{error}</p>}
        {reset && (
          <p class="mt-4 text-center text-accent-800">
            Password updated. Sign in with your new password.
          </p>
        )}
        <p class="mt-4 text-center text-accent-900 hidden" data-auth-message></p>
        <div class="mt-6 space-y-4">
          <GoogleSignInButton redirect={redirect} />
          <div class="flex items-center gap-3 text-sm text-accent-800">
            <span class="h-px flex-1 bg-accent-900/20" aria-hidden="true"></span>
            <span>or sign in with email</span>
            <span class="h-px flex-1 bg-accent-900/20" aria-hidden="true"></span>
          </div>
        </div>
        <form class="mt-4" data-login-form>
          <input type="hidden" name="redirect" value={redirect} />
          <div class="space-y-6">
            <div
              class="overflow-hidden border-2 border-accent-900 shadow divide-y-2 divide-accent-900 rounded-xl"
            >
              <div>
                <label for="email" class="sr-only">Email address</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="Email address"
                  required
                  autocomplete="email"
                  class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
                />
              </div>
              <div>
                <label for="password" class="sr-only">Password</label>
                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="Password"
                  required
                  autocomplete="current-password"
                  class="block w-full px-3 py-4 text-xl text-accent-900 placeholder-black border-2 border-transparent appearance-none focus:border-accent-900 focus:bg-accent-300 focus:outline-none sm:text-sm"
                />
              </div>
            </div>
            <div class="flex items-center justify-between">
              <a href="/forms/forgot/" class="text-accent-900 lg:text-lg hover:underline">
                Forgot your password?
              </a>
            </div>
            <Button type="submit" size="xl" variant="default" class="w-full" data-submit-btn>
              Sign in
            </Button>
            <p class="text-sm text-accent-900 lg:text-lg font-medium text-center">
              Not a member?
              <a href="/forms/signup/" class="ml-2 underline hover:text-accent-700">Sign up</a>
            </p>
          </div>
        </form>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script>
  import { createSupabaseBrowserClient } from "@/lib/supabase/ssr";

  const form = document.querySelector("[data-login-form]");
  const message = document.querySelector("[data-auth-message]");
  const submitBtn = document.querySelector("[data-submit-btn]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const email = data.get("email")?.toString().trim();
    const password = data.get("password")?.toString() ?? "";
    const redirect = data.get("redirect")?.toString() || "/novels/";

    if (!email || !password) return;

    submitBtn?.setAttribute("disabled", "true");
    if (message) {
      message.textContent = "Signing in…";
      message.classList.remove("hidden");
    }

    try {
      const supabase = createSupabaseBrowserClient();
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) throw error;
      window.location.href = redirect;
    } catch (err) {
      if (message) {
        message.textContent = err instanceof Error ? err.message : "Sign in failed.";
        message.classList.remove("hidden");
      }
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
