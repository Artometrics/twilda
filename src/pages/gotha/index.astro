---
export const prerender = false;

import NovelcrafterLayout from "@/layouts/NovelcrafterLayout.astro";
import NovelsTopbar from "@/components/novels/NovelsTopbar.astro";
import "@/styles/atlas.css";
import { requireAuth } from "@/lib/auth/guards";
import { zodiacFromBirthDate, getChineseZodiac, type ZodiacSign, type ChineseZodiac } from "@/lib/gotha/zodiac";
import { druidTreeFromBirthDate, type DruidTree } from "@/lib/gotha/druid-tree";
import { sceneForEntity } from "@/lib/atlas/focus-payload";
import { getEntity } from "@/lib/atlas/data";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const { user, supabase } = auth;

const creditsPromise = supabase
  .from("subscriptions")
  .select("ai_credits_remaining, ai_credits_monthly")
  .eq("user_id", user.id)
  .maybeSingle();

let persons: any[] = [];
let dbReady = true;
const personsPromise = (async () => {
  try {
    const full = await supabase
      .from("gotha_persons")
      .select(
        "id, name, birth_year, birth_month, birth_day, birth_place, birth_lat, birth_lng, death_year, family_name, is_self, notes, atlas_entity_id, atlas_seed_id",
      )
      .eq("user_id", user.id)
      .order("birth_year", { ascending: true, nullsFirst: false });
    if (full.error && full.error.code === "42P01") return { persons: [] as any[], dbReady: false };
    if (full.error && full.error.message?.includes("atlas_seed_id")) {
      const retry = await supabase
        .from("gotha_persons")
        .select(
          "id, name, birth_year, birth_month, birth_day, birth_place, birth_lat, birth_lng, death_year, family_name, is_self, notes, atlas_entity_id",
        )
        .eq("user_id", user.id)
        .order("birth_year", { ascending: true, nullsFirst: false });
      return { persons: retry.data ?? [], dbReady: true };
    }
    return { persons: full.data ?? [], dbReady: true };
  } catch {
    return { persons: [] as any[], dbReady: false };
  }
})();

const [subResult, personsResult] = await Promise.all([creditsPromise, personsPromise]);
const subscription = subResult.data;
persons = personsResult.persons;
dbReady = personsResult.dbReady;

// Load relations
let relations: any[] = [];
if (dbReady && persons.length > 0) {
  const { data: rels } = await supabase
    .from("gotha_relations")
    .select("id, from_person_id, to_person_id, rel")
    .eq("user_id", user.id);
  relations = rels ?? [];
}

// Focus person
const focusIdRaw = Astro.url.searchParams.get("p");
const focusId =
  Astro.url.searchParams.has("p")
    ? focusIdRaw || null
    : persons.find((p: any) => p.is_self)?.id ?? persons[0]?.id ?? null;
const focus = persons.find((p: any) => p.id === focusId) ?? null;

let zodiac: ZodiacSign | null = null;
let chinese: ChineseZodiac | null = null;
let druid: DruidTree | null = null;

if (focus?.birth_month && focus?.birth_day) {
  zodiac = zodiacFromBirthDate(focus.birth_year ?? 1900, focus.birth_month, focus.birth_day);
  druid = druidTreeFromBirthDate(focus.birth_month, focus.birth_day);
}
if (focus?.birth_year) {
  chinese = getChineseZodiac(focus.birth_year);
}

const personRelations = relations.filter(
  (r: any) => r.from_person_id === focusId || r.to_person_id === focusId,
);

const personById = Object.fromEntries(persons.map((p: any) => [p.id, p]));

// Simple SVG tree computation — parents above, children below
function treePins(personId: string) {
  const parents: any[] = [];
  const children: any[] = [];
  const partners: any[] = [];
  for (const r of relations) {
    if (r.to_person_id === personId && r.rel === "parent") parents.push(personById[r.from_person_id]);
    if (r.from_person_id === personId && r.rel === "parent") children.push(personById[r.to_person_id]);
    if ((r.from_person_id === personId || r.to_person_id === personId) && r.rel === "partner") {
      const other = r.from_person_id === personId ? r.to_person_id : r.from_person_id;
      partners.push(personById[other]);
    }
  }
  return { parents: parents.filter(Boolean), children: children.filter(Boolean), partners: partners.filter(Boolean) };
}

const tree = focus ? treePins(focusId) : { parents: [], children: [], partners: [] };

const mapPins = persons.filter((p: any) => p.birth_lat && p.birth_lng);

const atlasSeedId = focus?.atlas_seed_id || null;
const atlasEntity = atlasSeedId ? getEntity(atlasSeedId) : null;
const atlasScene = atlasSeedId ? sceneForEntity(atlasSeedId) : null;
const atlasHref = atlasSeedId
  ? `/atlas/?${atlasScene ? `scene=${encodeURIComponent(atlasScene)}&` : ""}e=${encodeURIComponent(atlasSeedId)}`
  : null;
---

<NovelcrafterLayout title="GOTHA · Twilda">
  <!-- MapLibre CSS imported from the client script -->

  <!-- Liquid-glass SVG filter -->
  <svg width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden;">
    <filter id="liquid-glass" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="4" result="noise"/>
      <feGaussianBlur in="noise" stdDeviation="2" result="blurred"/>
      <feDisplacementMap in="SourceGraphic" in2="blurred" scale="50" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>

  <NovelsTopbar
    active="gotha"
    userEmail={user.email}
    credits={subscription?.ai_credits_remaining ?? 5}
    creditsMax={subscription?.ai_credits_monthly ?? 5}
  />

  <div class="gotha">
    <div class="gotha-shell">
      <!-- LEFT — person list + tree -->
      <aside class="gotha-tree">
        <div class="gotha-tree__head">
          <h1>GOTHA</h1>
          <p>Your personal genealogy. Add ancestors to trace their stories against the wider map of history.</p>
          {!dbReady && (
            <p style="color:#c9a227;font-size:12px;margin:0;">
              Run <code>004_atlas_schema.sql</code> in Supabase to enable GOTHA persistence.
            </p>
          )}
          <button class="gotha-btn gotha-btn--primary" type="button" data-toggle-add style="margin-top:10px;width:100%;justify-content:center;">
            + Add person
          </button>
        </div>

        <div class="gotha-scroll" data-persons-list>
          {
            persons.length === 0 ? (
              <div class="gotha-empty">
                <p>No people yet.<br />Add yourself first, then build your tree generation by generation.</p>
                {dbReady && (
                  <div style="display:flex;flex-direction:column;gap:8px;margin-top:12px;">
                    <button class="gotha-btn gotha-btn--primary" type="button" data-load-sample data-template="habsburg" style="width:100%;justify-content:center;">
                      Load Habsburg sample
                    </button>
                    <button class="gotha-btn" type="button" data-load-sample data-template="immigrant-atlantic" style="width:100%;justify-content:center;">
                      Load Atlantic immigrant sample
                    </button>
                    <button class="gotha-btn" type="button" data-load-sample data-template="mythic-ancestry" style="width:100%;justify-content:center;">
                      Load mythic ancestry sample
                    </button>
                  </div>
                )}
              </div>
            ) : (
              persons.map((p: any) => (
                <button
                  class:list={["gotha-person", { "is-active": p.id === focusId }]}
                  type="button"
                  data-person={p.id}
                >
                  <div class="gotha-person__av">{p.name.charAt(0).toUpperCase()}</div>
                  <div class="gotha-person__meta">
                    <strong>{p.name}{p.is_self ? " (you)" : ""}</strong>
                    <span>
                      {p.family_name && `${p.family_name} · `}
                      {p.birth_year && p.birth_year < 0 ? `${Math.abs(p.birth_year)} BCE` : p.birth_year}
                      {p.death_year && ` – ${p.death_year}`}
                      {p.birth_place && ` · ${p.birth_place}`}
                    </span>
                  </div>
                </button>
              ))
            )
          }
        </div>

        <!-- Add person form (hidden by default) -->
        <div class="gotha-add-form" id="add-person-form" style="display:none;margin:8px;">
          <form data-add-form>
            <div class="gotha-field">
              <label>Full name *</label>
              <input name="name" required placeholder="e.g. Mary O'Brien" />
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
              <div class="gotha-field">
                <label>Birth year</label>
                <input name="birth_year" type="number" placeholder="1920" />
              </div>
              <div class="gotha-field">
                <label>Month</label>
                <input name="birth_month" type="number" min="1" max="12" placeholder="6" />
              </div>
              <div class="gotha-field">
                <label>Day</label>
                <input name="birth_day" type="number" min="1" max="31" placeholder="15" />
              </div>
            </div>
            <div class="gotha-field">
              <label>Family / surname</label>
              <input name="family_name" placeholder="e.g. McAuliffe" />
            </div>
            <div class="gotha-field">
              <label>Birth place</label>
              <input name="birth_place" placeholder="e.g. Cork, Ireland" />
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
              <div class="gotha-field">
                <label>Latitude (optional)</label>
                <input name="birth_lat" type="number" step="any" placeholder="auto from place" />
              </div>
              <div class="gotha-field">
                <label>Longitude (optional)</label>
                <input name="birth_lng" type="number" step="any" placeholder="auto from place" />
              </div>
            </div>
            <div class="gotha-field" style="flex-direction:row;align-items:center;gap:8px;">
              <input type="checkbox" name="is_self" id="is-self" />
              <label for="is-self" style="text-transform:none;letter-spacing:0;font-size:12px;">This is me</label>
            </div>
            <div style="display:flex;gap:8px;margin-top:8px;">
              <button class="gotha-btn gotha-btn--primary" type="submit" style="flex:1;justify-content:center;">Save</button>
              <button class="gotha-btn" type="button" data-cancel-add style="flex:1;justify-content:center;">Cancel</button>
            </div>
          </form>
        </div>
      </aside>

      <!-- CENTER — map (birth pins + migrations) -->
      <div class="gotha-map-wrap">
        <div class="gotha-map" id="gotha-map"></div>
        <div class="gotha-map-veil" aria-hidden="true"></div>

        <!-- SVG family tree overlay on mobile / detail -->
        {
          focus && (
            <div style="position:absolute;bottom:0;left:0;right:0;z-index:20;pointer-events:none;">
              <div style="padding:12px 16px;background:linear-gradient(to top,rgba(13,15,14,0.92),transparent);pointer-events:auto;">
                <p style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--gt-faint);margin:0 0 6px;">Family connections</p>
                <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start;">
                  {tree.parents.length > 0 && (
                    <div>
                      <p style="font-size:10px;color:var(--gt-faint);margin:0 0 4px;">Parents</p>
                      {tree.parents.map((p: any) => (
                        <button class="gotha-btn" type="button" data-person={p.id} style="margin-right:4px;margin-bottom:4px;">{p.name}</button>
                      ))}
                    </div>
                  )}
                  {tree.partners.length > 0 && (
                    <div>
                      <p style="font-size:10px;color:var(--gt-faint);margin:0 0 4px;">Partners</p>
                      {tree.partners.map((p: any) => (
                        <button class="gotha-btn" type="button" data-person={p.id} style="margin-right:4px;">{p.name}</button>
                      ))}
                    </div>
                  )}
                  {tree.children.length > 0 && (
                    <div>
                      <p style="font-size:10px;color:var(--gt-faint);margin:0 0 4px;">Children</p>
                      {tree.children.map((p: any) => (
                        <button class="gotha-btn" type="button" data-person={p.id} style="margin-right:4px;">{p.name}</button>
                      ))}
                    </div>
                  )}
                  {tree.parents.length === 0 && tree.children.length === 0 && tree.partners.length === 0 && (
                    <p style="font-size:12px;color:var(--gt-faint);margin:0;">No connections yet. Use "Add relation" to link people.</p>
                  )}
                </div>
              </div>
            </div>
          )
        }
      </div>

      <!-- RIGHT — profile panel -->
      <aside class="gotha-detail">
        {
          !focus ? (
            <div class="gotha-empty">
              <p style="font-family:var(--gt-serif);font-size:22px;margin:0 0 10px;color:var(--gt-text);">GOTHA</p>
              <p>Inspired by the Almanach de Gotha — the old German reference for European royal lineages — this is your personal genealogy and mythological ancestry explorer.</p>
              <p style="margin-top:12px;">Add yourself to begin — or load the Habsburg sample to see how the map and tree work together.</p>
              <p style="margin-top:12px;">Each person shows their western zodiac, Celtic Ogham tree, Chinese year animal, and family name origin via Wikidata.</p>
              {dbReady && (
                <div style="display:flex;flex-direction:column;gap:8px;margin-top:14px;">
                  <button class="gotha-btn gotha-btn--primary" type="button" data-load-sample data-template="habsburg" style="justify-content:center;width:100%;">
                    Load Habsburg sample
                  </button>
                  <button class="gotha-btn" type="button" data-load-sample data-template="immigrant-atlantic" style="justify-content:center;width:100%;">
                    Load Atlantic immigrant sample
                  </button>
                  <button class="gotha-btn" type="button" data-load-sample data-template="mythic-ancestry" style="justify-content:center;width:100%;">
                    Load mythic ancestry sample
                  </button>
                </div>
              )}
            </div>
          ) : (
            <>
              <div class="gotha-detail__chrome">
                <div class="gotha-detail__chrome-main">
                  <p class="gotha-detail__kind">
                    {focus.is_self ? "You" : "Person"}
                    {atlasSeedId ? " · linked to Atlas" : focus.atlas_entity_id ? " · Atlas entity" : ""}
                  </p>
                  <h2 class="gotha-detail__name">{focus.name}</h2>
                </div>
                <button
                  type="button"
                  class="gotha-detail__close"
                  data-close-detail
                  aria-label="Close person detail"
                  title="Close"
                >
                  ×
                </button>
              </div>
              <div class="gotha-detail__years">
                {focus.birth_year && (focus.birth_year < 0 ? `b. ${Math.abs(focus.birth_year)} BCE` : `b. ${focus.birth_year}`)}
                {focus.death_year && ` – d. ${focus.death_year}`}
                {focus.birth_place && ` · ${focus.birth_place}`}
              </div>
              {focus.family_name && <div style="margin-bottom:14px;"><span class="gotha-chip">{focus.family_name}</span></div>}
              {focus.notes && <p style="font-size:13px;color:var(--at-dim);margin-bottom:16px;line-height:1.5;">{focus.notes}</p>}

              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
                <button class="gotha-btn" type="button" data-toggle-edit>Edit</button>
                <button class="gotha-btn" type="button" data-delete-person={focus.id} style="color:#e08888;border-color:rgba(224,136,136,0.4);">Delete</button>
              </div>

              <div class="gotha-add-form" id="edit-person-form" style="display:none;margin:0 0 16px;">
                <form data-edit-form>
                  <input type="hidden" name="id" value={focus.id} />
                  <div class="gotha-field">
                    <label>Full name *</label>
                    <input name="name" required value={focus.name} />
                  </div>
                  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
                    <div class="gotha-field">
                      <label>Birth year</label>
                      <input name="birth_year" type="number" value={focus.birth_year ?? ""} />
                    </div>
                    <div class="gotha-field">
                      <label>Month</label>
                      <input name="birth_month" type="number" min="1" max="12" value={focus.birth_month ?? ""} />
                    </div>
                    <div class="gotha-field">
                      <label>Day</label>
                      <input name="birth_day" type="number" min="1" max="31" value={focus.birth_day ?? ""} />
                    </div>
                  </div>
                  <div class="gotha-field">
                    <label>Death year</label>
                    <input name="death_year" type="number" value={focus.death_year ?? ""} />
                  </div>
                  <div class="gotha-field">
                    <label>Family / surname</label>
                    <input name="family_name" value={focus.family_name ?? ""} />
                  </div>
                  <div class="gotha-field">
                    <label>Birth place</label>
                    <input name="birth_place" value={focus.birth_place ?? ""} />
                  </div>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                    <div class="gotha-field">
                      <label>Latitude</label>
                      <input name="birth_lat" type="number" step="any" value={focus.birth_lat ?? ""} placeholder="auto from place" />
                    </div>
                    <div class="gotha-field">
                      <label>Longitude</label>
                      <input name="birth_lng" type="number" step="any" value={focus.birth_lng ?? ""} placeholder="auto from place" />
                    </div>
                  </div>
                  <div class="gotha-field">
                    <label>Notes</label>
                    <textarea name="notes" rows="3">{focus.notes ?? ""}</textarea>
                  </div>
                  <div class="gotha-field" style="flex-direction:row;align-items:center;gap:8px;">
                    <input type="checkbox" name="is_self" id="edit-is-self" checked={focus.is_self} />
                    <label for="edit-is-self" style="text-transform:none;letter-spacing:0;font-size:12px;">This is me</label>
                  </div>
                  <div style="display:flex;gap:8px;margin-top:8px;">
                    <button class="gotha-btn gotha-btn--primary" type="submit" style="flex:1;justify-content:center;">Save changes</button>
                    <button class="gotha-btn" type="button" data-cancel-edit style="flex:1;justify-content:center;">Cancel</button>
                  </div>
                </form>
              </div>

              {zodiac && (
                <div class="gotha-section">
                  <h3>Western zodiac</h3>
                  <div class="gotha-sign">
                    <span class="gotha-sign__symbol">{zodiac.symbol}</span>
                    <div>
                      <div class="gotha-sign__name">{zodiac.name}</div>
                      <div class="gotha-sign__range">{zodiac.dateRange} · {zodiac.ruling} · {zodiac.element} · {zodiac.modality}</div>
                      <div class="gotha-sign__desc">{zodiac.description}</div>
                    </div>
                  </div>
                </div>
              )}

              {druid && (
                <div class="gotha-section">
                  <h3>Celtic Ogham tree</h3>
                  <div class="gotha-sign gotha-sign--druid">
                    <span class="gotha-sign__symbol">{druid.oghamLetter} {druid.symbol}</span>
                    <div>
                      <div class="gotha-sign__name">{druid.tree}</div>
                      <div class="gotha-sign__range">{druid.dateRange} · {druid.meaning}</div>
                      <div class="gotha-sign__desc">{druid.lore.slice(0, 180)}…</div>
                    </div>
                  </div>
                </div>
              )}

              {chinese && (
                <div class="gotha-section">
                  <h3>Chinese zodiac year</h3>
                  <div class="gotha-sign">
                    <span class="gotha-sign__symbol">{chinese.symbol}</span>
                    <div>
                      <div class="gotha-sign__name">{chinese.animal}</div>
                      <div class="gotha-sign__range">{chinese.element} year</div>
                      <div class="gotha-sign__desc">{chinese.description}</div>
                    </div>
                  </div>
                </div>
              )}

              {focus.family_name && (
                <div class="gotha-section">
                  <h3>Surname origin</h3>
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span style="font-size:13px;color:var(--gt-dim);">Look up "{focus.family_name}" in Wikidata</span>
                    <button class="gotha-btn" type="button" data-lookup-surname={focus.family_name}>Look up</button>
                  </div>
                  <div class="gotha-surname-result" id="surname-result" hidden></div>
                </div>
              )}

              <div class="gotha-section">
                <h3>Add relation</h3>
                <form data-rel-form style="display:flex;flex-direction:column;gap:8px;">
                  <div class="gotha-field">
                    <label>Other person</label>
                    <select name="other_person_id">
                      {persons.filter((p: any) => p.id !== focusId).map((p: any) => (
                        <option value={p.id}>{p.name}</option>
                      ))}
                    </select>
                  </div>
                  <div class="gotha-field">
                    <label>Relation type (from their perspective to you)</label>
                    <select name="rel">
                      <option value="parent">Parent of {focus.name}</option>
                      <option value="child">Child of {focus.name}</option>
                      <option value="partner">Partner of {focus.name}</option>
                      <option value="sibling">Sibling of {focus.name}</option>
                    </select>
                  </div>
                  <button class="gotha-btn gotha-btn--primary" type="submit" style="justify-content:center;">Add relation</button>
                </form>
              </div>

              {personRelations.length > 0 && (
                <div class="gotha-section">
                  <h3>All relations</h3>
                  {personRelations.map((r: any) => {
                    const other = r.from_person_id === focusId ? personById[r.to_person_id] : personById[r.from_person_id];
                    const dir = r.from_person_id === focusId ? "→" : "←";
                    return other ? (
                      <div class="gotha-rel-row">
                        <button class="gotha-rel" type="button" data-person={other.id}>
                          <div class="gotha-rel__meta">{r.rel} {dir}</div>
                          <div class="gotha-rel__name">{other.name}</div>
                        </button>
                        <button
                          class="gotha-btn"
                          type="button"
                          data-delete-relation={r.id}
                          title="Remove relation"
                          style="padding:4px 8px;font-size:11px;color:#e08888;border-color:rgba(224,136,136,0.35);"
                        >
                          Remove
                        </button>
                      </div>
                    ) : null;
                  })}
                </div>
              )}

              <div class="gotha-section">
                <h3>Ancestors</h3>
                <p style="font-size:12px;color:var(--gt-dim);margin:0 0 8px;">Multi-generation list from the family graph.</p>
                <div data-ancestors-root data-person-id={focus.id}>
                  <p style="font-size:12px;color:var(--gt-faint);margin:0;">Loading ancestors…</p>
                </div>
              </div>

              {atlasHref && (
                <div class="gotha-section">
                  <h3>Atlas connection</h3>
                  {atlasEntity && (
                    <p style="font-size:12px;color:var(--gt-dim);margin:0 0 8px;">
                      Seed · {atlasEntity.name} ({atlasEntity.kind})
                    </p>
                  )}
                  <a href={atlasHref} class="gotha-btn">
                    Open in Atlas →
                  </a>
                </div>
              )}
            </>
          )
        }
      </aside>
    </div>
  </div>

  <script type="application/json" id="gotha-boot-data" is:inline set:html={JSON.stringify({ mapPins, focusId })} />
  <script>
    import maplibregl from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";
    import { darkBasemapStyle } from "@/lib/atlas/basemap";

    const raw = document.getElementById("gotha-boot-data")?.textContent ?? "{}";
    const { mapPins, focusId } = JSON.parse(raw);

    document.querySelectorAll("[data-person]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-person");
        if (id) {
          const url = new URL(window.location.href);
          url.searchParams.set("p", id);
          window.location.href = url.toString();
        }
      });
    });

    const addForm = document.getElementById("add-person-form");
    document.querySelector("[data-close-detail]")?.addEventListener("click", () => {
      const url = new URL(window.location.href);
      url.searchParams.set("p", "");
      window.location.href = url.pathname + "?" + url.searchParams.toString();
    });

    document.querySelector("[data-toggle-add]")?.addEventListener("click", () => {
      if (addForm) addForm.style.display = addForm.style.display === "none" ? "block" : "none";
    });
    document.querySelector("[data-cancel-add]")?.addEventListener("click", () => {
      if (addForm) addForm.style.display = "none";
    });

    async function loadSample(btn) {
      const template = btn.getAttribute("data-template") || "habsburg";
      const label = btn.textContent;
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Loading sample…";
      }
      try {
        const res = await fetch("/api/gotha/sample", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ template }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || "Failed to load sample");
        const url = new URL(window.location.href);
        if (json.focusId) url.searchParams.set("p", json.focusId);
        window.location.href = url.toString();
      } catch (err) {
        alert(err instanceof Error ? err.message : "Failed to load sample");
        if (btn) {
          btn.disabled = false;
          btn.textContent = label;
        }
      }
    }

    document.querySelectorAll("[data-load-sample]").forEach((btn) => {
      btn.addEventListener("click", () => loadSample(btn));
    });

    document.querySelector("[data-add-form]")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = new FormData(form);
      const body = {
        name: data.get("name"),
        birth_year: data.get("birth_year") || null,
        birth_month: data.get("birth_month") || null,
        birth_day: data.get("birth_day") || null,
        family_name: data.get("family_name") || null,
        birth_place: data.get("birth_place") || null,
        birth_lat: data.get("birth_lat") || null,
        birth_lng: data.get("birth_lng") || null,
        is_self: form.querySelector('[name="is_self"]')?.checked,
      };
      try {
        const res = await fetch("/api/gotha/persons", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error);
        const url = new URL(window.location.href);
        url.searchParams.set("p", json.id);
        window.location.href = url.toString();
      } catch (err) {
        alert(err instanceof Error ? err.message : "Save failed");
      }
    });

    const editForm = document.getElementById("edit-person-form");
    document.querySelector("[data-toggle-edit]")?.addEventListener("click", () => {
      if (editForm) editForm.style.display = editForm.style.display === "none" ? "block" : "none";
    });
    document.querySelector("[data-cancel-edit]")?.addEventListener("click", () => {
      if (editForm) editForm.style.display = "none";
    });

    document.querySelector("[data-edit-form]")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = new FormData(form);
      const id = data.get("id");
      const body = {
        name: data.get("name"),
        birth_year: data.get("birth_year") || null,
        birth_month: data.get("birth_month") || null,
        birth_day: data.get("birth_day") || null,
        death_year: data.get("death_year") || null,
        family_name: data.get("family_name") || null,
        birth_place: data.get("birth_place") || null,
        birth_lat: data.get("birth_lat") || null,
        birth_lng: data.get("birth_lng") || null,
        notes: data.get("notes") || null,
        is_self: form.querySelector('[name="is_self"]')?.checked,
      };
      try {
        const res = await fetch(`/api/gotha/persons?id=${encodeURIComponent(String(id))}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || "Update failed");
        window.location.reload();
      } catch (err) {
        alert(err instanceof Error ? err.message : "Update failed");
      }
    });

    document.querySelector("[data-delete-person]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const id = btn?.getAttribute?.("data-delete-person");
      if (!id) return;
      if (!confirm("Delete this person and their relations?")) return;
      try {
        const res = await fetch(`/api/gotha/persons?id=${encodeURIComponent(id)}`, { method: "DELETE" });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json.error || "Delete failed");
        const url = new URL(window.location.href);
        url.searchParams.delete("p");
        window.location.href = url.toString();
      } catch (err) {
        alert(err instanceof Error ? err.message : "Delete failed");
      }
    });

    document.querySelector("[data-rel-form]")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = new FormData(form);
      const otherId = data.get("other_person_id");
      const rel = data.get("rel");
      const body = rel === "parent"
        ? { from_person_id: otherId, to_person_id: focusId, rel: "parent" }
        : rel === "child"
        ? { from_person_id: focusId, to_person_id: otherId, rel: "parent" }
        : { from_person_id: focusId, to_person_id: otherId, rel };
      try {
        const res = await fetch("/api/gotha/relations", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) { const j = await res.json(); throw new Error(j.error); }
        window.location.reload();
      } catch (err) {
        alert(err instanceof Error ? err.message : "Failed");
      }
    });

    document.querySelectorAll("[data-delete-relation]").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute("data-delete-relation");
        if (!id) return;
        if (!confirm("Remove this relation?")) return;
        try {
          const res = await fetch(`/api/gotha/relations?id=${encodeURIComponent(id)}`, { method: "DELETE" });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(json.error || "Remove failed");
          window.location.reload();
        } catch (err) {
          alert(err instanceof Error ? err.message : "Remove failed");
        }
      });
    });

    async function loadAncestors() {
      const root = document.querySelector("[data-ancestors-root]");
      if (!root) return;
      const personId = root.getAttribute("data-person-id");
      if (!personId) return;
      try {
        const res = await fetch(`/api/gotha/ancestors?person_id=${encodeURIComponent(personId)}&generations=6`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Failed");
        const rows = Array.isArray(data) ? data : [];
        const ancestors = rows.filter((row) => Number(row.generation ?? 0) > 0);
        if (!ancestors.length) {
          root.innerHTML = `<p style="font-size:12px;color:var(--gt-faint);margin:0;">No ancestors linked yet. Add parent relations to build the tree.</p>`;
          return;
        }
        const byGen = new Map();
        for (const row of ancestors) {
          const g = Number(row.generation ?? 1);
          if (!byGen.has(g)) byGen.set(g, []);
          byGen.get(g).push(row);
        }
        const gens = [...byGen.keys()].sort((a, b) => a - b);
        let html = `<div class="gotha-ancestors">`;
        for (const g of gens) {
          html += `<div class="gotha-ancestors__gen"><div class="gotha-ancestors__label">Generation ${g}</div>`;
          for (const row of byGen.get(g)) {
            const pid = row.person_id || row.ancestor_id || row.id;
            const name = row.name || "Unknown";
            html += `<button class="gotha-btn" type="button" data-person="${escAttr(pid)}" style="margin:0 4px 4px 0;">${escHtml(name)}</button>`;
          }
          html += `</div>`;
        }
        html += `</div>`;
        root.innerHTML = html;
        root.querySelectorAll("[data-person]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-person");
            if (!id) return;
            const url = new URL(window.location.href);
            url.searchParams.set("p", id);
            window.location.href = url.toString();
          });
        });
      } catch (err) {
        root.innerHTML = `<p style="font-size:12px;color:var(--gt-faint);margin:0;">${escHtml(err instanceof Error ? err.message : "Could not load ancestors")}.</p>`;
      }
    }

    function escHtml(s) {
      return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
    function escAttr(s) {
      return escHtml(s).replace(/"/g, "&quot;");
    }
    loadAncestors();

    document.querySelectorAll("[data-lookup-surname]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const name = btn.getAttribute("data-lookup-surname");
        const result = document.getElementById("surname-result");
        if (!result) return;
        result.textContent = "Looking up…";
        result.hidden = false;
        try {
          const res = await fetch(`/api/gotha/surname?name=${encodeURIComponent(name)}`);
          const data = await res.json();
          if (data.error) result.textContent = data.error;
          else {
            result.innerHTML = `<strong>${data.name}</strong>${data.wikidataId ? ` · Wikidata ${data.wikidataId}` : ""}${data.country ? `<br>Origin: ${data.country}` : ""}${data.description ? `<br>${data.description}` : ""}`;
          }
        } catch { result.textContent = "Lookup failed."; }
      });
    });

    function bootMap() {
      const host = document.getElementById("gotha-map");
      if (!host || host.dataset.booted === "1") return;
      host.dataset.booted = "1";

      const map = new maplibregl.Map({
        container: host,
        style: darkBasemapStyle,
        center: mapPins.length === 1
          ? [mapPins[0].birth_lng, mapPins[0].birth_lat]
          : [16.37, 48.21],
        zoom: mapPins.length ? 4 : 2.2,
      });

      map.on("error", (e) => {
        console.warn("[gotha map]", e?.error ?? e);
      });

      const bounds = [];
      mapPins.forEach((p) => {
        const isFocus = p.id === focusId;
        const el2 = document.createElement("div");
        el2.innerHTML = `<div style="width:${isFocus ? 18 : 12}px;height:${isFocus ? 18 : 12}px;border-radius:50%;background:#78c97a;border:2px solid #0d0f0e;box-shadow:0 0 0 ${isFocus ? 3 : 2}px rgba(120,201,122,0.4);cursor:pointer;" title="${p.name}"></div>`;
        const pin = el2.firstElementChild;
        pin?.addEventListener("click", () => {
          const url = new URL(window.location.href);
          url.searchParams.set("p", p.id);
          window.location.href = url.toString();
        });
        new maplibregl.Marker({ element: pin, anchor: "center" })
          .setLngLat([p.birth_lng, p.birth_lat])
          .addTo(map);
        bounds.push([p.birth_lng, p.birth_lat]);
      });

      map.on("load", () => {
        map.resize();
        if (bounds.length > 1) {
          const bb = bounds.reduce(
            (b, p) => [[Math.min(b[0][0], p[0]), Math.min(b[0][1], p[1])], [Math.max(b[1][0], p[0]), Math.max(b[1][1], p[1])]],
            [[180, 90], [-180, -90]],
          );
          map.fitBounds(bb, { padding: 60, maxZoom: 8 });
        }
      });

      requestAnimationFrame(() => map.resize());
    }

    bootMap();
  </script>
</NovelcrafterLayout>
