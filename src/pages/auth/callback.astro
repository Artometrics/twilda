---
export const prerender = false;

import { createSupabaseServerClient } from "@/lib/supabase/ssr";
import { ensureUserProfile } from "@/lib/auth/profile";
import { getSafeNextParam } from "@/lib/auth/session";

const code = Astro.url.searchParams.get("code");
const next = getSafeNextParam(Astro.url, "/novels/");

if (code) {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) {
    return Astro.redirect(`/forms/login/?error=${encodeURIComponent(error.message)}`);
  }

  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (user) {
    try {
      await ensureUserProfile(supabase, user);
    } catch {
      // Library page will retry; don't block login redirect.
    }
  }
}

return Astro.redirect(next);
---
