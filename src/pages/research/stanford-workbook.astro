---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import StanfordWorkbook from "@/components/research/StanfordWorkbook.astro";
---

<BaseLayout hideFooter={false}>
  <section class="pt-28 pb-16 min-h-screen bg-accent-50">
    <Wrapper variant="standard" class="max-w-5xl mx-auto">
      <Text
        tag="h1"
        variant="displaySM"
        class="font-semibold text-accent-900 mb-2"
      >
        Stanford: Cause or Filter?
      </Text>
      <Text tag="p" variant="textBase" class="text-accent-700 mb-8">
        A research instrument for testing the causal claim in the Cardinal thesis.
        <a href="/research/stanford-cause-or-filter/" class="underline ml-1">
          Read the published investigation →
        </a>
      </Text>
      <StanfordWorkbook />
    </Wrapper>
  </section>
</BaseLayout>

<style is:global>
  .swb-tab[aria-selected="true"] {
    background: #fff;
    font-weight: 600;
    border-bottom: 2px solid #1c1c1e;
  }
  .swb-tab {
    border: 1px solid #d5d5d5;
    border-bottom: none;
    background: #f2f0eb;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .swb-cell-input {
    background: #dbeafe;
    border: none;
    width: 100%;
    min-width: 4rem;
    padding: 0.35rem 0.5rem;
    font-size: 0.8rem;
  }
  .swb-cell-assumption {
    background: #fef08a;
  }
  .swb-cell-formula {
    background: #f4f4f5;
    color: #1c1c1e;
    font-weight: 500;
  }
  .swb-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.8rem;
  }
  .swb-table th,
  .swb-table td {
    border: 1px solid #93c5fd;
    padding: 0.25rem;
    vertical-align: top;
  }
  .swb-table th {
    background: #f2f0eb;
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
  }
  .swb-panel {
    display: none;
    border: 1px solid #d5d5d5;
    background: #fff;
    padding: 1.25rem;
  }
  .swb-panel.active {
    display: block;
  }
  .swb-verdict {
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.75rem;
    background: #f2f0eb;
    border: 1px solid #d5d5d5;
  }
  .swb-locked {
    filter: blur(4px);
    user-select: none;
    pointer-events: none;
  }
</style>
