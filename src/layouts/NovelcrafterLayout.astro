---
import "@/styles/global.css";
import "@/styles/novelcrafter.css";
import Fonts from "@/components/fundations/head/Fonts.astro";
interface Props {
  title?: string;
}
const { title = "Novels · Twilda" } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="nc-html scroll-smooth selection:bg-accent-800 selection:text-accent-200"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Fonts />
    <style is:global>
      html.nc-html,
      body.nc-body {
        margin: 0;
        background: var(--color-accent-950);
      }
    </style>
  </head>
  <body class="nc-body nc">
    <slot />
  </body>
</html>
