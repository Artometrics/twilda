---
import "@/styles/novelcrafter.css";
import Fonts from "@/components/fundations/head/Fonts.astro";
interface Props {
  title?: string;
}
const { title = "novelcrafter" } = Astro.props;
---

<!doctype html>
<html lang="en" class="nc-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <Fonts />
    <style is:global>
      html.nc-html,
      body.nc-body {
        margin: 0;
        background: #0e0f11;
      }
    </style>
  </head>
  <body class="nc-body nc">
    <slot />
  </body>
</html>
