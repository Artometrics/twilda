---
interface Props {
  active?: "novels" | "series" | "journal" | "account";
  userEmail?: string | null;
}
const { active = "novels", userEmail = null } = Astro.props;

const initial = userEmail?.[0]?.toUpperCase() ?? "?";
---

<header class="nc-topbar">
  <a class="nc-brand" href="/novels/">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" />
      <path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5A2.5 2.5 0 0 1 4 20.5z" />
    </svg>
    <span>Twilda</span>
  </a>
  <nav class="nc-topnav">
    <a class:list={[{ "is-active": active === "novels" }]} href="/novels/">Library</a>
    <a class:list={[{ "is-active": active === "journal" }]} href="/blog/">Journal</a>
    <a class:list={[{ "is-active": active === "series" }]} href="/novels/series/">Series</a>
  </nav>
  <div class="nc-topbar__spacer"></div>
  <div class="nc-topbar__right">
    {
      userEmail ? (
        <>
          <a
            href="/account/"
            class:list={["nc-topbar__account", { "is-active": active === "account" }]}
          >
            {userEmail}
          </a>
          <span class="nc-avatar-sm">{initial}</span>
        </>
      ) : (
        <a href="/forms/login/?redirect=/novels/">Log in</a>
      )
    }
  </div>
</header>

<style>
  .nc-topbar__account {
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
