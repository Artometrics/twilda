---
import BigLogo from "@/components/assets/BigLogo.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const footerLinks = [
  { label: "Library", url: "/novels/", ariaLabel: "Go to novel library" },
  { label: "Journal", url: "/blog/", ariaLabel: "Go to journal" },
  { label: "Account", url: "/account/", ariaLabel: "Go to account" },
  { label: "Terms", url: "/legal/terms/", ariaLabel: "Terms of service" },
  { label: "Privacy", url: "/legal/privacy/", ariaLabel: "Privacy policy" },
];
---

<footer class="overflow-hidden">
  <Wrapper variant="standard" class="pt-12 bg-accent-900 border-t">
    <div class="items-start pb-12 grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-32 lg:pb-24">
      <div class="flex flex-col max-w-xl gap-6 lg:col-span-2">
        <Text
          tag="h2"
          variant="displayLG"
          class="font-semibold tracking-tight text-white lg:text-5xl"
        >
          Twilda
        </Text>
        <p class="text-xl font-normal text-white">
          Artometrics <span>© {new Date().getFullYear()}. Personal novel workspace.</span>
        </p>
      </div>
      <nav
        class="flex flex-col justify-between text-base text-white gap-y-4"
        role="navigation"
      >
        {
          footerLinks.map((link) => (
            <a class="hover:text-accent-300" href={link.url} aria-label={link.ariaLabel}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="pb-8">
      <BigLogo class="text-white opacity-20" />
    </div>
  </Wrapper>
</footer>
