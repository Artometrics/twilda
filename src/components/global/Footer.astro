---
import BigLogo from "@/components/assets/BigLogo.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import XBrand from "@/components/fundations/icons/XBrand.astro";

const footerLinks = [
  { label: "Novels", url: "/novels/", ariaLabel: "Go to novels" },
  { label: "Atlas", url: "/atlas/?scene=vienna-1913", ariaLabel: "Open Atlas research map" },
  { label: "Pricing", url: "/#pricing-section", ariaLabel: "View pricing" },
  { label: "Research", url: "/research/", ariaLabel: "Research investigations" },
  { label: "Help Center", url: "/helpcenter/", ariaLabel: "Help center" },
  { label: "Terms", url: "/legal/terms/", ariaLabel: "Terms of service" },
  { label: "Privacy", url: "/legal/privacy/", ariaLabel: "Privacy policy" },
];
---

<footer class="overflow-hidden">
  <Wrapper variant="standard" class="pt-12 bg-accent-900 border-t">
    <div
      class="items-start pb-12 grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-32 lg:pb-48"
    >
      <div class="flex flex-col max-w-xl gap-6 lg:col-span-2">
        <div>
          <Text
            tag="h2"
            variant="displayLG"
            class="font-semibold tracking-tight text-white lg:text-5xl"
          >
            Write with focus. Ship your draft with confidence.
          </Text>
          <form
            class="justify-between mt-4 sm:flex gap-2"
            action="/forms/signup/"
            method="get"
          >
            <label class="sr-only" for="footer-email">Email address</label>
            <input
              autocomplete="email"
              class="w-full px-5 py-3 text-sm text-center placeholder-black bg-white border-2 rounded-full shadow h-14 border-accent-400 lg:text-left focus:ring-black focus:border-white shadow-accent-400 focus:shadow-none duration-300 focus:translate-y-1"
              id="footer-email"
              name="email"
              placeholder="Enter your email"
              type="email"
            />
            <Button isLink={true} href="/forms/signup/" size="xl" variant="accent">
              Get started
            </Button>
          </form>

          <div class="flex flex-col mt-4 gap-6">
            <p class="text-xl font-normal text-white">
              Artometrics <span>© {new Date().getFullYear()}. Twilda. All rights reserved.</span>
            </p>
            <div class="flex flex-wrap gap-2">
              <Button
                isLink={true}
                iconOnly
                size="sm"
                variant="accent"
                href="https://x.com/twilda"
              >
                <XBrand slot="icon" size="sm" />
                <span class="sr-only">Follow on X</span>
              </Button>
            </div>
          </div>
        </div>
      </div>
      <nav
        class="flex flex-col justify-between text-base text-white gap-y-4"
        role="navigation"
      >
        {
          footerLinks.map((link) => (
            <a class="hover:text-accent-300" href={link.url} aria-label={link.ariaLabel}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <BigLogo class="text-white lg:-mb-6" />
  </Wrapper>
</footer>
