---
// Assets
import { Image } from "astro:assets";
import Blob1 from "@/images/blobs/blob1.svg";
import Blob2 from "@/images/blobs/blob2.svg";
import Blob3 from "@/images/blobs/blob3.svg";
import Blob4 from "@/images/blobs/blob4.svg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="relative overflow-hidden">
  <Wrapper variant="standard" class="relative py-32 overflow-hidden lg:py-64">
    <Image
      width={800}
      height={800}
      loading="eager"
      decoding="async"
      src={Blob1}
      alt="#_"
      class="absolute hidden rounded-full lg:block shadow-accent-900 size-84 -bottom-24 right-20"
    />
    <Image
      width={800}
      height={800}
      loading="eager"
      decoding="async"
      src={Blob2}
      alt="#_"
      class="absolute hidden rounded-full lg:block shadow-accent-900 size-84 bottom-32 -right-32"
    />
    <Image
      width={800}
      height={800}
      loading="eager"
      decoding="async"
      src={Blob3}
      alt="#_"
      class="absolute hidden rounded-full lg:block shadow-accent-900 size-84 -bottom-20 left-32"
    />
    <Image
      width={800}
      height={800}
      loading="eager"
      decoding="async"
      src={Blob4}
      alt="#_"
      class="absolute hidden rounded-full lg:block shadow-accent-900 size-100 bottom-24 -left-20"
    />

    <div class="relative max-w-2xl mx-auto text-center">
      <Text
        tag="h1"
        variant="displayXL"
        class="font-semibold tracking-tight text-accent-900 text-balance"
      >
        Write your novel in one calm workspace
      </Text>
      <Text
        tag="p"
        variant="textLG"
        class="mt-4 text-accent-900 text-balance font-medium"
      >
        Plan chapters, draft scenes, build your Codex, and chat with an AI that
        knows your story — all in Twilda.
      </Text>
      <Button
        isLink={true}
        href="/forms/signup/"
        size="xl"
        variant="accent"
        class="mx-auto mt-8 w-fit">Start writing free</Button
      >
    </div>
  </Wrapper>
</section>
