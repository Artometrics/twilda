---
// Assets
import { Image } from "astro:assets";
import Blob1 from "@/images/blobs/blob1.svg";
import Blob4 from "@/images/blobs/blob4.svg";
import Blob3 from "@/images/blobs/blob3.svg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const features = [
  {
    image: Blob1,
    title: "Distraction-free writing",
    description:
      "A focused Write mode with autosave so you can stay in flow without worrying about losing work.",
  },
  {
    image: Blob4,
    title: "Story-aware AI",
    description:
      "Chat and Review use your synopsis, Codex, and manuscript so suggestions stay on-brand.",
  },
  {
    image: Blob3,
    title: "Export anywhere",
    description:
      "Download clean .txt or .md exports whenever you need to share, submit, or back up.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24 bg-accent-900">
    <div class="max-w-xl mx-auto lg:text-center text-balance">
      <Text
        tag="h2"
        variant="displayLG"
        class="font-semibold tracking-tight text-white"
      >
        Everything you need to finish your novel
      </Text>
      <Text tag="p" variant="textLG" class="mt-4 text-base-400">
        Twilda keeps planning, drafting, and revision in one calm workspace—from first scene to final export.
      </Text>
    </div>
    <div
      class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:text-center lg:grid-cols-3 gap-6 lg:gap-12"
    >
      {
        features.map((feature) => (
          <div>
            <Image
              width={800}
              height={800}
              src={feature.image}
              alt="#_"
              class="lg:mx-auto size-12 "
            />
            <Text
              tag="h3"
              variant="displaySM"
              class="font-medium text-secondary-400 mt-8"
            >
              {feature.title}
            </Text>
            <Text
              tag="p"
              variant="textLG"
              class="mt-4 text-white  text-balance"
            >
              {feature.description}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
