---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const platformFeatures = [
  {
    title: "Cloud library",
    description:
      "Every novel syncs to your account so you can write on any device and return later.",
  },
  {
    title: "Autosave",
    description: "Scene edits save automatically while you write—no manual save button.",
  },
  {
    title: "Import & export",
    description:
      "Bring in plain-text drafts and export finished manuscripts as .txt or .md.",
  },
  {
    title: "Writing prompts",
    description:
      "Browse curated prompts and send them straight into Chat for your current novel.",
  },
  {
    title: "AI credits",
    description:
      "Monthly Chat and Review credits scale with your plan—upgrade when you need more.",
  },
  {
    title: "Series view",
    description: "Group novels into series and manage multiple projects in one place.",
  },
  {
    title: "Secure auth",
    description: "Email sign-in with optional OAuth and row-level security on all data.",
  },
  {
    title: "Billing portal",
    description: "Upgrade, manage, or cancel your subscription from your account.",
  },
  {
    title: "Help center",
    description: "Guides for getting started, Codex, exports, billing, and AI features.",
  },
  {
    title: "Dark workspace",
    description: "A calm, low-glare editor designed for long writing sessions.",
  },
  {
    title: "Starter novel",
    description:
      "New accounts get a sample manuscript so you can explore Plan, Write, and Codex.",
  },
  {
    title: "Netlify hosting",
    description:
      "Fast global delivery with SSR where it matters—auth, library, and autosave APIs.",
  },
];
---

<section>
  <Wrapper variant="standardPaddingless" class="border-t-8">
    <div
      class="grid grid-cols-1 lg:grid-cols-2 lg:divide-x-8 lg:divide-accent-900"
    >
      <div class="p-8 lg:px-20 bg-accent-200">
        <div class="py-16 lg:sticker lg:sticky top-20">
          <div>
            <Text
              tag="h2"
              variant="displayLG"
              class="font-semibold tracking-tight text-accent-900 text-balance"
            >
              Build and run your writing workspace
            </Text>
            <Text
              tag="p"
              variant="textLG"
              class="max-w-md mt-4 text-lg text-accent-900 xl:text-xl"
            >
              Plan, draft, and revise in one place. Keep characters and lore in your Codex, autosave every scene, and use AI when you need a nudge.
              <br />
              <br />
              From first signup to final export, Twilda keeps your novel calm, organized, and always in sync.
            </Text>

            <Button
              isLink={true}
              href="/forms/signup/"
              size="xl"
              variant="default"
              class="mt-8 w-fit">Start writing free</Button
            >
          </div>
        </div>
      </div>
      <ul
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-2 gap-2 bg-accent-900 list-none"
        role="list"
      >
        {
          platformFeatures.map((feature, index) => (
            <li class="p-8 bg-white lg:p-12">
              <div>
                <div class="flex items-center justify-center font-semibold border-2 border-accent-900 rounded-full size-10 shadow-xs duration-300 shadow-accent-900  bg-accent-200">
                  {index + 1}
                </div>
                <Text
                  tag="h3"
                  variant="textXL"
                  class="mt-8 font-medium text-accent-900 "
                >
                  {feature.title}
                </Text>
              </div>
              <Text tag="p" variant="textBase" class="mt-4 text-accent-900 ">
                {feature.description}
              </Text>
            </li>
          ))
        }
      </ul>
    </div>
  </Wrapper>
</section>
