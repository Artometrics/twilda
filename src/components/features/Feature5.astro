---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const features = [
  {
    title: "Plan mode",
    description:
      "See your full outline with chapter and scene word counts. Add structure as your story grows.",
    bgColor: "border-b-8 lg:border-r-8 border-accent-900 bg-accent-200",
  },
  {
    title: "Codex",
    description:
      "Track characters, locations, lore, and aliases with searchable entries tied to your novel.",
    bgColor:
      "border-b-8 lg:border-r-8 border-accent-900 bg-secondary-500 text-white",
  },
  {
    title: "Snippets",
    description:
      "Save reusable phrases, descriptions, and notes you can drop into any scene.",
    bgColor: "border-b-8  border-accent-900 bg-white",
  },
  {
    title: "Chat",
    description:
      "Brainstorm plot twists, dialogue, and pacing with an assistant that knows your story.",
    bgColor:
      "border-b-8 lg:border-r-8 border-accent-900 lg:border-b-0 bg-white",
  },
  {
    title: "Review",
    description:
      "Run consistency checks across your manuscript and Codex before you share or submit.",
    bgColor:
      "border-b-8 lg:border-r-8 border-accent-900 lg:border-b-0 bg-accent-200",
  },
  {
    title: "Atlas",
    description:
      "Research people, places, works, and ideas on a map and timeline — from Frida’s houses to the museum holding a painting.",
    bgColor:
      "border-b-8  lg:border-b-0 border-accent-900 bg-secondary-500 text-white",
  },
];
---

<section>
  <Wrapper variant="standardPaddingless">
    <div class="grid grid-cols-1 lg:grid-cols-3">
      {
        features.map((card) => (
          <div class={`p-8 lg:p-12 ${card.bgColor}`}>
            <Text
              tag="h3"
              variant="displaySM"
              class="font-semibold tracking-tight"
            >
              {card.title}
            </Text>
            <Text
              tag="p"
              variant="textLG"
              class="mt-4 font-medium text-balance"
            >
              {card.description}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
