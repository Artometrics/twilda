---
// Assets
import { Image } from "astro:assets";
import Blob2 from "@/images/blobs/blob2.svg";
import Blob3 from "@/images/blobs/blob3.svg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const features = [
  {
    title: "Teamwide visibility",
    description:
      "Roll up work by owner, priority, and department with export-ready reporting.",
    image: Blob2,
    bgColor: "bg-accent-200",
  },
  {
    title: "Guardrails baked in",
    description:
      "Automations with required steps, approvals, and checklists so nothing slips.",
    image: Blob3,
    bgColor: "bg-secondary-500",
  },
];
---

<section>
  <Wrapper
    variant="standardPaddingless"
    class="border-t-8 divide-y-8 divide-accent-900"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-2 divide-y-8 divide-accent-900 md:divide-y-0 md:divide-x-8"
    >
      {
        features.map((feature) => (
          <div class="grid grid-cols-1 divide-y-8 divide-accent-900">
            <div class="relative items-center h-full p-8 py-12 bg-white lg:px-20 gap-12 lg:inline-flex">
              <div class="max-w-xl mx-auto text-center">
                <Text
                  tag="h2"
                  variant="displayMD"
                  class="font-semibold tracking-tight text-accent-900"
                >
                  {feature.title}
                </Text>
                <Text
                  tag="p"
                  variant="textLG"
                  class="mt-4 font-normal text-accent-900  text-balance"
                >
                  {feature.description}
                </Text>
              </div>
            </div>
            <div
              class={`block w-full aspect-square lg:mt-0 ${feature.bgColor} h-full flex flex-col justify-center items-center`}
            >
              <Image
                class="size-24 lg:size-82"
                width={800}
                height={800}
                loading="eager"
                decoding="async"
                src={feature.image}
                alt="#_"
              />
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
