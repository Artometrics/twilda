---
// Assets
import { Image } from "astro:assets";
import Collab from "@/images/assets/collab.svg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const features = [
  {
    title: "Codex that grows with you",
    description:
      "Track characters, locations, and lore. Search entries while you write and open detail panels in one click.",
  },
  {
    title: "AI that knows your story",
    description:
      "Chat and Review modes use your manuscript and Codex as context — metered by plan so you stay in control.",
  },
  {
    title: "Cloud save, anywhere",
    description:
      "Your novels sync to your account. Pick up on any device without losing scenes, metadata, or custom entries.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24 border-t-8 bg-accent-900">
    <Text
      tag="h2"
      variant="displayXL"
      class="font-semibold tracking-tight text-white text-center"
    >
      Writing tools that stay organized
    </Text>
    <Image
      width={800}
      height={800}
      loading="eager"
      decoding="async"
      src={Collab}
      class="object-cover object-top w-full mt-12 bg-white border-2 border-accent-900 lg:rounded-full h-96"
      alt="#_"
    />
    <div
      class="mt-24 grid grid-cols-1 md:grid-cols-2 lg:text-center lg:grid-cols-3 gap-6 lg:gap-12"
    >
      {
        features.map((feature) => (
          <div>
            <Text
              tag="h3"
              variant="displaySM"
              class="font-medium text-secondary-400"
            >
              {feature.title}
            </Text>
            <Text
              tag="p"
              variant="textLG"
              class="mt-4 text-white  text-balance"
            >
              {feature.description}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
