---
// Components
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";
const pricingOptions = [
  {
    cardClass: "bg-white",
    primaryTextColor: "text-accent-900",
    secondaryTextColor: "text-accent-900",
    featuresBorderColor: "border-accent-900",
    title: "Team",
    monthly: "$29.00",
    description: "For small teams standardizing intake, routing, and approvals.",
    button: {
      text: "Start free",
      variant: "default",
    },
    features: [
      { text: "Unlimited request types and forms" },
      { text: "Routing rules and assignees" },
      { text: "Board and calendar views" },
      { text: "SLA timers and reminders" },
      { text: "Checklists and comment threads" },
      { text: "Email + in-app notifications" },
      { text: "CSV export" },
    ],
  },
  {
    cardClass: "bg-accent-300",
    primaryTextColor: "text-accent-900",
    secondaryTextColor: "text-accent-900",
    featuresBorderColor: "border-accent-900",
    title: "Growth",
    monthly: "$69.00",
    description: "For departments coordinating operations across IT, HR, and finance.",
    button: {
      text: "Start trial",
      variant: "default",
    },
    features: [
      { text: "Conditional form logic" },
      { text: "Multi-step approvals with fallbacks" },
      { text: "Team queues and private queues" },
      { text: "Advanced automations" },
      { text: "Knowledge base and snippets" },
      { text: "Dashboards for cycle time and volume" },
      { text: "Slack/Teams notifications" },
      { text: "Jira/Linear/Trello sync" },
      { text: "HRIS + SSO (Google/Okta)" },
      { text: "Chat + email support" },
    ],
  },
  {
    cardClass: "bg-secondary-500",
    primaryTextColor: "text-white",
    secondaryTextColor: "text-white",
    featuresBorderColor: "border-accent-900",
    title: "Enterprise",
    monthly: "$99.00",
    description:
      "For organizations with compliance needs and complex workflows.",
    button: {
      text: "Talk to sales",
      variant: "default",
    },
    features: [
      { text: "Custom SLA policies and escalation paths" },
      { text: "Audit trail exports and retention controls" },
      { text: "SCIM provisioning + SSO enforcement" },
      { text: "Data residency options" },
      { text: "Dedicated environment and sandbox" },
      { text: "Security reviews and DPA" },
      { text: "Named customer success + onboarding" },
    ],
  },
];
---

<section id="pricing-section">
  <Wrapper variant="standardPaddingless" class="pt-24">
    <div class="max-w-xl mx-auto text-center text-balance">
      <Text
        tag="h2"
        variant="displayLG"
        class="font-semibold tracking-tight text-accent-900"
      >
        Plans for teams that need requests to move
      </Text>
      <Text tag="p" variant="textLG" class="mt-4 text-accent-900">
        Start free. Scale as intake, approvals, and automations expand across teams.
      </Text>
    </div>
    <!-- Pricing Cards -->

    <div
      class="mt-24 border-t-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 divide-y-8 divide-accent-900 lg:divide-y-0 lg:divide-x-8"
    >
      {
        pricingOptions.map((tier) => (
          <div
            class={`flex flex-col h-full justify-between  ${tier.cardClass}`}
          >
            <div class="flex flex-col ">
              <div class="p-8 ">
                <Text
                  tag="h3"
                  variant="displaySM"
                  class={`font-medium text-accent-900 ${tier.primaryTextColor}`}
                >
                  {tier.title}
                </Text>
                <Text
                  variant="displayXL"
                  class={`font-semibold flex items-baseline tracking-tight  mt-12 ${tier.primaryTextColor}`}
                >
                  <span>{tier.monthly}</span>
                  <span
                    class={`text-sm font-normal tracking-normal ${tier.secondaryTextColor}`}
                  >
                    /month
                  </span>
                </Text>
                <Text
                  tag="p"
                  variant="textLG"
                  class={`mt-2 font-medium text-balance ${tier.secondaryTextColor}`}
                >
                  {tier.description}
                </Text>
              </div>
              <div class={`mt-4 p-8 border-t-4 ${tier.featuresBorderColor}  `}>
                <Text
                  tag="p"
                  variant="textXL"
                  class={`font-semibold uppercase ${tier.secondaryTextColor}`}
                >
                  What's included:
                </Text>
                <ul
                  class={`flex flex-col mt-4 text-lg font-medium  gap-y-2 ${tier.primaryTextColor}`}
                  role="list"
                >
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-2">
                      <Check
                        size="base"
                        class={`shrink-0 ${tier.secondaryTextColor}`}
                      />
                      <span>{feature.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div class=" p-8">
              <Button class="w-full" variant={tier.button.variant} size="xl">
                {tier.button.text}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
