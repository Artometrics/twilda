---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Check from "@/components/fundations/icons/Check.astro";

const pricingOptions = [
  {
    cardClass: "bg-white",
    primaryTextColor: "text-accent-900",
    secondaryTextColor: "text-accent-900",
    featuresBorderColor: "border-accent-900",
    title: "Free",
    monthly: "$0",
    description: "For writers starting their first manuscript.",
    button: {
      text: "Start free",
      variant: "default",
      href: "/forms/signup/",
    },
    features: [
      { text: "Up to 2 novels" },
      { text: "Plan, Write, and Codex" },
      { text: "5 AI credits per month" },
      { text: "Export to .txt and .md" },
      { text: "Writing prompts library" },
    ],
  },
  {
    cardClass: "bg-accent-300",
    primaryTextColor: "text-accent-900",
    secondaryTextColor: "text-accent-900",
    featuresBorderColor: "border-accent-900",
    title: "Pro",
    monthly: "$19",
    description: "For serious writers who need AI and unlimited projects.",
    button: {
      text: "Start Pro trial",
      variant: "default",
      href: "/forms/signup/?plan=pro",
    },
    features: [
      { text: "Unlimited novels" },
      { text: "50 AI credits per month" },
      { text: "Story-aware Chat and Review" },
      { text: "Snippets and saved chats" },
      { text: "Series organization" },
      { text: "Priority support" },
    ],
  },
  {
    cardClass: "bg-secondary-500",
    primaryTextColor: "text-white",
    secondaryTextColor: "text-white",
    featuresBorderColor: "border-accent-900",
    title: "Studio",
    monthly: "$49",
    description: "For authors and small teams with advanced workflows.",
    button: {
      text: "Talk to us",
      variant: "default",
      href: "/forms/contact/?subject=studio",
    },
    features: [
      { text: "Everything in Pro" },
      { text: "200 AI credits per month" },
      { text: "Collaboration (coming soon)" },
      { text: "Custom export formats" },
      { text: "Dedicated onboarding" },
      { text: "SLA and invoicing" },
    ],
  },
];
---

<section id="pricing-section">
  <Wrapper variant="standardPaddingless" class="pt-24">
    <div class="max-w-xl mx-auto text-center text-balance">
      <Text
        tag="h2"
        variant="displayLG"
        class="font-semibold tracking-tight text-accent-900"
      >
        Plans for writers at every stage
      </Text>
      <Text tag="p" variant="textLG" class="mt-4 text-accent-900">
        Start free with cloud save. Upgrade for more AI credits and unlimited novels.
      </Text>
      <Button
        isLink={true}
        href="/forms/signup/?plan=pro"
        size="sm"
        variant="accent"
        class="mt-6"
        data-checkout-pro
      >
        Start Pro trial
      </Button>
    </div>

    <div
      class="mt-24 border-t-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 divide-y-8 divide-accent-900 lg:divide-y-0 lg:divide-x-8"
    >
      {
        pricingOptions.map((tier) => (
          <div class={`flex flex-col h-full justify-between ${tier.cardClass}`}>
            <div class="flex flex-col">
              <div class="p-8">
                <Text
                  tag="h3"
                  variant="displaySM"
                  class={`font-medium ${tier.primaryTextColor}`}
                >
                  {tier.title}
                </Text>
                <Text
                  variant="displayXL"
                  class={`font-semibold flex items-baseline tracking-tight mt-12 ${tier.primaryTextColor}`}
                >
                  <span>{tier.monthly}</span>
                  {tier.monthly !== "$0" && (
                    <span
                      class={`text-sm font-normal tracking-normal ${tier.secondaryTextColor}`}
                    >
                      /month
                    </span>
                  )}
                </Text>
                <Text
                  tag="p"
                  variant="textLG"
                  class={`mt-2 font-medium text-balance ${tier.secondaryTextColor}`}
                >
                  {tier.description}
                </Text>
              </div>
              <div class={`mt-4 p-8 border-t-4 ${tier.featuresBorderColor}`}>
                <Text
                  tag="p"
                  variant="textXL"
                  class={`font-semibold uppercase ${tier.secondaryTextColor}`}
                >
                  What's included:
                </Text>
                <ul
                  class={`flex flex-col mt-4 text-lg font-medium gap-y-2 ${tier.primaryTextColor}`}
                  role="list"
                >
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-2">
                      <Check
                        size="base"
                        class={`shrink-0 ${tier.secondaryTextColor}`}
                      />
                      <span>{feature.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div class="p-8">
              <Button
                isLink={true}
                href={tier.button.href}
                class="w-full"
                variant={tier.button.variant}
                size="xl"
              >
                {tier.button.text}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>

<script>
  document.querySelector("[data-checkout-pro]")?.addEventListener("click", async (event) => {
    event.preventDefault();
    const res = await fetch("/api/billing/checkout/?plan=pro", { method: "POST" });
    const data = await res.json();
    if (data.url) {
      window.location.href = data.url;
      return;
    }
    window.location.href = "/forms/signup/?plan=pro";
  });
</script>
