---
/** Interactive 4-tab workbook matching the Stanford cause-or-filter spreadsheet. */
---

<div id="stanford-workbook" class="rounded-lg overflow-hidden shadow-sm border border-accent-200">
  <div class="flex border-b border-accent-200 bg-accent-100" role="tablist">
    <button class="swb-tab" role="tab" data-tab="readme" aria-selected="true">README</button>
    <button class="swb-tab" role="tab" data-tab="data">DATA</button>
    <button class="swb-tab" role="tab" data-tab="analysis">ANALYSIS</button>
    <button class="swb-tab" role="tab" data-tab="falsifier">FALSIFIER</button>
  </div>

  <!-- README -->
  <div id="panel-readme" class="swb-panel active" role="tabpanel">
    <p class="text-sm font-bold uppercase tracking-wide mb-1">Stanford: Cause or Filter?</p>
    <p class="text-sm italic text-accent-700 mb-4">
      A research instrument for testing the causal claim in the Cardinal thesis.
    </p>
    <p class="text-sm font-semibold mb-1">THE QUESTION</p>
    <p class="text-sm mb-4">
      Does Stanford <strong>MAKE</strong> these people, or does it <strong>COLLECT</strong> people
      who were already going to win? Your thesis requires the first answer. This workbook tests it.
    </p>
    <p class="text-sm font-semibold mb-1">HOW TO USE</p>
    <ol class="text-sm list-decimal ml-5 mb-4 space-y-1">
      <li>Fill the <strong>DATA</strong> tab (one row per person, requires a source URL).</li>
      <li>Set <strong>Verified = Y</strong> only after personal verification. Only verified rows count in <strong>ANALYSIS</strong>.</li>
      <li>Fill the base rate on the <strong>ANALYSIS</strong> tab using IPEDS data.</li>
      <li>Write a falsifier on the <strong>FALSIFIER</strong> tab and date it <em>before</em> looking at the verdict.</li>
    </ol>
    <p class="text-sm font-semibold mb-1">THE THREE NUMBERS</p>
    <ul class="text-sm list-disc ml-5 mb-4 space-y-1">
      <li><strong>A. Raw share</strong> — % of tech billionaires who attended Stanford.</li>
      <li><strong>B. Base-rate ratio</strong> — raw share ÷ Stanford's share of the engineering/CS pipeline (e.g. 0.5% pipeline, 20% outcomes → 40×).</li>
      <li><strong>C. THE WEALTH CONTROL</strong> — Stanford rate among low-wealth (tier 1–2) vs high-wealth (tier 3–4) founders. If the edge holds for low-wealth → <strong>CAUSE</strong>. If it vanishes → <strong>FILTER</strong>.</li>
    </ul>
    <p class="text-sm font-semibold mb-1">RULES OF EVIDENCE</p>
    <ul class="text-sm list-disc ml-5 mb-4 space-y-1">
      <li>Define the population before you start. Do not filter mid-collection.</li>
      <li>Do not skip inconvenient rows.</li>
      <li>Do not fill cells from memory or AI — use a source or leave blank.</li>
      <li>Wealth tier is a judgment call; always write <em>why</em> in the tier column.</li>
    </ul>
    <p class="text-xs text-accent-600">
      <span class="inline-block w-3 h-3 bg-blue-200 align-middle mr-1"></span> Blue = your input &nbsp;
      <span class="inline-block w-3 h-3 bg-yellow-200 align-middle mr-1"></span> Yellow = key assumption &nbsp;
      <span class="inline-block w-3 h-3 bg-zinc-200 align-middle mr-1"></span> Grey = formula (do not edit)
    </p>
  </div>

  <!-- DATA -->
  <div id="panel-data" class="swb-panel" role="tabpanel">
    <p class="text-xs font-semibold uppercase mb-1">
      Population rule (write it here BEFORE you collect a single row):
    </p>
    <textarea
      id="swb-population-rule"
      class="swb-cell-input w-full mb-4 text-sm min-h-[3rem]"
      placeholder="e.g. All US-resident billionaires on the current Forbes list whose primary wealth source is tech/software/internet."
    ></textarea>
    <div class="overflow-x-auto">
      <table class="swb-table" id="swb-data-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Company</th>
            <th>Undergrad</th>
            <th>Grad school</th>
            <th>Stanford? (1/0)</th>
            <th>Completed degree?</th>
            <th>Wealth tier (1–4)</th>
            <th>Why that tier</th>
            <th>Source URL</th>
            <th>Verified (Y/N)</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="swb-data-body"></tbody>
      </table>
    </div>
    <button
      type="button"
      id="swb-add-row"
      class="mt-3 text-sm px-3 py-1.5 border border-accent-300 rounded hover:bg-accent-100"
    >
      + Add row
    </button>
    <aside class="mt-4 p-3 bg-accent-50 border border-accent-200 text-xs max-w-md">
      <p class="font-bold mb-1">WEALTH TIER KEY</p>
      <p><strong>1</strong> — poor / working class / immigrant, no connections</p>
      <p><strong>2</strong> — middle class, no elite access</p>
      <p><strong>3</strong> — professional class (doctors, professors, lawyers)</p>
      <p><strong>4</strong> — wealthy and/or already connected to elite networks</p>
    </aside>
  </div>

  <!-- ANALYSIS -->
  <div id="panel-analysis" class="swb-panel" role="tabpanel">
    <p class="text-xs text-accent-600 mb-3">
      Counts <strong>VERIFIED</strong> rows only (Verified = Y). Unverified data does not exist here.
    </p>
    <div id="swb-analysis-locked-note" class="hidden text-sm text-red-700 mb-3 font-medium">
      Complete the FALSIFIER tab before viewing the verdict.
    </div>
    <table class="swb-table max-w-2xl mb-4">
      <tbody>
        <tr><td colspan="2" class="font-bold bg-accent-100">A. RAW COUNT</td></tr>
        <tr><td>Verified people in sample (N)</td><td class="swb-cell-formula" id="a-n">—</td></tr>
        <tr><td>Of those, Stanford-affiliated</td><td class="swb-cell-formula" id="a-stanford">—</td></tr>
        <tr>
          <td>Stanford share of sample</td>
          <td class="swb-cell-formula" id="a-share">—</td>
        </tr>
        <tr><td colspan="2" class="text-xs italic text-accent-600">This is the number everyone quotes. Alone, it proves nothing.</td></tr>
        <tr><td colspan="2" class="font-bold bg-accent-100 pt-2">B. BASE RATE</td></tr>
        <tr>
          <td>Stanford share of US engineering/CS degrees, 1975–2005</td>
          <td>
            <input type="text" id="b-base-rate" class="swb-cell-input swb-cell-assumption w-24" value="0.50%" />
          </td>
        </tr>
        <tr><td>Overrepresentation ratio</td><td class="swb-cell-formula" id="b-ratio">—</td></tr>
        <tr><td colspan="2" class="text-xs italic text-accent-600">Stanford's share of outcomes ÷ share of pipeline.</td></tr>
        <tr><td colspan="2" class="font-bold bg-accent-100 pt-2">C. THE WEALTH CONTROL ← the test that decides the thesis</td></tr>
        <tr><td>LOW-wealth founders (tier 1–2): count</td><td class="swb-cell-formula" id="c-low-n">—</td></tr>
        <tr><td>…of whom Stanford</td><td class="swb-cell-formula" id="c-low-stanford">—</td></tr>
        <tr><td>Stanford rate among LOW-wealth</td><td class="swb-cell-formula" id="c-low-rate">—</td></tr>
        <tr><td>HIGH-wealth founders (tier 3–4): count</td><td class="swb-cell-formula" id="c-high-n">—</td></tr>
        <tr><td>…of whom Stanford</td><td class="swb-cell-formula" id="c-high-stanford">—</td></tr>
        <tr><td>Stanford rate among HIGH-wealth</td><td class="swb-cell-formula" id="c-high-rate">—</td></tr>
      </tbody>
    </table>
    <p class="font-bold text-sm mb-1">VERDICT</p>
    <div id="swb-verdict" class="swb-verdict swb-locked">NOT ENOUGH DATA — keep going</div>
    <aside class="mt-4 text-xs max-w-lg text-accent-700 border-l-2 border-accent-300 pl-3">
      <p class="font-bold mb-1">HOW TO GET THE BASE RATE</p>
      <ol class="list-decimal ml-4 space-y-0.5">
        <li>Go to nces.ed.gov/ipeds → Use the Data → Complete Data Files.</li>
        <li>Download COMPLETIONS (C) for years you care about.</li>
        <li>Filter CIP 11 (CS) + 14 (Engineering), bachelor's.</li>
        <li>Sum all US degrees = denominator. Stanford UNITID <strong>243744</strong> = numerator.</li>
        <li>Divide. Enter as percentage above.</li>
      </ol>
      <p class="mt-2 italic">If the years are a pain, do 1990–2005 and SAY SO. A stated limitation is not a weakness. An unstated one is fatal.</p>
    </aside>
  </div>

  <!-- FALSIFIER -->
  <div id="panel-falsifier" class="swb-panel" role="tabpanel">
    <p class="font-bold text-sm uppercase mb-1">THE FALSIFIER</p>
    <p class="text-sm mb-4 italic">
      Fill this in BEFORE you look at the ANALYSIS verdict. This is not ceremony.
    </p>
    <p class="text-sm mb-2">Complete the sentence:</p>
    <p class="text-sm mb-4 pl-3 border-l-2 border-accent-400">
      "If __________________________________________, then I abandon the claim that Stanford is a
      <strong>CAUSE</strong> rather than a <strong>FILTER</strong>, and I say so publicly."
    </p>
    <p class="text-xs font-semibold mb-1">YOUR FALSIFIER:</p>
    <textarea
      id="swb-falsifier-text"
      class="swb-cell-input swb-cell-assumption w-full min-h-[5rem] text-sm mb-3"
      placeholder="Write your falsifier here…"
    ></textarea>
    <div class="grid grid-cols-2 gap-3 max-w-md text-sm">
      <label>
        Date written:
        <input type="date" id="swb-falsifier-date" class="swb-cell-input block mt-1 w-full" />
      </label>
      <label>
        Signature / initials:
        <input type="text" id="swb-falsifier-sig" class="swb-cell-input block mt-1 w-full" />
      </label>
    </div>
    <button
      type="button"
      id="swb-falsifier-save"
      class="mt-4 text-sm px-4 py-2 bg-accent-900 text-white rounded hover:opacity-90"
    >
      Lock falsifier &amp; unlock analysis
    </button>
    <p class="text-xs text-accent-600 mt-4 max-w-lg">
      If you cannot complete this sentence, you do not have a thesis. You have a faith. Both are
      allowed — but only one belongs in work that claims to be journalism.
    </p>
  </div>
</div>

<script>
  const STORAGE_KEY = "twilda-stanford-workbook-v1";

  const EXAMPLE_ROW = {
    name: "[EXAMPLE — delete me]",
    company: "Netscape",
    undergrad: "Univ. of Illinois",
    grad: "(none)",
    stanford: "0",
    completed: "Y",
    tier: "2",
    tierWhy: "Father a seed-corn salesman; public university",
    source: "https://en.wikipedia.org/wiki/Marc_Andreessen",
    verified: "N",
  };

  function loadState() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }

  function saveState(state) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function parsePct(val) {
    const n = parseFloat(String(val).replace("%", "").trim());
    return Number.isFinite(n) ? n / 100 : 0;
  }

  function fmtPct(n) {
    if (!Number.isFinite(n)) return "—";
    return (n * 100).toFixed(1) + "%";
  }

  function isVerified(v) {
    return String(v).trim().toUpperCase() === "Y";
  }

  function isStanford(v) {
    return String(v).trim() === "1";
  }

  function computeVerdict(lowN, lowStanford, highN, highStanford, totalN) {
    if (totalN < 5) return "NOT ENOUGH DATA — keep going (need more verified rows)";
    if (lowN < 2 || highN < 2) return "NOT ENOUGH DATA — need tier 1–2 and tier 3–4 subsamples";
    const lowRate = lowStanford / lowN;
    const highRate = highStanford / highN;
    const diff = lowRate - highRate;
    if (lowRate >= 0.25 && diff >= -0.1) {
      return "LEAN CAUSE — Stanford edge visible among low-wealth founders (review before publishing)";
    }
    if (highRate > lowRate + 0.15) {
      return "LEAN FILTER — Stanford concentrates among high-wealth founders (review before publishing)";
    }
    return "MIXED / UNCLEAR — wealth control does not cleanly separate cause from filter";
  }

  function renderAnalysis(rows, baseRateStr, falsifierLocked) {
    const verified = rows.filter((r) => isVerified(r.verified));
    const n = verified.length;
    const stanfordN = verified.filter((r) => isStanford(r.stanford)).length;
    const share = n ? stanfordN / n : NaN;
    const baseRate = parsePct(baseRateStr);
    const ratio = baseRate > 0 && n ? share / baseRate : NaN;

    const low = verified.filter((r) => ["1", "2"].includes(String(r.tier).trim()));
    const high = verified.filter((r) => ["3", "4"].includes(String(r.tier).trim()));
    const lowStanford = low.filter((r) => isStanford(r.stanford)).length;
    const highStanford = high.filter((r) => isStanford(r.stanford)).length;

    document.getElementById("a-n").textContent = String(n);
    document.getElementById("a-stanford").textContent = String(stanfordN);
    document.getElementById("a-share").textContent = n ? fmtPct(share) : "—";
    document.getElementById("b-ratio").textContent =
      Number.isFinite(ratio) ? ratio.toFixed(1) + "×" : "—";
    document.getElementById("c-low-n").textContent = String(low.length);
    document.getElementById("c-low-stanford").textContent = String(lowStanford);
    document.getElementById("c-low-rate").textContent =
      low.length ? fmtPct(lowStanford / low.length) : "—";
    document.getElementById("c-high-n").textContent = String(high.length);
    document.getElementById("c-high-stanford").textContent = String(highStanford);
    document.getElementById("c-high-rate").textContent =
      high.length ? fmtPct(highStanford / high.length) : "—";

    const verdict = computeVerdict(
      low.length,
      lowStanford,
      high.length,
      highStanford,
      n
    );
    const verdictEl = document.getElementById("swb-verdict");
    verdictEl.textContent = verdict;
    verdictEl.classList.toggle("swb-locked", !falsifierLocked);
    document.getElementById("swb-analysis-locked-note").classList.toggle(
      "hidden",
      falsifierLocked
    );
  }

  function rowHtml(row, idx) {
    const fields = [
      "name",
      "company",
      "undergrad",
      "grad",
      "stanford",
      "completed",
      "tier",
      "tierWhy",
      "source",
      "verified",
    ];
    const cells = fields
      .map(
        (f) =>
          `<td><input class="swb-cell-input" data-field="${f}" data-idx="${idx}" value="${(row[f] || "").replace(/"/g, "&quot;")}" /></td>`
      )
      .join("");
    return `<tr><td class="swb-cell-formula">${idx + 1}</td>${cells}<td><button type="button" class="text-xs text-red-600 swb-del-row" data-idx="${idx}">×</button></td></tr>`;
  }

  function init() {
    let state = loadState();
    if (!state.rows || !state.rows.length) {
      state = {
        populationRule: "",
        baseRate: "0.50%",
        falsifier: { text: "", date: "", sig: "", locked: false },
        rows: [{ ...EXAMPLE_ROW }],
      };
    }

    const popEl = document.getElementById("swb-population-rule");
    const baseEl = document.getElementById("b-base-rate");
    popEl.value = state.populationRule || "";
    baseEl.value = state.baseRate || "0.50%";

    const falsText = document.getElementById("swb-falsifier-text");
    const falsDate = document.getElementById("swb-falsifier-date");
    const falsSig = document.getElementById("swb-falsifier-sig");
    falsText.value = state.falsifier?.text || "";
    falsDate.value = state.falsifier?.date || "";
    falsSig.value = state.falsifier?.sig || "";
    if (state.falsifier?.locked) {
      falsText.readOnly = true;
      falsDate.readOnly = true;
      falsSig.readOnly = true;
    }

    function persist() {
      saveState(state);
      renderAnalysis(state.rows, state.baseRate, state.falsifier?.locked);
    }

    function renderRows() {
      const body = document.getElementById("swb-data-body");
      body.innerHTML = state.rows.map((r, i) => rowHtml(r, i)).join("");
      body.querySelectorAll("input").forEach((inp) => {
        inp.addEventListener("input", () => {
          const idx = parseInt(inp.dataset.idx, 10);
          state.rows[idx][inp.dataset.field] = inp.value;
          persist();
        });
      });
      body.querySelectorAll(".swb-del-row").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.dataset.idx, 10);
          state.rows.splice(idx, 1);
          renderRows();
          persist();
        });
      });
    }

    renderRows();
    persist();

    popEl.addEventListener("input", () => {
      state.populationRule = popEl.value;
      persist();
    });
    baseEl.addEventListener("input", () => {
      state.baseRate = baseEl.value;
      persist();
    });

    document.getElementById("swb-add-row").addEventListener("click", () => {
      state.rows.push({
        name: "",
        company: "",
        undergrad: "",
        grad: "",
        stanford: "",
        completed: "",
        tier: "",
        tierWhy: "",
        source: "",
        verified: "",
      });
      renderRows();
      persist();
    });

    document.getElementById("swb-falsifier-save").addEventListener("click", () => {
      if (!falsText.value.trim()) {
        alert("Write a falsifier before locking.");
        return;
      }
      state.falsifier = {
        text: falsText.value,
        date: falsDate.value,
        sig: falsSig.value,
        locked: true,
      };
      falsText.readOnly = true;
      falsDate.readOnly = true;
      falsSig.readOnly = true;
      persist();
    });

    document.querySelectorAll(".swb-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".swb-tab").forEach((t) => {
          t.setAttribute("aria-selected", "false");
        });
        tab.setAttribute("aria-selected", "true");
        document.querySelectorAll(".swb-panel").forEach((p) => p.classList.remove("active"));
        document.getElementById("panel-" + tab.dataset.tab).classList.add("active");
      });
    });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>
