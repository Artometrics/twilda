---
// Assets
import { Image } from "astro:assets";
import Blob1 from "@/images/blobs/blob1.svg";
// Components
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24 bg-accent-900">
    <div class="max-w-xl mx-auto text-center">
      <Image
        width={800}
        height={800}
        loading="eager"
        decoding="async"
        src={Blob1}
        alt="#_"
        class="justify-center mx-auto rounded-full shadow size-32 shadow-accent-900"
      />
      <Text
        tag="h2"
        variant="displayXL"
        class="mt-12 font-semibold text-white text-balance"
      >
        Ready to calm the request chaos?
      </Text>
      <Text tag="p" variant="textLG" class="mt-4 text-white">
        Give every team a single place to intake, approve, and track work—with
        status updates everyone can see.
      </Text>
      <Button
        isLink={true}
        href="/"
        size="xl"
        variant="accent"
        class="mx-auto mt-8 w-fit">Get started</Button
      >
    </div>
  </Wrapper>
</section>
