---
import Text from "@/components/fundations/elements/Text.astro";

const post = Astro.props.post;
const url = `/blog/posts/${post.id}/`;
const title = post.data.title;
const description = post.data.description;
const pubDate = new Date(post.data.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});
---

<article class="relative group rounded-2xl border-2 border-accent-900 bg-white p-5">
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read journal entry: ${title}`}
    class="absolute inset-0 z-10 rounded-2xl"
  ></a>
  <Text tag="p" variant="textXS" class="uppercase text-base-500">
    {pubDate}
  </Text>
  <Text
    tag="h3"
    variant="textLG"
    class="mt-3 font-medium text-accent-900 text-balance"
  >
    {title}
  </Text>
  <Text
    tag="p"
    variant="textBase"
    class="mt-2 text-accent-800 line-clamp-3 text-balance"
  >
    {description}
  </Text>
</article>
