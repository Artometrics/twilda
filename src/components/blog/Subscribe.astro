---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";
---

<section>
  <Wrapper variant="standard" class="py-24 border-t-8 bg-accent-200">
    <div class="max-w-3xl mx-auto text-center text-balance">
      <Text
        tag="h2"
        variant="displayXL"
        class="font-semibold tracking-tight text-accent-900"
      >
        Ready to dive in? Join Ella Mae today!
      </Text>
      <Text tag="p" variant="textXL" class="mt-4 text-accent-900">
        Explore the limitless possibilities of digital finance and embark on a
        journey towards financial empowerment
      </Text>
      <form class="justify-between mt-12 sm:flex gap-2 max-w-md mx-auto">
        <label class="sr-only" for="email-address">Email address</label>
        <input
          autocomplete="email"
          class="w-full px-5 py-3 text-sm text-center placeholder-black bg-white border-2 rounded-full shadow h-14 border-accent-900 lg:text-left focus:ring-black focus:border-accent-900 shadow-accent-900 focus:shadow-none duration-300 focus:translate-y-1"
          id="email-address"
          name="email"
          placeholder="Enter your email"
          required=""
          type="email"
        />
        <Button size="xl" variant="default" type="submit"> Subscribe </Button>
      </form>
    </div>
  </Wrapper>
</section>
