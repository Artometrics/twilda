---
import { getAuthCallbackUrl } from "@/lib/auth";
import type { Provider } from "@supabase/supabase-js";

interface Props {
  next?: string;
  class?: string;
}

const { next = "/novels/", class: className } = Astro.props;
const callbackUrl = getAuthCallbackUrl();

const providers = [
  { id: "google", label: "Continue with Google" },
  { id: "github", label: "Continue with GitHub" },
  { id: "apple", label: "Continue with Apple" },
  { id: "azure", label: "Continue with Microsoft" },
] as const;

const buttonClass =
  "w-full flex items-center justify-center gap-3 px-4 py-4 text-lg font-semibold text-accent-900 bg-white border-2 border-accent-900 rounded-full shadow-accent-900 transition-all duration-500 hover:bg-accent-800 hover:text-white focus:outline-none focus:bg-accent-900 focus:text-white disabled:opacity-60 disabled:pointer-events-none";
---

<div class:list={["space-y-3", className]} data-oauth-buttons>
  {
    providers.map((provider) => (
      <button
        type="button"
        class={buttonClass}
        data-oauth-provider={provider.id}
        data-oauth-label={provider.label}
      >
        {provider.label}
      </button>
    ))
  }
</div>

<script define:vars={{ callbackUrl, next }}>
  import { createBrowserClient } from "@/lib/supabase/client";

  const container = document.querySelector("[data-oauth-buttons]");
  const message = document.getElementById("auth-message");

  function showOAuthError(text) {
    if (!message) return;
    message.textContent = text;
    message.classList.remove("hidden");
    message.classList.add("bg-accent-200");
    message.classList.remove("bg-white");
  }

  container?.querySelectorAll("[data-oauth-provider]").forEach((button) => {
    button.addEventListener("click", async () => {
      const provider = button.getAttribute("data-oauth-provider");
      const label = button.getAttribute("data-oauth-label") ?? "Sign in";
      if (!provider) return;

      button.disabled = true;
      button.textContent = "Redirecting…";
      message?.classList.add("hidden");

      try {
        const supabase = createBrowserClient();
        const redirectTo = `${callbackUrl}?next=${encodeURIComponent(next)}`;

        const { error } = await supabase.auth.signInWithOAuth({
          provider: provider as Provider,
          options: {
            redirectTo,
            queryParams:
              provider === "azure"
                ? { prompt: "select_account" }
                : undefined,
          },
        });

        if (error) {
          showOAuthError(error.message);
          button.disabled = false;
          button.textContent = label;
        }
      } catch {
        showOAuthError("Could not start sign-in. Try again.");
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>
