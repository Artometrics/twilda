---
import Seo from "@/components/fundations/head/Seo.astro";
import Meta from "@/components/fundations/head/Meta.astro";
import Fonts from "@/components/fundations/head/Fonts.astro";
import Favicons from "@/components/fundations/head/Favicons.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  ogImage,
  jsonLd = null,
} = Astro.props;

const jsonLdBlocks = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<Seo
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={noindex}
  ogImage={ogImage}
/>
<Meta noindex={noindex} />
<Fonts />
<Favicons />
{
  jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))
}
