---
import { AstroSeo } from "@lexingtonthemes/seo";

const site = import.meta.env.PUBLIC_SITE_URL || "https://twilda.com";
---

<AstroSeo
  title="Twilda"
  description="Twilda — writing tools from Artometrics."
  canonical={site}
  openGraph={{
    url: site,
    title: "Twilda",
    description: "Twilda — writing tools from Artometrics.",
    images: [
      {
        url: `${site}/og-image.jpg`,
        width: 1200,
        height: 630,
        alt: "Twilda",
        type: "image/jpeg",
      },
    ],
    site_name: "Twilda",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@twilda",
    site: "@twilda",
    cardType: "summary_large_image",
  }}
/>
