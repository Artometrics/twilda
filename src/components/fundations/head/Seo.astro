---
import { AstroSeo } from "@lexingtonthemes/seo";
import { getSiteUrl } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
}

const site = getSiteUrl();
const {
  title = "Twilda",
  description = "Twilda — personal novel workspace and journal from Artometrics.",
  canonicalPath = "/",
  noindex = false,
  ogImage = "/og-image.jpg",
} = Astro.props;

const path = canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`;
const canonical = `${site}${path}`;
const imageUrl = ogImage.startsWith("http") ? ogImage : `${site}${ogImage}`;
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  nofollow={noindex}
  openGraph={{
    url: canonical,
    title,
    description,
    images: [
      {
        url: imageUrl,
        width: 1200,
        height: 630,
        alt: title,
        type: "image/jpeg",
      },
    ],
    site_name: "Twilda",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    cardType: "summary_large_image",
  }}
/>
