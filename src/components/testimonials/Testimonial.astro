---
// Assets
import { Image } from "astro:assets";
import TestimonialImage from "@/images/assets/testimonial.png";

// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24 bg-accent-900">
    <Image
      width={800}
      height={800}
      alt="testimonial"
      src={TestimonialImage}
      class="object-cover object-top mx-auto rounded-full shadow shadow-white border-2 border-white size-24"
    />
    <div class="mx-auto text-center mt-8">
      <Text
        tag="h3"
        variant="displayLG"
        class="font-medium tracking-tight text-white"
      >
        "Twilda finally gave me one place to plan, draft, and keep my Codex
        straight. Instead of scattered docs and notes, I see my whole novel —
        chapters, characters, and lore — in a single calm workspace."
      </Text>
      <Text tag="p" variant="textLG" class="mt-8 tracking-tight text-base-400">
        KSM, author of Trinity
      </Text>
    </div>
  </Wrapper>
</section>
