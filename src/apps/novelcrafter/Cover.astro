---
import type { CoverKind } from "@/apps/novelcrafter/data";
interface Props {
  kind: CoverKind;
  title: string;
  author: string;
  subtitle?: string;
  class?: string;
}
const { kind, title, author, subtitle, class: className = "" } = Astro.props;
const displayTitle = title?.trim() || "Untitled";
---

<div class:list={["nc-cover", `nc-cover--${kind}`, className]} aria-hidden="true">
  {
    kind === "gatsby" && (
      <div class="nc-cover__inner nc-cover__inner--gatsby">
        <div class="nc-cover__deco-top" />
        <p class="nc-cover__eyebrow">THE GREAT</p>
        <h3 class="nc-cover__title">GATSBY</h3>
        <div class="nc-cover__rule" />
        <p class="nc-cover__author">{author}</p>
        <div class="nc-cover__deco-bottom" />
      </div>
    )
  }
  {
    kind === "cardinal" && (
      <div class="nc-cover__inner nc-cover__inner--cardinal">
        <h3 class="nc-cover__title">CARDINAL</h3>
        <div class="nc-cover__bird">
          <div class="nc-cover__bird-body" />
        </div>
        <p class="nc-cover__sub">{subtitle ?? "A SUBLIMINAL HISTORY OF SILICON VALLEY"}</p>
        <p class="nc-cover__author">{author}</p>
      </div>
    )
  }
  {
    kind === "trinity" && (
      <div class="nc-cover__inner nc-cover__inner--trinity">
        <h3 class="nc-cover__title">TRINITY</h3>
        <p class="nc-cover__sub">ORACLE OF SILICON VALLEY</p>
        <p class="nc-cover__author">BY {author}</p>
      </div>
    )
  }
  {
    kind === "plain" && (
      <div class="nc-cover__inner nc-cover__inner--plain">
        <h3 class="nc-cover__title">{displayTitle}</h3>
        <p class="nc-cover__author">{author}</p>
      </div>
    )
  }
</div>
