{
  "version": 1,
  "mode": "corporate",
  "chrome": {
    "name": "Brightline",
    "issueLabel": "",
    "note": "",
    "nav": [
      {
        "label": "Features",
        "href": "/#features"
      },
      {
        "label": "Team",
        "href": "/#team"
      },
      {
        "label": "Pricing",
        "href": "/#pricing"
      },
      {
        "label": "Contact",
        "href": "/#contact"
      }
