{
  "name": "twilda",
  "version": "0.1.0",
  "description": "Git-native, fully static CMS built to fit Astro. Content stays in the repository, the public site is a static Astro build, and the visual editor runs only in development.",
  "license": "Apache-2.0",
  "author": "Artometrics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artometrics/twilda.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "dev:editor": "vite --config editor/vite.config.ts",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:demo": "node scripts/build-demo.mjs",
    "demo": "vite --config apps/demo-editor/vite.config.ts --host 127.0.0.1 --port 4173",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts packages/core/test/*.test.ts packages/astro/test/*.test.ts packages/backend-fs/test/*.test.ts packages/backend-github/test/*.test.ts",
    "test:e2e": "playwright test",
    "check:static": "node scripts/check-static.mjs"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/public-sans": "^5.2.5",
    "astro": "^5.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
