{
  "name": "@twilda/astro",
  "version": "0.1.0",
  "description": "Astro integration for Twilda CMS. Reads published JSON and keeps output static.",
  "license": "Apache-2.0",
  "author": "Artometrics",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artometrics/twilda.git",
    "directory": "packages/astro"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "src",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@twilda/core": "0.1.0"
  },
  "peerDependencies": {
    "astro": "^5"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
