# Public site URL (sitemap, canonicals, RSS). No trailing slash.
PUBLIC_SITE_URL=https://twilda.com

# Supabase — Project Settings → API
# Safe to expose in the browser (anon key + RLS).
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only. Never prefix with PUBLIC_. Never commit real values.
# Used for admin/service routes only; prefer anon + RLS when possible.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
