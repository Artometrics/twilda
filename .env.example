# Public site URL (sitemap, canonicals, RSS). No trailing slash.
PUBLIC_SITE_URL=https://YOUR_DOMAIN.example

# Supabase — Project Settings → API
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only. Never prefix with PUBLIC_. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI — on Netlify production, Chat/Review use Netlify AI Gateway (no provider keys required).
# For local AI testing outside Netlify, configure gateway/env per Netlify docs.
